    clx:strength "Defeasible" ;
    rdfs:comment "传染病防治失职罪：主观方面"@zh .

<http://example.org/clexml/norm/criminal/jx-c154-r-sub> a clx:ConstitutiveNorm ;
    clx:authority auth:jurex ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:specialSubject ;
    clx:hasEffect pred:c154_subject ;
    clx:layer "criminal_jurex" ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_409> ;
