<http://example.org/clexml/norm/civil/c546-def> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c545>,
        <http://example.org/clexml/norm/civil/c545-2-goodfaith>,
