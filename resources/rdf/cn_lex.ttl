<http://example.org/clexml/norm/civil/c147> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:majorMisunderstanding ;
    clx:hasEffect pred:revocationGround ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_147> ;
    clx:strength "Defeasible" ;
    rdfs:comment "基于重大误解实施的，行为人有权请求撤销（第147条；npc）"@zh .

<http://example.org/clexml/norm/civil/c374> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c-revocable-valid>,
        <http://example.org/clexml/norm/civil/c-valid-default>,
        <http://example.org/clexml/norm/civil/c-void-not-valid>,
        <http://example.org/clexml/norm/civil/c145-consent>,
        <http://example.org/clexml/norm/civil/c145-pure>,
        <http://example.org/clexml/norm/civil/c145-refused> ;
    clx:hasCondition pred:easementContract,
        pred:valid ;
