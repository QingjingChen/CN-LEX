        pred:estateOf,
        pred:secondOrderHeir ;
    clx:hasEffect pred:inheritsIntestate ;
    clx:hasExceptionCondition pred:disinherited,
        pred:firstOrderInherits,
        pred:predeceased,
        pred:renounced ;
    clx:layer "civil" ;
    clx:module "继承"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1127__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "没有第一顺序继承人继承的，由第二顺序继承人继承（第1127条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c145-deemed-refusal> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c145-pending> ;
    clx:hasCondition pred:demandedRatification,
        pred:noAnswerWithin30Days ;
    clx:hasEffect pred:ratificationRefused ;
    clx:hasExceptionCondition pred:guardianRatifies ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_145__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "法定代理人收到催告三十日内未作表示的，视为拒绝追认（第145条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c151> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:exploitedDistressOrInexperience,
        pred:grosslyUnfairAtFormation ;
    clx:hasEffect pred:revocationGround ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_151> ;
    clx:strength "Defeasible" ;
    rdfs:comment "利用对方危困状态、缺乏判断能力等致显失公平的，受损害方有权请求撤销（第151条；npc）"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_246> a clx:Provision ;
    rdfs:label "《刑法》第246条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第246条　以暴力或者其他方法公然侮辱他人或者捏造事实诽谤他人，情节严重的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利。前款罪，告诉的才处理，但是严重危害社会秩序和国家利益的除外。通过信息网络实施第一款规定的行为，被害人向人民法院告诉，但提供证据确有困难的，人民法院可以要求公安机关提供协助。"@zh,
        "《刑法》第246条：以暴力或者其他方法公然侮辱他人或者捏造事实诽谤他人，情节严重的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利。前款罪，告诉的才处理，但是严重危害社会秩序和国家利益的除外。通过信息网络实施第一款规定的行为，被害人向人民法院告诉，但提供证据确有困难的，人民法院可以要求公安机关提供协助。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_277> a clx:Provision ;
    rdfs:label "《刑法》第277条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第277条　以暴力、威胁方法阻碍国家机关工作人员依法执行职务的，处三年以下有期徒刑、拘役、管制或者罚金。以暴力、威胁方法阻碍全国人民代表大会和地方各级人民代表大会代表依法执行代表职务的，依照前款的规定处罚。在自然灾害和突发事件中，以暴力、威胁方法阻碍红十字会工作人员依法履行职责的，依照第一款的规定处罚。故意阻碍国家安全机关、公安机关依法执行国家安全工作任务，未使用暴力、威胁方法，造成严重后果的，依照第一款的规定处罚。暴力袭击正在依法执行职务的人民警察的，处三年以下有期徒刑、拘役或者管制；使用枪支、管制刀具，或者以驾驶机动车撞击等手段，严重危及其人身安全的，处三年以上七年以下有期徒刑。"@zh,
        "《刑法》第277条：以暴力、威胁方法阻碍国家机关工作人员依法执行职务的，处三年以下有期徒刑、拘役、管制或者罚金。以暴力、威胁方法阻碍全国人民代表大会和地方各级人民代表大会代表依法执行代表职务的，依照前款的规定处罚。在自然灾害和突发事件中，以暴力、威胁方法阻碍红十字会工作人员依法履行职责的，依照第一款的规定处罚。故意阻碍国家安全机关、公安机关依法执行国家安全工作任务，未使用暴力、威胁方法，造成严重后果的，依照第一款的规定处罚。暴力袭击正在依法执行职务的人民警察的，处三年以下有期徒刑、拘役或者管制；使用枪支、管制刀具，或者以驾驶机动车撞击等手段，严重危及其人身安全的，处三年以上七年以下有期徒刑。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_280> a clx:Provision ;
    rdfs:label "《刑法》第280条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第280条　伪造、变造、买卖或者盗窃、抢夺、毁灭国家机关的公文、证件、印章的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金；情节严重的，处三年以上十年以下有期徒刑，并处罚金。伪造公司、企业、事业单位、人民团体的印章的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金。伪造、变造、买卖居民身份证、护照、社会保障卡、驾驶证等依法可以用于证明身份的证件的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金；情节严重的，处三年以上七年以下有期徒刑，并处罚金。"@zh,
        "《刑法》第280条：伪造、变造、买卖或者盗窃、抢夺、毁灭国家机关的公文、证件、印章的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金；情节严重的，处三年以上十年以下有期徒刑，并处罚金。伪造公司、企业、事业单位、人民团体的印章的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金。伪造、变造、买卖居民身份证、护照、社会保障卡、驾驶证等依法可以用于证明身份的证件的，处三年以下有期徒刑、拘役、管制或者剥夺政治权利，并处罚金；情节严重的，处三年以上七年以下有期徒刑，并处罚金。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_284> a clx:Provision ;
    rdfs:label "《刑法》第284条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第284条　非法使用窃听、窃照专用器材，造成严重后果的，处二年以下有期徒刑、拘役或者管制。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_358> a clx:Provision ;
    rdfs:label "《刑法》第358条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第358条　组织、强迫他人卖淫的，处五年以上十年以下有期徒刑，并处罚金；情节严重的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产。组织、强迫未成年人卖淫的，依照前款的规定从重处罚。犯前两款罪，并有杀害、伤害、强奸、绑架等犯罪行为的，依照数罪并罚的规定处罚。为组织卖淫的人招募、运送人员或者有其他协助组织他人卖淫行为的，处五年以下有期徒刑，并处罚金；情节严重的，处五年以上十年以下有期徒刑，并处罚金。"@zh,
        "《刑法》第358条：组织、强迫他人卖淫的，处五年以上十年以下有期徒刑，并处罚金；情节严重的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产。组织、强迫未成年人卖淫的，依照前款的规定从重处罚。犯前两款罪，并有杀害、伤害、强奸、绑架等犯罪行为的，依照数罪并罚的规定处罚。为组织卖淫的人招募、运送人员或者有其他协助组织他人卖淫行为的，处五年以下有期徒刑，并处罚金；情节严重的，处五年以上十年以下有期徒刑，并处罚金。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_115> a clx:Provision ;
    rdfs:label "《民法典》第一百一十五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百一十五条　物包括不动产和动产。法律规定权利作为物权客体的，依照其规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1171> a clx:Provision ;
    rdfs:label "《民法典》第一千一百七十一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百七十一条　二人以上分别实施侵权行为造成同一损害，每个人的侵权行为都足以造成全部损害的，行为人承担连带责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1193> a clx:Provision ;
    rdfs:label "《民法典》第一千一百九十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百九十三条　承揽人在完成工作过程中造成第三人损害或者自己损害的，定作人不承担侵权责任。但是，定作人对定作、指示或者选任有过错的，应当承担相应的责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_131> a clx:Provision ;
    rdfs:label "《民法典》第一百三十一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百三十一条　民事主体行使权利时，应当履行法律规定的和当事人约定的义务。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_148> a clx:Provision ;
    rdfs:label "《民法典》第148条"@zh,
        "《民法典》第一百四十八条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第148条：一方以欺诈手段，使对方在违背真实意思的情况下实施的民事法律行为，受欺诈方有权请求人民法院或者仲裁机构予以撤销。"@zh,
        "《民法典》第一百四十八条　一方以欺诈手段，使对方在违背真实意思的情况下实施的民事法律行为，受欺诈方有权请求人民法院或者仲裁机构予以撤销。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_172> a clx:Provision ;
    rdfs:label "《民法典》第一百七十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百七十二条　行为人没有代理权、超越代理权或者代理权终止后，仍然实施代理行为，相对人有理由相信行为人有代理权的，代理行为有效。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_18> a clx:Provision ;
    rdfs:label "《民法典》第十八条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第十八条　成年人为完全民事行为能力人，可以独立实施民事法律行为。
十六周岁以上的未成年人，以自己的劳动收入为主要生活来源的，视为完全民事行为能力人。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_21> a clx:Provision ;
    rdfs:label "《民法典》第二十一条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第二十一条　不能辨认自己行为的成年人为无民事行为能力人，由其法定代理人代理实施民事法律行为。
八周岁以上的未成年人不能辨认自己行为的，适用前款规定。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_232> a clx:Provision ;
    rdfs:label "《民法典》第二百三十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百三十二条　处分依照本节规定享有的不动产物权，依照法律规定需要办理登记的，未经登记，不发生物权效力。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_374> a clx:Provision ;
    rdfs:label "《民法典》第374条"@zh,
        "《民法典》第三百七十四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第374条：地役权自地役权合同生效时设立。当事人要求登记的，可以向登记机构申请地役权登记；未经登记，不得对抗善意第三人。"@zh,
        "《民法典》第三百七十四条　地役权自地役权合同生效时设立。当事人要求登记的，可以向登记机构申请地役权登记；未经登记，不得对抗善意第三人。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_468> a clx:Provision ;
    rdfs:label "《民法典》第四百六十八条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第四百六十八条　非因合同产生的债权债务关系，适用有关该债权债务关系的法律规定；没有规定的，适用本编通则的有关规定，但是根据其性质不能适用的除外。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_502> a clx:Provision ;
    rdfs:label "《民法典》第五百零二条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第五百零二条　依法成立的合同，自成立时生效，但是法律另有规定或者当事人另有约定的除外。
依照法律、行政法规的规定，合同应当办理批准等手续的，依照其规定。未办理批准等手续影响合同生效的，不影响合同中履行报批等义务条款以及相关条款的效力。应当办理申请批准等手续的当事人未履行义务的，对方可以请求其承担违反该义务的责任。
依照法律、行政法规的规定，合同的变更、转让、解除等情形应当办理批准等手续的，适用前款规定。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_578> a clx:Provision ;
    rdfs:label "《民法典》第五百七十八条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百七十八条　当事人一方明确表示或者以自己的行为表明不履行合同义务的，对方可以在履行期限届满前请求其承担违约责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_6> a clx:Provision ;
    rdfs:label "《民法典》第六条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第六条　民事主体从事民事活动，应当遵循公平原则，合理确定各方的权利和义务。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_60> a clx:Provision ;
    rdfs:label "《民法典》第六十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第六十条　法人以其全部财产独立承担民事责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_65> a clx:Provision ;
    rdfs:label "《民法典》第六十五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第六十五条　法人的实际情况与登记的事项不一致的，不得对抗善意相对人。"@zh .

