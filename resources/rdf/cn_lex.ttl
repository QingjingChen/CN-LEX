    clx:strength "Defeasible" ;
    rdfs:comment "抢夺公私财物，数额较大的，或者多次抢夺的（第267条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k267-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:carryingWeapon,
        pred:illegalPossessionPurpose,
        pred:snatchesOpenly ;
    clx:hasEffect pred:constitutes ;
