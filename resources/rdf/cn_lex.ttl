        pred:easementEstablished,
        pred:inGoodFaith ;
    clx:hasEffect pred:easementOpposableTo ;
    clx:hasExceptionCondition pred:easementRegistered ;
    clx:layer "civil" ;
    clx:module "地役权"@zh ;
    clx:negatedEffect true ;
