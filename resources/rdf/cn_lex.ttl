    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_68> ;
    clx:strength "Defeasible" ;
    rdfs:comment "有揭发他人犯罪行为查证属实等立功表现的，可以从轻或者减轻处罚（第68条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k68-major> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:bearer "court" ;
    clx:code "criminal" ;
    clx:deonticMode "Permission" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k17-1>,
        <http://example.org/clexml/norm/criminal/k17-2-arson>,
        <http://example.org/clexml/norm/criminal/k17-2-drugTrafficking>,
        <http://example.org/clexml/norm/criminal/k17-2-explosion>,
        <http://example.org/clexml/norm/criminal/k17-2-intentionalHomicide>,
        <http://example.org/clexml/norm/criminal/k17-2-intentionalInjury>,
        <http://example.org/clexml/norm/criminal/k17-2-poisoning>,
        <http://example.org/clexml/norm/criminal/k17-2-rape>,
        <http://example.org/clexml/norm/criminal/k17-2-robbery>,
        <http://example.org/clexml/norm/criminal/k17-3>,
        <http://example.org/clexml/norm/criminal/k18-1>,
        <http://example.org/clexml/norm/criminal/k20-1>,
        <http://example.org/clexml/norm/criminal/k20-3>,
        <http://example.org/clexml/norm/criminal/k21-1> ;
    clx:hasCondition pred:majorMeritoriousService,
        pred:responsible ;
    clx:hasEffect pred:sentence ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_68> ;
    clx:strength "Defeasible" ;
    rdfs:comment "有重大立功表现的，可以减轻或者免除处罚（第68条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k74> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:bearer "court" ;
    clx:code "criminal" ;
    clx:deonticMode "Prohibition" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k65>,
