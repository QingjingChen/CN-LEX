    clx:strength "Defeasible" ;
    rdfs:comment "携带凶器抢夺的，依照第二百六十三条（抢劫罪）定罪处罚（第267条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k269> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k-minor-conv>,
        <http://example.org/clexml/norm/criminal/k133>,
        <http://example.org/clexml/norm/criminal/k133-1>,
        <http://example.org/clexml/norm/criminal/k232>,
        <http://example.org/clexml/norm/criminal/k234>,
        <http://example.org/clexml/norm/criminal/k263>,
        <http://example.org/clexml/norm/criminal/k264>,
        <http://example.org/clexml/norm/criminal/k266>,
        <http://example.org/clexml/norm/criminal/k267>,
        <http://example.org/clexml/norm/criminal/k267-2>,
        <http://example.org/clexml/norm/criminal/k270>,
        <http://example.org/clexml/norm/criminal/k270-2>,
        <http://example.org/clexml/norm/criminal/k271>,
        <http://example.org/clexml/norm/criminal/k271-2>,
        <http://example.org/clexml/norm/criminal/k274>,
        <http://example.org/clexml/norm/criminal/k382>,
        <http://example.org/clexml/norm/criminal/k382-2>,
        <http://example.org/clexml/norm/criminal/k382-3>,
        <http://example.org/clexml/norm/criminal/k385>,
        <http://example.org/clexml/norm/criminal/k389>,
        <http://example.org/clexml/norm/criminal/k389-3> ;
    clx:exceptionTo <http://example.org/clexml/norm/criminal/k17-2-robbery> ;
    clx:hasCondition pred:constitutes,
        pred:toDestroyEvidence,
        pred:toKeepLoot,
        pred:toResistArrest,
        pred:violenceOnTheSpot ;
    clx:hasEffect pred:constitutes,
        pred:convertedRobbery ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_269> ;
    clx:strength "Defeasible" ;
    rdfs:comment "犯盗窃、诈骗、抢夺罪，为窝藏赃物、抗拒抓捕或者毁灭罪证而当场使用暴力或者以暴力相威胁的，依照抢劫罪定罪处罚（第269条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k270> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:entrustedPropertyOf,
        pred:illegallyAppropriates,
        pred:refusesToReturn ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_270__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "将代为保管的他人财物非法占为己有，数额较大，拒不退还的（第270条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k270-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:buriedProperty,
        pred:forgottenProperty,
        pred:illegallyAppropriates,
        pred:refusesToHandOver ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_270__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "将他人的遗忘物或者埋藏物非法占为己有，数额较大，拒不交出的（第270条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k271> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:appropriatesUnitProperty,
        pred:employeeOfUnit,
        pred:usesPosition ;
    clx:hasEffect pred:constitutes ;
    clx:hasExceptionCondition pred:stateFunctionary ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_271__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "单位工作人员利用职务便利，将本单位财物非法占为己有，数额较大的（第271条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k271-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:appropriatesUnitProperty,
        pred:employeeOfUnit,
        pred:stateFunctionary,
        pred:usesPosition ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_271__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "国有单位中从事公务的人员有前款行为的，依照贪污罪定罪处罚（第271条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k274> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:multipleExtortion,
        pred:threatensOrBlackmails,
        pred:victimHandsOverOutOfFear ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_274> ;
    clx:strength "Defeasible" ;
    rdfs:comment "敲诈勒索公私财物，数额较大或者多次敲诈勒索的（第274条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k382> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:appropriatesPublicProperty,
        pred:stateFunctionary,
        pred:usesPosition ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_382__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "国家工作人员利用职务上的便利，侵吞、窃取、骗取或者以其他手段非法占有公共财物的，是贪污罪（第382条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k382-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:appropriatesPublicProperty,
        pred:entrustedToManageStateAssets,
        pred:usesPosition ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_382__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "受国家机关、国有单位委托管理、经营国有财产的人员，利用职务便利非法占有国有财物的，以贪污论（第382条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k385> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:acceptsProperty,
        pred:seeksBenefitForGiver,
        pred:solicitsProperty,
        pred:stateFunctionary,
        pred:usesPosition ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_385__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "国家工作人员利用职务上的便利，索取他人财物，或者非法收受他人财物、为他人谋取利益的，是受贿罪（第385条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k389-3> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:extortedByFunctionary,
        pred:givesPropertyToFunctionary ;
    clx:hasEffect pred:constitutes ;
    clx:hasExceptionCondition pred:obtainedImproperBenefit ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/criminal/k389> ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_389__para_3> ;
    clx:strength "Defeasible" ;
    rdfs:comment "因被勒索给予国家工作人员以财物，没有获得不正当利益的，不是行贿（第389条第3款；npc）"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_399> a clx:Provision ;
    rdfs:label "《刑法》第399条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第399条　司法工作人员徇私枉法、徇情枉法，对明知是无罪的人而使他受追诉、对明知是有罪的人而故意包庇不使他受追诉，或者在刑事审判活动中故意违背事实和法律作枉法裁判的，处五年以下有期徒刑或者拘役；情节严重的，处五年以上十年以下有期徒刑；情节特别严重的，处十年以上有期徒刑。在民事、行政审判活动中故意违背事实和法律作枉法裁判，情节严重的，处五年以下有期徒刑或者拘役；情节特别严重的，处五年以上十年以下有期徒刑。在执行判决、裁定活动中，严重不负责任或者滥用职权，不依法采取诉讼保全措施、不履行法定执行职责，或者违法采取诉讼保全措施、强制执行措施，致使当事人或者其他人的利益遭受重大损失的，处五年以下有期徒刑或者拘役；致使当事人或者其他人的利益遭受特别重大损失的，处五年以上十年以下有期徒刑。司法工作人员收受贿赂，有前三款行为的，同时又构成本法第三百八十五条规定之罪的，依照处罚较重的规定定罪处罚。"@zh,
        "《刑法》第399条：司法工作人员徇私枉法、徇情枉法，对明知是无罪的人而使他受追诉、对明知是有罪的人而故意包庇不使他受追诉，或者在刑事审判活动中故意违背事实和法律作枉法裁判的，处五年以下有期徒刑或者拘役；情节严重的，处五年以上十年以下有期徒刑；情节特别严重的，处十年以上有期徒刑。在民事、行政审判活动中故意违背事实和法律作枉法裁判，情节严重的，处五年以下有期徒刑或者拘役；情节特别严重的，处五年以上十年以下有期徒刑。在执行判决、裁定活动中，严重不负责任或者滥用职权，不依法采取诉讼保全措施、不履行法定执行职责，或者违法采取诉讼保全措施、强制执行措施，致使当事人或者其他人的利益遭受重大损失的，处五年以下有期徒刑或者拘役；致使当事人或者其他人的利益遭受特别重大损失的，处五年以上十年以下有期徒刑。司法工作人员收受贿赂，有前三款行为的，同时又构成本法第三百八十五条规定之罪的，依照处罚较重的规定定罪处罚。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_5> a clx:Provision ;
    rdfs:label "《民法典》第五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五条　民事主体从事民事活动，应当遵循自愿原则，按照自己的意思设立、变更、终止民事法律关系。"@zh .

<http://example.org/clexml/norm/civil/c144> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c20>,
        <http://example.org/clexml/norm/civil/c21-1>,
