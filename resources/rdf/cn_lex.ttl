<http://example.org/clexml/norm/civil/c152-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c147>,
        <http://example.org/clexml/norm/civil/c148>,
        <http://example.org/clexml/norm/civil/c149>,
        <http://example.org/clexml/norm/civil/c150>,
        <http://example.org/clexml/norm/civil/c151> ;
    clx:hasCondition pred:fiveYearsSinceAct,
        pred:revocationGround ;
    clx:hasEffect pred:revocationRight ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c-revocation-right> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_152__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "自民事法律行为发生之日起五年内没有行使的，撤销权消灭（最长期间）（第152条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c192-1> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c188-20y>,
        <http://example.org/clexml/norm/civil/c188-run> ;
    clx:hasCondition pred:limitationExpired,
        pred:obligorOf ;
    clx:hasEffect pred:limitationDefense ;
    clx:layer "civil" ;
    clx:module "诉讼时效"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_192__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "诉讼时效期间届满的，义务人可以提出不履行义务的抗辩（抗辩权发生主义）（第192条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c194> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c188-run> ;
    clx:hasCondition pred:claim,
        pred:claimantControlledByObligor,
        pred:forceMajeure,
        pred:heirOrAdministratorUndetermined,
        pred:incapableClaimantWithoutAgent,
        pred:otherObstacle,
        pred:withinLastSixMonths ;
    clx:hasEffect pred:limitationSuspended ;
    clx:layer "civil" ;
    clx:module "诉讼时效"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_194__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "最后六个月内因法定障碍不能行使请求权的，诉讼时效中止（第194条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c527> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:hasCondition pred:assetsTransferredToEvadeDebt,
