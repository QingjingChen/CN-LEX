        <http://example.org/clexml/norm/civil/c150>,
        <http://example.org/clexml/norm/civil/c151> ;
    clx:hasCondition pred:revocationGround ;
    clx:hasEffect pred:revocationRight ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_147>,
        <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_148>,
        <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_149>,
        <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_150>,
        <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_151> ;
    clx:strength "Defeasible" ;
    rdfs:comment "有撤销事由的，享有撤销权（形成权，须向法院或仲裁机构请求）（第147条、第148条、第149条、第150条、第151条；doctrine）"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_11> a clx:Provision ;
    rdfs:label "《民法典》第十一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第十一条　其他法律对民事关系有特别规定的，依照其规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_145> a clx:Provision ;
    rdfs:label "《民法典》第一百四十五条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百四十五条　限制民事行为能力人实施的纯获利益的民事法律行为或者与其年龄、智力、精神健康状况相适应的民事法律行为有效；实施的其他民事法律行为经法定代理人同意或者追认后有效。
相对人可以催告法定代理人自收到通知之日起三十日内予以追认。法定代理人未作表示的，视为拒绝追认。民事法律行为被追认前，善意相对人有撤销的权利。撤销应当以通知的方式作出。"""@zh .

