    clx:strength "Defeasible" ;
    rdfs:comment "债权人可以将债权转让给第三人（性质、约定、法律不得转让的除外）（第545条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c545-2-goodfaith> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:agreedNonAssignable,
