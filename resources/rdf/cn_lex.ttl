<http://example.org/clexml/norm/civil/c148> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:deceivedByCounterparty ;
    clx:hasEffect pred:revocationGround ;
