    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c19> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_18__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "十六周岁以上、以自己劳动收入为主要生活来源的未成年人，视为完全民事行为能力人（第18条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k-minor-conv> a clx:ConstitutiveNorm ;
    clx:authority auth:spc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k269> ;
    clx:hasCondition pred:age14to16,
        pred:causesGraveInjuryOrDeath,
        pred:convertedRobbery,
        pred:violenceOnTheSpot ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <urn:lexgo:spc:spc-minor10> ;
    clx:strength "Defeasible" ;
    rdfs:comment "已满十四不满十六周岁的人盗窃、诈骗、抢夺后当场使用暴力，故意伤害致人重伤或者死亡的，以故意伤害罪定罪处罚，不成立（转化型）抢劫罪（《最高人民法院关于审理未成年人刑事案件具体应用法律若干问题的解释》（法释〔2006〕1号）第10条第1款；spc）"@zh .

<http://example.org/clexml/norm/criminal/k133> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:causesGraveInjuryOrDeath,
        pred:majorAccident,
        pred:majorPropertyLoss,
        pred:violatesTrafficRegulations ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_133> ;
    clx:strength "Defeasible" ;
    rdfs:comment "违反交通运输管理法规，因而发生重大事故，致人重伤、死亡或者使公私财产遭受重大损失的（第133条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k133-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:drivesMotorVehicleOnRoad,
        pred:drunkDriving,
        pred:illegalHazardousTransport,
        pred:racingSerious,
        pred:seriousOverloadOrSpeeding ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_133_1__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "在道路上驾驶机动车，追逐竞驶情节恶劣、醉酒驾驶、校车或客运严重超员超速、违规运输危险化学品的（第133条之一第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k232> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:intentionallyKills ;
    clx:hasEffect pred:constitutes ;
