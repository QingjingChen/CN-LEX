<http://example.org/clexml/norm/criminal/k20-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k20-cond>,
        <http://example.org/clexml/norm/criminal/k20-late> ;
    clx:exceptionTo <http://example.org/clexml/norm/criminal/k20-1> ;
    clx:hasCondition pred:causesSeriousHarm,
        pred:defenseConditions,
        pred:obviouslyExceedsNecessity ;
    clx:hasEffect pred:excessiveDefense ;
    clx:hasExceptionCondition pred:violentCrimeEndangeringLife ;
    clx:layer "criminal" ;
    clx:module "正当化事由"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_20__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "正当防卫明显超过必要限度造成重大损害的，是防卫过当（第20条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k21-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k21-cond> ;
    clx:exceptionTo <http://example.org/clexml/norm/criminal/k21-1> ;
    clx:hasCondition pred:exceedsNecessityUndueHarm,
        pred:necessityConditions ;
    clx:hasEffect pred:excessiveNecessity ;
    clx:layer "criminal" ;
    clx:module "正当化事由"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_21__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "紧急避险超过必要限度造成不应有的损害的，是避险过当（第21条第2款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k22> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:preparedToolsOrConditions ;
    clx:hasEffect pred:preparation ;
    clx:hasExceptionCondition pred:commencedExecution,
        pred:voluntarilyAbandoned ;
    clx:layer "criminal" ;
    clx:module "犯罪形态与共同犯罪"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_22__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "为了犯罪，准备工具、制造条件，因意志以外原因未能着手的，是犯罪预备（第22条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k24-noAttempt> a clx:ConstitutiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:commencedExecution,
        pred:notAccomplished,
        pred:voluntarilyAbandoned ;
    clx:hasEffect pred:attempt ;
    clx:layer "criminal" ;
    clx:module "犯罪形态与共同犯罪"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/criminal/k23> ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_24__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "自动性是犯罪中止区别于未遂、预备的标志（第24条第1款；doctrine）"@zh .

<http://example.org/clexml/norm/criminal/k72> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:bearer "court" ;
    clx:code "criminal" ;
    clx:deonticMode "Permission" ;
    clx:hasCondition pred:lightCircumstances,
        pred:noMajorAdverseCommunityImpact,
        pred:noRiskOfReoffending,
        pred:sentencedDetentionOrUpTo3Years,
        pred:showsRepentance ;
    clx:hasEffect pred:sentence ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_72__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "被判处拘役、三年以下有期徒刑，同时符合情节较轻、有悔罪表现、没有再犯罪危险、对社区无重大不良影响的，可以宣告缓刑（第72条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k72-must> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:bearer "court" ;
    clx:code "criminal" ;
    clx:deonticMode "Obligation" ;
    clx:dependsOn <http://example.org/clexml/norm/criminal/k-under18> ;
    clx:hasCondition pred:age75plus,
        pred:lightCircumstances,
        pred:noMajorAdverseCommunityImpact,
        pred:noRiskOfReoffending,
        pred:pregnant,
        pred:sentencedDetentionOrUpTo3Years,
        pred:showsRepentance,
        pred:under18 ;
    clx:hasEffect pred:sentence ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_72__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "其中不满十八周岁的人、怀孕的妇女和已满七十五周岁的人，应当宣告缓刑（第72条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k81-1> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:bearer "court" ;
    clx:code "criminal" ;
    clx:deonticMode "Permission" ;
    clx:hasCondition pred:abidesPrisonRules,
        pred:noRiskOfReoffending,
        pred:servedHalfOrThirteenYears,
        pred:showsRepentance ;
    clx:hasEffect pred:sentence ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_81__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "执行原判刑期二分之一以上（无期徒刑实际执行十三年以上），确有悔改表现，没有再犯罪危险的，可以假释（第81条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k88-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:caseFiledOrAccepted,
        pred:evadesInvestigationOrTrial ;
    clx:hasEffect pred:timeBarred ;
    clx:layer "criminal" ;
    clx:module "追诉时效"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/criminal/k87-from10>,
        <http://example.org/clexml/norm/criminal/k87-from5to10>,
        <http://example.org/clexml/norm/criminal/k87-lifeOrDeath>,
        <http://example.org/clexml/norm/criminal/k87-under5> ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_88__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "立案侦查或者法院受理案件以后，逃避侦查或者审判的，不受追诉期限的限制（第88条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k88-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:authoritiesFailedToFileCase,
        pred:victimComplainedWithinPeriod ;
    clx:hasEffect pred:timeBarred ;
    clx:layer "criminal" ;
    clx:module "追诉时效"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/criminal/k87-from10>,
        <http://example.org/clexml/norm/criminal/k87-from5to10>,
        <http://example.org/clexml/norm/criminal/k87-lifeOrDeath>,
        <http://example.org/clexml/norm/criminal/k87-under5> ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_88__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "被害人在追诉期限内提出控告，应当立案而不予立案的，不受追诉期限的限制（第88条第2款；npc）"@zh .

off:交通肇事罪 a clx:Offence ;
    rdfs:label "交通肇事罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c011-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_133> ;
    clx:hasObject "交通运输安全"@zh ;
    clx:hasObjectiveAspect "违反交通运输管理法规，因而发生重大事故，致人重伤、死亡或者使公私财产遭受重大损失的行为“交通运输”构成基本犯“公共道路”逃逸"@zh ;
    clx:hasSubject "一般主体，包括从事交通运输的人员和非从事交通运输的人员过失犯罪不成立共犯，但是根据司法解释的规定，“交通肇事后，单位主管人员、机动车辆所有人、承包人或者乘车人指使肇事人逃逸，致使被害人因得不到救助而死亡的，以交通肇事罪的共犯论处”。（本来是不作为的故意杀人）单位主管人员、机动车辆所有人或者机动车辆承包人指使、强令他人违章驾驶造成重大交通事故，具有“发生重大事故”规定情形之一的，以交通肇事罪定罪处罚。二人均构成本罪，但不是共同犯罪。"@zh ;
    clx:hasSubjectiveAspect "过失，即行为人应当预见自己的行为会发生危害社会的结果，因为疏忽大意而没有预见，或者虽然已经预见但轻信能够避免但行为人对违反交通管理法规的行为，是出于故意但在交通肇事后逃逸致人死亡的情况下，行为人对致人死亡的结果是间接故意的"@zh ;
    clx:relatedOffence off:危险驾驶罪,
        off:故意杀人罪 ;
    clx:structureNode "t3538" ;
    rdfs:comment "概念违反交通运输管理法规，在公共交通管理范围内发生重大事故，致人重伤、死亡或者使公私财产遭受重大损失的行为。"@zh ;
    prov:wasDerivedFrom "t3602",
        "t3608" .

<http://example.org/clexml/offence/伪造、变造、买卖身份证件罪> a clx:Offence ;
    rdfs:label "伪造、变造、买卖身份证件罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c098-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_280> ;
    clx:hasObject "国家对依法可以用于证明身份的证件的管理制度"@zh ;
    clx:hasObjectiveAspect "伪造、变造、买卖身份证件的行为"@zh ;
    clx:hasSubject "一般主体"@zh ;
    clx:hasSubjectiveAspect "直接故意，明知是可以用于证明身份的证件仍进行伪造、变造、买卖"@zh ;
    clx:relatedOffence off:盗窃罪,
        off:诈骗罪 ;
    clx:structureNode "t7624" ;
    rdfs:comment "概念指伪造、变造、买卖居民身份证、护照、社会保障卡、驾驶证等依法可以用于证明身份的证件的行为"@zh ;
    prov:wasDerivedFrom "t7641" .

off:危险驾驶罪 a clx:Offence ;
    rdfs:label "危险驾驶罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c012-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_133> ;
    clx:hasObject "交通运输的正常秩序和道路交通安全"@zh ;
    clx:hasObjectiveAspect "违反道路交通安全管理法规，在道路上驾驶机动车实施刑法规定的危险驾驶行为行为方式“机动车”“道路”“醉酒驾驶机动车”"@zh ;
    clx:hasSubject "一般主体，包括任何在道路上驾驶机动车的人机动车所有人、管理人对违规运输危险化学品的行为负有直接责任，也构成本罪。"@zh ;
    clx:hasSubjectiveAspect "故意不知道喝了酒，不犯罪。"@zh ;
    clx:relatedOffence off:交通肇事罪 ;
    clx:structureNode "t3621" ;
    rdfs:comment "概念指在道路上1驾驶机动车追逐竞驶、情节恶劣的，或者2在道路上醉酒驾驶机动车的，或者3从事校车业务或者旅客运输、严重超过额定乘员载客或严重超过规定时速行驶的，或者4违反危险化学品安全管理规定运输危险化学品、危及公共安全的行为"@zh ;
    prov:wasDerivedFrom "t3662" .

off:合同诈骗罪 a clx:Offence ;
    rdfs:label "合同诈骗罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c053-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_224> ;
    clx:hasObject "国家对合同的管理制度、诚实信用的市场经济秩序和合同当事人的财产所有权"@zh ;
    clx:hasObjectiveAspect "在签订、履行合同的过程中，骗取合同一方当事人的财物，数额较大的行为签订-担保-履行-逃跑（一）以虚构的单位或者冒用他人名义签订合同的；（假合同）（二）以伪造、变造、作废的票据或者其他虚假的产权证明作担保的；（假担保）（三）没有实际履行能力，以先履行小额合同或者部分履行合同的方法，诱骗对方当事人继续签订和履行合同的；（引蛇出洞）（四）收受对方当事人给付的货物、货款、预付款或者担保财产后逃匿的；（见好就收）（五）以其他方法骗取对方当事人财物的要有一方是市场经营主体"@zh ;
    clx:hasSubject "个人和单位"@zh ;
    clx:hasSubjectiveAspect "故意，并且具有非法占有合同当事人财物的目的"@zh ;
    clx:relatedOffence off:诈骗罪,
        off:贷款诈骗罪,
        off:集资诈骗罪 ;
    clx:structureNode "t5392" ;
    rdfs:comment "概念指以非法占有为目的，在签订、履行合同过程中，骗取对方当事人财物，数额较大的行为"@zh ;
    prov:wasDerivedFrom "t5418",
        "t5423" .

off:妨害公务罪 a clx:Offence ;
    rdfs:label "妨害公务罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c094-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_277> ;
    clx:hasObject "正在依法执行职务、履行职责的国家机关工作人员、人大代表、红十字会工作人员以及公安机关、国家安全机关的工作人员的职务活动另外，本罪只能发生于上述四种人执行公务、履行职责期间，如果行为人在上述人员依法执行公务结束之后，再使用非法手段打击报复的，不能成立本罪，应当依具体情形成立相应的犯罪。阻碍的是国家机关工作人员，包括立法、行政、司法、监察机关、军事机关的人员。这里的国家机关工作人员可以扩大到受国家机关委托的工作人员，就像疫情期间村委会，居委会、保安等，从事疫情工作，设卡检测，如果对他们暴力威胁，也是妨碍公务。"@zh ;
    clx:hasObjectiveAspect "①以暴力、威胁的方法阻碍国家机关工作人员、人大代表依法执行职务；②或者在自然灾害或在突发事件中，以暴力、威胁方法阻碍红十字会工作人员依法履行职责；③或者虽未使用暴力、威胁的方法，但故意阻碍国家安全机关、公安机关工作人员依法执行国家安全工作任务，造成严重后果的行为。“造成严重后果”；犯罪对象是正在依法执行职务、履行职责的1国家机关工作人员，2人大代表、3红十字会工作人员以及4国家安全机关、公安机关的工作人员"@zh ;
    clx:hasSubject "一般主体"@zh ;
    clx:hasSubjectiveAspect "故意，即明知是国家机关工作人员、人大代表、红十字会工作人员以及国家安全机关、公安机关工作人员正在依法执行职务，而以暴力、威胁或者其他方法阻碍，希望其停止执行职务或者改变执行的职务"@zh ;
    clx:structureNode "t7501" ;
    rdfs:comment "概念指1.以暴力、威胁方法阻碍①国家机关工作人员依法执行职务，阻碍②人民代表大会代表依法执行代表职务，③在自然灾害或在突发事件中阻碍红十字会工作人员依法履行职责的行为，或者2.故意阻碍国家安全机关、公安机关依法执行国家安全工作任务，未使用暴力、威胁方法，造成严重后果的行为。"@zh .

off:寻衅滋事罪 a clx:Offence ;
    rdfs:label "寻衅滋事罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c111-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_293> ;
    clx:hasObject "公共秩序"@zh ;
    clx:hasObjectiveAspect "无事生非，进行扰乱破坏，情节恶劣的行为。本罪的行为表现方式有四种:追强打闹(1)随意殴打他人，情节恶劣的;(2)追逐、拦截、辱骂、恐吓他人，情节恶劣的;(3)强拿硬要或者任意损毁、占用公私财物，情节严重的;(4)在公共场所起哄闹事，造成公共场所秩序严重混乱的。物人"@zh ;
    clx:hasSubject "一般主体"@zh ;
    clx:hasSubjectiveAspect "故意，一般基于蔑视法纪、显示威风、寻求精神刺激或者发泄等卑劣下流的动机"@zh ;
    clx:relatedOffence off:侮辱罪,
        off:故意伤害罪,
        off:故意杀人罪 ;
    clx:structureNode "t7977" ;
    rdfs:comment "概念指行为人为寻求刺激、发泄情绪、逞强耍横等，无事生非，进行扰乱破坏，情节恶劣的行为"@zh ;
    prov:wasDerivedFrom "t8007",
        "t8010" .

off:开设赌场罪 a clx:Offence ;
    rdfs:label "开设赌场罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c114-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_303> ;
    clx:hasObject "社会管理秩序和社会风尚"@zh ;
    clx:hasObjectiveAspect "为赌博提供场所、设定赌博方式以及提供赌具、筹码、资金等组织赌博的行为(1)赌场的范围：开设的赌场可以是临时性的赌场，也可以是长期性的赌场；开设的赌场可以是实体赌场(如设置赌博机方式开设赌场)，也可以是网络赌场(2)提供棋牌室等娱乐场所并只收取固定的场所和服务费用的经营行为，不属于开设赌场的行为。"@zh ;
    clx:hasSubject "一般主体，即自然人"@zh ;
    clx:hasSubjectiveAspect "故意，并以营利为目的"@zh ;
    clx:structureNode "t8075" ;
    rdfs:comment "概念指为赌博提供场所、设定赌博方式以及提供赌具、筹码、资金等组织赌博的行为"@zh .

off:挪用公款罪 a clx:Offence ;
    rdfs:label "挪用公款罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c138-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_384> ;
    clx:hasObject "复杂客体，即国家工作人员职务行为的廉洁性、国家财经管理制度以及公款使用收益权"@zh ;
    clx:hasObjectiveAspect "利用职务之便挪用公款归个人使用，进行非法活动，或者挪用公款数额较大、进行营利活动，或者挪用公款数额较大、超过3个月未还的行为(1)“利用职务上的便利”(2)“挪用公款归个人使用”，包括三种情形:，8；（3）“以个人名义”（4）挪用公款的数额的计算"@zh ;
    clx:hasSubject "特殊主体，即国家工作人员受委托管理、经营国有财产的人员(非国家工作人员)挪用公款的，认定为挪用资金罪。"@zh ;
    clx:hasSubjectiveAspect "故意，明知是公款而非法挪用，但没有非法占有目的。并以归个人使用为目的。是否为本人和其他人谋取到利益不影响犯罪成立"@zh ;
    clx:relatedOffence off:贪污罪 ;
    clx:structureNode "t9010" ;
    rdfs:comment "概念指国家工作人员利用职务上的便利，挪用公款归个人使用，进行1非法活动的，或者1挪用公款数额较大、进行营利活动的，或者3挪用公款数额较大、超过3个月未还的行为"@zh ;
    prov:wasDerivedFrom "t9059" .

<http://example.org/clexml/offence/窝藏、包庇罪> a clx:Offence ;
    rdfs:label "窝藏、包庇罪"@zh ;
