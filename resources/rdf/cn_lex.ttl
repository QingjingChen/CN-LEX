    clx:strength "Defeasible" ;
    rdfs:comment "留置权人有权就该动产优先受偿（第447条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c526> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:hasCondition pred:mutualDebts,
        pred:performsFirst ;
    clx:hasEffect pred:subsequentPerformanceDefense ;
    clx:hasExceptionCondition pred:performed ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_526> ;
    clx:strength "Defeasible" ;
    rdfs:comment "应当先履行的一方未履行的，后履行一方有权拒绝其履行请求（第526条；npc）"@zh .

<http://example.org/clexml/norm/civil/c551> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:debtTransfer ;
    clx:hasEffect pred:debtTransferEffective ;
    clx:hasExceptionCondition pred:creditorConsents ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c551-ok> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_551> ;
    clx:strength "Defeasible" ;
    rdfs:comment "债务人将债务转移给第三人的，应当经债权人同意（第551条；npc）"@zh .

<http://example.org/clexml/norm/civil/c551-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c551> ;
    clx:hasCondition pred:creditorSilent,
        pred:debtTransfer,
        pred:demandedConsent ;
    clx:hasEffect pred:creditorConsents ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:negatedEffect true ;
