    clx:strength "Defeasible" ;
    rdfs:comment "诈骗公私财物，数额较大的（虚构事实→陷入错误→基于错误处分财产）（第266条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k267> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:illegalPossessionPurpose,
