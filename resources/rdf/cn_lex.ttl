    clx:strength "Defeasible" ;
    rdfs:comment "对方提供适当担保的，应当恢复履行（第528条；npc）"@zh .

<http://example.org/clexml/norm/civil/c586> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:depositActuallyPaid,
        pred:depositAgreed ;
    clx:hasEffect pred:depositContractFormed ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_586__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "定金合同自实际交付定金时成立（实践合同）（第586条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c604-before> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:sale ;
    clx:hasEffect pred:riskOnBuyer ;
    clx:hasExceptionCondition pred:delivered ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:negatedEffect true ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_604> ;
    clx:strength "Defeasible" ;
    rdfs:comment "标的物风险在交付之前由出卖人承担（第604条；npc）"@zh .

off:故意伤害罪 a clx:Offence ;
    rdfs:label "故意伤害罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c059-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_234> ;
    clx:hasObject "他人的身体健康权利"@zh ;
    clx:hasObjectiveAspect "非法损害他人身体健康的行为非法性对象性物理性"@zh ;
    clx:hasSubject "一般主体，即年满16周岁并具有刑事责任能力的自然人。年满14周岁不满16周岁的人犯本罪致人重伤或死亡的，应当负刑事责任"@zh ;
    clx:hasSubjectiveAspect "故意，即行为人明知自己的行为会造成他人重伤或者轻伤结果的发生而希望或者放任这种结果的发生"@zh ;
    clx:relatedOffence off:侮辱罪,
        off:故意杀人罪,
        off:盗窃罪,
        off:过失致人死亡罪 ;
    clx:structureNode "t5758" ;
    rdfs:comment "概念指故意非法损害他人身体健康的行为"@zh ;
    prov:wasDerivedFrom "t5782",
        "t5787",
        "t5800" .

pred:riskOnBuyer a clx:Predicate .

pred:valid a clx:Predicate .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_225> a clx:Provision ;
    rdfs:label "《刑法》第225条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第225条　违反国家规定，有下列非法经营行为之一，扰乱市场秩序，情节严重的，处五年以下有期徒刑或者拘役，并处或者单处违法所得一倍以上五倍以下罚金；情节特别严重的，处五年以上有期徒刑，并处违法所得一倍以上五倍以下罚金或者没收财产：（一）未经许可经营法律、行政法规规定的专营、专卖物品或者其他限制买卖的物品的；（二）买卖进出口许可证、进出口原产地证明以及其他法律、行政法规规定的经营许可证或者批准文件的；（三）未经国家有关主管部门批准非法经营证券、期货、保险业务的，或者非法从事资金支付结算业务的；（四）其他严重扰乱市场秩序的非法经营行为。"@zh,
        "《刑法》第225条：违反国家规定，有下列非法经营行为之一，扰乱市场秩序，情节严重的，处五年以下有期徒刑或者拘役，并处或者单处违法所得一倍以上五倍以下罚金；情节特别严重的，处五年以上有期徒刑，并处违法所得一倍以上五倍以下罚金或者没收财产：（一）未经许可经营法律、行政法规规定的专营、专卖物品或者其他限制买卖的物品的；（二）买卖进出口许可证、进出口原产地证明以及其他法律、行政法规规定的经营许可证或者批准文件的；（三）未经国家有关主管部门批准非法经营证券、期货、保险业务的，或者非法从事资金支付结算业务的；（四）其他严重扰乱市场秩序的非法经营行为。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_253> a clx:Provision ;
    rdfs:label "《刑法》第253条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第253条　邮政工作人员私自开拆或者隐匿、毁弃邮件、电报的，处二年以下有期徒刑或者拘役。犯前款罪而窃取财物的，依照本法第二百六十四条的规定定罪从重处罚。"@zh,
        "《刑法》第253条：邮政工作人员私自开拆或者隐匿、毁弃邮件、电报的，处二年以下有期徒刑或者拘役。犯前款罪而窃取财物的，依照本法第二百六十四条的规定定罪从重处罚。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1> a clx:Provision ;
    rdfs:label "《民法典》第一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一条　为了保护民事主体的合法权益，调整民事关系，维护社会和经济秩序，适应中国特色社会主义发展要求，弘扬社会主义核心价值观，根据宪法，制定本法。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_104> a clx:Provision ;
    rdfs:label "《民法典》第一百零四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百零四条　非法人组织的财产不足以清偿债务的，其出资人或者设立人承担无限责任。法律另有规定的，依照其规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1167> a clx:Provision ;
    rdfs:label "《民法典》第一千一百六十七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百六十七条　侵权行为危及他人人身、财产安全的，被侵权人有权请求侵权人承担停止侵害、排除妨碍、消除危险等侵权责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_119> a clx:Provision ;
    rdfs:label "《民法典》第一百一十九条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百一十九条　依法成立的合同，对当事人具有法律约束力。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_130> a clx:Provision ;
    rdfs:label "《民法典》第一百三十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百三十条　民事主体按照自己的意愿依法行使民事权利，不受干涉。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_137> a clx:Provision ;
    rdfs:label "《民法典》第一百三十七条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百三十七条　以对话方式作出的意思表示，相对人知道其内容时生效。
以非对话方式作出的意思表示，到达相对人时生效。以非对话方式作出的采用数据电文形式的意思表示，相对人指定特定系统接收数据电文的，该数据电文进入该特定系统时生效；未指定特定系统的，相对人知道或者应当知道该数据电文进入其系统时生效。当事人对采用数据电文形式的意思表示的生效时间另有约定的，按照其约定。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_160> a clx:Provision ;
    rdfs:label "《民法典》第一百六十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百六十条　民事法律行为可以附期限，但是根据其性质不得附期限的除外。附生效期限的民事法律行为，自期限届至时生效。附终止期限的民事法律行为，自期限届满时失效。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_170> a clx:Provision ;
    rdfs:label "《民法典》第一百七十条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百七十条　执行法人或者非法人组织工作任务的人员，就其职权范围内的事项，以法人或者非法人组织的名义实施的民事法律行为，对法人或者非法人组织发生效力。
法人或者非法人组织对执行其工作任务的人员职权范围的限制，不得对抗善意相对人。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_171> a clx:Provision ;
    rdfs:label "《民法典》第一百七十一条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百七十一条　行为人没有代理权、超越代理权或者代理权终止后，仍然实施代理行为，未经被代理人追认的，对被代理人不发生效力。
相对人可以催告被代理人自收到通知之日起三十日内予以追认。被代理人未作表示的，视为拒绝追认。行为人实施的行为被追认前，善意相对人有撤销的权利。撤销应当以通知的方式作出。
行为人实施的行为未被追认的，善意相对人有权请求行为人履行债务或者就其受到的损害请求行为人赔偿。但是，赔偿的范围不得超过被代理人追认时相对人所能获得的利益。
相对人知道或者应当知道行为人无权代理的，相对人和行为人按照各自的过错承担责任。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_192> a clx:Provision ;
    rdfs:label "《民法典》第一百九十二条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百九十二条　诉讼时效期间届满的，义务人可以提出不履行义务的抗辩。
诉讼时效期间届满后，义务人同意履行的，不得以诉讼时效期间届满为由抗辩；义务人已经自愿履行的，不得请求返还。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_403> a clx:Provision ;
    rdfs:label "《民法典》第403条"@zh,
        "《民法典》第四百零三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第403条：以动产抵押的，抵押权自抵押合同生效时设立；未经登记，不得对抗善意第三人。"@zh,
        "《民法典》第四百零三条　以动产抵押的，抵押权自抵押合同生效时设立；未经登记，不得对抗善意第三人。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_463> a clx:Provision ;
    rdfs:label "《民法典》第四百六十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第四百六十三条　本编调整因合同产生的民事关系。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_501> a clx:Provision ;
    rdfs:label "《民法典》第五百零一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百零一条　当事人在订立合同过程中知悉的商业秘密或者其他应当保密的信息，无论合同是否成立，不得泄露或者不正当地使用；泄露、不正当地使用该商业秘密或者信息，造成对方损失的，应当承担赔偿责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_546> a clx:Provision ;
    rdfs:label "《民法典》第五百四十六条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第五百四十六条　债权人转让债权，未通知债务人的，该转让对债务人不发生效力。
债权转让的通知不得撤销，但是经受让人同意的除外。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_583> a clx:Provision ;
    rdfs:label "《民法典》第五百八十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百八十三条　当事人一方不履行合同义务或者履行合同义务不符合约定的，在履行义务或者采取补救措施后，对方还有其他损失的，应当赔偿损失。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_584> a clx:Provision ;
    rdfs:label "《民法典》第五百八十四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百八十四条　当事人一方不履行合同义务或者履行合同义务不符合约定，造成对方损失的，损失赔偿额应当相当于因违约所造成的损失，包括合同履行后可以获得的利益；但是，不得超过违约一方订立合同时预见到或者应当预见到的因违约可能造成的损失。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_659> a clx:Provision ;
    rdfs:label "《民法典》第六百五十九条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第六百五十九条　赠与的财产依法需要办理登记或者其他手续的，应当办理有关手续。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_686> a clx:Provision ;
    rdfs:label "《民法典》第六百八十六条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第六百八十六条　保证的方式包括一般保证和连带责任保证。
当事人在保证合同中对保证方式没有约定或者约定不明确的，按照一般保证承担保证责任。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_75> a clx:Provision ;
    rdfs:label "《民法典》第七十五条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第七十五条　设立人为设立法人从事的民事活动，其法律后果由法人承受；法人未成立的，其法律后果由设立人承受，设立人为二人以上的，享有连带债权，承担连带债务。
设立人为设立法人以自己的名义从事民事活动产生的民事责任，第三人有权选择请求法人或者设立人承担。"""@zh .

<http://example.org/clexml/norm/civil/c1127-child> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:adoptedChild,
        pred:biologicalChild,
        pred:stepchildWithSupport ;
    clx:hasEffect pred:childOf ;
    clx:layer "civil" ;
    clx:module "继承"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1127__para_3> ;
    clx:strength "Defeasible" ;
    rdfs:comment "子女包括婚生子女、非婚生子女、养子女和有扶养关系的继子女（第1127条第3款；npc）"@zh .

<http://example.org/clexml/norm/civil/c1128-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c1123-intestate>,
        <http://example.org/clexml/norm/civil/c1127-child> ;
    clx:hasCondition pred:byIntestacy,
        pred:childOf,
        pred:estateOf,
        pred:predeceased,
        pred:siblingOf ;
    clx:hasEffect pred:inheritsBySubrogation ;
    clx:hasExceptionCondition pred:disinherited,
        pred:firstOrderInherits ;
    clx:layer "civil" ;
    clx:module "继承"@zh ;
