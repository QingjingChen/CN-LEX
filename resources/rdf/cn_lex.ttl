<http://example.org/clexml/norm/civil/c-valid-default> a clx:ConstitutiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:actOf ;
    clx:hasEffect pred:valid ;
    clx:hasExceptionCondition pred:ineffective,
        pred:pendingValidity,
        pred:void ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_143> ;
    clx:strength "Defeasible" ;
    rdfs:comment "无无效、效力待定、确定不生效事由的，民事法律行为有效（第143条的推定）（第143条；doctrine）"@zh .

