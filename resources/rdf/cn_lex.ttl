        pred:violentListedCrime ;
    clx:hasEffect pred:sentence ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:overrides <http://example.org/clexml/norm/criminal/k81-1> ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_81__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "对累犯以及因故意杀人、强奸、抢劫、绑架、放火、爆炸、投放危险物质或有组织的暴力性犯罪被判处十年以上有期徒刑、无期徒刑的，不得假释（第81条第2款；npc）"@zh .

