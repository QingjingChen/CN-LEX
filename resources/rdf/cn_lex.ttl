<http://example.org/clexml/norm/criminal/k-age16> a clx:ConstitutiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:adult,
        pred:age16to18 ;
    clx:hasEffect pred:age16plus ;
    clx:layer "criminal" ;
    clx:module "刑事责任年龄与能力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_17__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "已满十六周岁（第17条第1款；doctrine）"@zh .

<http://example.org/clexml/norm/criminal/k21-cond> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:avertsDanger,
        pred:harmsThirdPartyInterest,
        pred:noOtherMeans,
        pred:ongoingDanger ;
    clx:hasEffect pred:necessityConditions ;
    clx:hasExceptionCondition pred:specialDutyToFaceOwnDanger ;
    clx:layer "criminal" ;
    clx:module "正当化事由"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_21__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "正在发生的危险、不得已、损害另一合法权益；避免本人危险不适用于负有特定责任的人（第21条第3款）（第21条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k23> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:commencedExecution,
        pred:notAccomplished ;
    clx:hasEffect pred:attempt ;
    clx:hasExceptionCondition pred:voluntarilyAbandoned ;
    clx:layer "criminal" ;
    clx:module "犯罪形态与共同犯罪"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_23__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "已经着手实行犯罪，由于犯罪分子意志以外的原因而未得逞的，是犯罪未遂（第23条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k24> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:notAccomplished,
        pred:voluntarilyAbandoned ;
    clx:hasEffect pred:discontinuance ;
    clx:layer "criminal" ;
    clx:module "犯罪形态与共同犯罪"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_24__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "在犯罪过程中，自动放弃犯罪或者自动有效地防止犯罪结果发生的，是犯罪中止（第24条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k67-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/criminal/k67-3> ;
    clx:hasCondition pred:confessesTruthfully,
        pred:surrendersVoluntarily ;
    clx:hasEffect pred:surrender ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_67__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "犯罪以后自动投案，如实供述自己的罪行的，是自首（第67条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k67-2> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/criminal/k67-3> ;
    clx:hasCondition pred:confessesOtherCrimeUnknownToAuthorities,
        pred:underCoerciveMeasureOrServing ;
    clx:hasEffect pred:surrender ;
    clx:layer "criminal" ;
    clx:module "量刑与刑罚执行制度"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_67__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "被采取强制措施的犯罪嫌疑人、被告人和正在服刑的罪犯，如实供述司法机关还未掌握的本人其他罪行的，以自首论（第67条第2款；npc）"@zh .

<http://example.org/clexml/offence/伪造、变造、买卖国家机关公文、证件、印章罪> a clx:Offence ;
    rdfs:label "伪造、变造、买卖国家机关公文、证件、印章罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c097-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_280> ;
    clx:hasObject "国家机关的正常管理活动和信誉。"@zh ;
    clx:hasObjectiveAspect "伪造、变造、买卖国家机关的公文、证件、印章的行为“公文”“证件”“印章”包括无权伪造和越权伪造；对象仅限于国家机关的公文、证件、印章"@zh ;
    clx:hasSubject "一般主体"@zh ;
    clx:hasSubjectiveAspect "故意，动机不影响本罪的成立"@zh ;
    clx:relatedOffence <http://example.org/clexml/offence/伪造、变造、买卖身份证件罪>,
        off:诈骗罪 ;
    clx:structureNode "t7590" ;
    rdfs:comment "概念指伪造、变造、买卖国家机关的公文、证件、印章的行为"@zh ;
    prov:wasDerivedFrom "t7616",
        "t7617" .

off:信用卡诈骗罪 a clx:Offence ;
    rdfs:label "信用卡诈骗罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c044-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_196> ;
    clx:hasObject "国家的金融管理制度和公私财产所有权"@zh ;
    clx:hasObjectiveAspect "违反信用卡管理法规，进行信用卡诈骗活动，骗取财物数额较大的行为。“数额较大”，“信用卡”，不区分对人和对机器行为方式，7；"@zh ;
    clx:hasSubject "一般主体，即年满16周岁，具有刑事责任能力的自然人，单位不能成为本罪的主体。"@zh ;
    clx:hasSubjectiveAspect "故意，并具有非法占有他人财物的目的“以非法占有为目的”，包括以下六种情形："@zh ;
    clx:relatedOffence <http://example.org/clexml/offence/伪造、变造、买卖国家机关公文、证件、印章罪>,
        off:盗窃罪,
        off:诈骗罪 ;
    clx:structureNode "t4966" ;
    rdfs:comment "概念指以非法占有为目的，使用刑法规定的方法进行信用卡诈骗活动，数额较大的行为"@zh ;
    prov:wasDerivedFrom "t5019",
        "t5020",
        "t5022" .

off:放火罪 a clx:Offence ;
    rdfs:label "放火罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c005-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_114>,
        <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_115> ;
    clx:hasObject "公共安全，即不特定的多数人的生命、健康和重大公私财产安全客体是公共安全，对象是关系到公共安全的公私财产。只要放火焚烧公私财产足以危害公共安全，行为人本人拥有的财产也可成为本罪的对象"@zh ;
    clx:hasObjectiveAspect "实施了危害或者足以危害公共安全的放火行为，包括作为与不作为注意：以不作为方式实施本罪的，要求行为人本身负防止火灾发生的特定义务例如，如果林场负责消防安全的职工发现火情而故意不采取相应措施，致使火灾发生，危害公共安全的，成立放火罪;但如果是普通路人看到路旁房子着火而未拨打火警电话或者未采取其他相应措施，最终造成公私财产重大损失的，由于其不具备特定的义务，不构成犯罪。"@zh ;
    clx:hasSubject "一般主体，即年满14周岁具有刑事责任能力的自然人"@zh ;
    clx:hasSubjectiveAspect "故意"@zh ;
    clx:structureNode "t3299" ;
    rdfs:comment "概念指故意放火焚烧公私财产，危害公共安全的行为"@zh .

off:滥用职权罪 a clx:Offence ;
    rdfs:label "滥用职权罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c144-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_397> ;
    clx:hasObject "国家机关的正常管理活动"@zh ;
    clx:hasObjectiveAspect "违反法律规定的权限或程序，滥用职权，致使公共财产、国家和人民利益遭受重大损失的行为。(1)“职权”“滥用职权”"@zh ;
    clx:hasSubject "特殊主体，即国家机关工作人员"@zh ;
    clx:hasSubjectiveAspect "故意"@zh ;
    clx:structureNode "t9348" ;
    rdfs:comment "概念指国家机关工作人员违反法律规定的权限和程序，滥用职权，致使公共财产、国家和人民利益遭受重大损失的行为"@zh .

<http://example.org/clexml/offence/生产、销售有毒、有害食品罪> a clx:Offence ;
    rdfs:label "生产、销售有毒、有害食品罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c030-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_144> ;
    clx:hasObject "复杂客体，即国家对食品卫生的管理制度和不特定多数人的身体健康、生命安全"@zh ;
    clx:hasObjectiveAspect "违反国家食品卫生管理法律法规，在生产、销售的食品中掺入有毒、有害的非食品原料的，或者销售明知掺有有毒、有害的非食品原料的食品的行为(1)本罪的行为方式有三种，分别是："@zh ;
    clx:hasSubject "一般主体，包括自然人、和单位"@zh ;
    clx:hasSubjectiveAspect "故意，明知是有毒、有害的非食品原料，而掺入自己生产、销售的食品中，或者明知是有毒、有害的非食品原料的食品而销售"@zh ;
    clx:relatedOffence <http://example.org/clexml/offence/生产、销售不符合安全标准的食品罪>,
        <http://example.org/clexml/offence/生产、销售伪劣产品罪>,
        off:非法经营罪 ;
    clx:structureNode "t4264" ;
    rdfs:comment "概念指违反国家食品卫生管理法律法规，在生产、销售的食品中掺入有毒、有害的非食品原料的，或者销售明知掺有有毒、有害的非食品原料的食品的行为（掺入+禁用）"@zh ;
    prov:wasDerivedFrom "t4293",
        "t4317",
        "t4318" .

off:过失致人死亡罪 a clx:Offence ;
    rdfs:label "过失致人死亡罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c058-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_233> ;
    clx:hasObject "他人的生命权利"@zh ;
    clx:hasObjectiveAspect "因过失致使他人死亡的行为"@zh ;
    clx:hasSubject "一般主体，即年满16周岁并具有刑事责任能力的自然人"@zh ;
    clx:hasSubjectiveAspect "过失"@zh ;
    clx:relatedOffence off:故意杀人罪 ;
    clx:structureNode "t5713" ;
    rdfs:comment "概念指过失致人死亡的行为"@zh ;
    prov:wasDerivedFrom "t5730" .

off:非法拘禁罪 a clx:Offence ;
    rdfs:label "非法拘禁罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c066-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_238> ;
    clx:hasObject "他人的人身自由权利"@zh ;
    clx:hasObjectiveAspect "非法对被害人的身体进行强制，使被害人失去人身行动自由的行为刚出生不久的婴儿(0~1岁)没有身体活动的自由和能力，不是非法拘禁的对象，为了索取债务偷盗他人刚出生不久的婴儿，不构成非法拘禁，构成拐骗儿童罪，24；能够自由行走的幼儿(1~6岁)是非法拘禁的对象，为了索取债务偷盗他人3岁幼儿，可成立非法拘禁罪。但是婴儿、幼儿都是绑架的对象，为了勒索财物偷盗他人婴幼儿的，均构成绑架罪。"@zh ;
    clx:hasSubject "一般主体"@zh ;
    clx:hasSubjectiveAspect "故意"@zh ;
    clx:relatedOffence off:故意伤害罪,
        off:故意杀人罪,
        off:绑架罪 ;
    clx:structureNode "t6089" ;
    rdfs:comment "概念指非法拘禁他人或者以其他方法非法剥夺他人人身自由的行为"@zh ;
    prov:wasDerivedFrom "t6120",
        "t6121" .

