    clx:hasExceptionCondition pred:supportAgreementCovers ;
    clx:layer "civil" ;
    clx:module "继承"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1123> ;
    clx:strength "Defeasible" ;
    rdfs:comment "有遗嘱的，按照遗嘱继承或者遗赠办理（第1123条；npc）"@zh .

<http://example.org/clexml/norm/civil/c1191-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:causesDamage,
        pred:employeeOf,
        pred:performingDuties ;
    clx:hasEffect pred:liable ;
    clx:hasExceptionCondition pred:dispatchedWorker ;
    clx:layer "civil" ;
    clx:module "侵权责任"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c1165-1> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1191__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "工作人员因执行工作任务造成他人损害的，由用人单位承担侵权责任（替代责任）（第1191条第1款；npc）"@zh .

