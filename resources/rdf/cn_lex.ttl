    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_385> ;
    clx:hasObject "国家工作人员职务行为的廉洁性。实质在于以权谋私、权钱交易"@zh ;
    clx:hasObjectiveAspect "利用职务上的便利，索取他人财物或者非法收受他人财物，为他人谋取利益的行为两种情形“利用职务便利”“财物”“为他人谋取利益”"@zh ;
    clx:hasSubject "特殊主体，即国家工作人员国家工作人员，故本罪是身份犯。如果是国有单位受贿，成立单位受贿罪。一般公民与国家工作人员相勾结，伙同受贿的，以受贿罪的共犯论处。"@zh ;
    clx:hasSubjectiveAspect "故意"@zh ;
    clx:relatedOffence off:敲诈勒索罪,
        off:诈骗罪,
        off:贪污罪,
        off:非国家工作人员受贿罪 ;
    clx:structureNode "t9086" ;
    rdfs:comment "概念指国家工作人员利用职务上的便利，1索取他人财物，或者2非法收受他人财物，为他谋取利益的行为"@zh ;
    prov:wasDerivedFrom "t9154",
        "t9161",
        "t9171" .

