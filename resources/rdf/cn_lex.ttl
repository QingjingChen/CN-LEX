    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_17__para_4> ;
    clx:strength "Defeasible" ;
    rdfs:comment "不满十八周岁（第17条第4款；doctrine）"@zh .

<http://example.org/clexml/norm/criminal/k20-late> a clx:ConstitutiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:attackAlreadyEnded,
