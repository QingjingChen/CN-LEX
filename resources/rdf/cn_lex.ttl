<http://example.org/clexml/norm/civil/c545> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:claimAssigned ;
    clx:hasEffect pred:assignmentEffective ;
    clx:hasExceptionCondition pred:agreedNonAssignable,
