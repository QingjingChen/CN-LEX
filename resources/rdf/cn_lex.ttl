    clx:strength "Defeasible" ;
    rdfs:comment "危害国家安全、恐怖活动、黑社会性质组织犯罪的犯罪分子，在任何时候再犯上述任一类罪的，都以累犯论处（第66条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k87-from10> a clx:ConstitutiveNorm ;
