<http://example.org/clexml/norm/criminal/k389> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:givesPropertyToFunctionary,
        pred:seeksImproperBenefit ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_389__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "为谋取不正当利益，给予国家工作人员以财物的，是行贿罪（第389条第1款；npc）"@zh .

off:诈骗罪 a clx:Offence ;
    rdfs:label "诈骗罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c086-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_266> ;
    clx:hasObject "公私财产所有权"@zh ;
    clx:hasObjectiveAspect "使用虚构事实或者隐瞒真相的方法，骗取数额较大的公私财物的行为比如假毒品(1)“虚构事实”，指捏造不存在的事实，骗取受害人的信任。(2)“隐瞒真相”，指对受害人掩盖客观存在的某种事实，使之产生错误认识。调虎离山不算诈骗。处分要有客观上的处分行为和主观上的处分意识"@zh ;
    clx:hasSubject "一般主体，即年满16周岁具有刑事责任能力的自然人"@zh ;
    clx:hasSubjectiveAspect "故意，并具有非法占有公私财物的目的"@zh ;
    clx:relatedOffence off:信用卡诈骗罪,
        off:盗窃罪,
        off:虚假诉讼罪,
        off:贷款诈骗罪,
        off:集资诈骗罪 ;
    clx:structureNode "t7065" ;
    rdfs:comment "概念指以非法占有为目的，用虚构事实或者隐瞒真相的方法，骗取数额较大的公私财物的行为"@zh ;
    prov:wasDerivedFrom "t7089",
        "t7101",
        "t7114" .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_134> a clx:Provision ;
    rdfs:label "《刑法》第134条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第134条　在生产、作业中违反有关安全管理的规定，因而发生重大伤亡事故或者造成其他严重后果的，处三年以下有期徒刑或者拘役；情节特别恶劣的，处三年以上七年以下有期徒刑。强令他人违章冒险作业，或者明知存在重大事故隐患而不排除，仍冒险组织作业，因而发生重大伤亡事故或者造成其他严重后果的，处五年以下有期徒刑或者拘役；情节特别恶劣的，处五年以上有期徒刑。"@zh,
        "《刑法》第134条：在生产、作业中违反有关安全管理的规定，因而发生重大伤亡事故或者造成其他严重后果的，处三年以下有期徒刑或者拘役；情节特别恶劣的，处三年以上七年以下有期徒刑。强令他人违章冒险作业，或者明知存在重大事故隐患而不排除，仍冒险组织作业，因而发生重大伤亡事故或者造成其他严重后果的，处五年以下有期徒刑或者拘役；情节特别恶劣的，处五年以上有期徒刑。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1165> a clx:Provision ;
    rdfs:label "《民法典》第一千一百六十五条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一千一百六十五条　行为人因过错侵害他人民事权益造成损害的，应当承担侵权责任。
依照法律规定推定行为人有过错，其不能证明自己没有过错的，应当承担侵权责任。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1174> a clx:Provision ;
    rdfs:label "《民法典》第一千一百七十四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百七十四条　损害是因受害人故意造成的，行为人不承担责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_134> a clx:Provision ;
    rdfs:label "《民法典》第一百三十四条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百三十四条　民事法律行为可以基于双方或者多方的意思表示一致成立，也可以基于单方的意思表示成立。
法人、非法人组织依照法律或者章程规定的议事方式和表决程序作出决议的，该决议行为成立。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_153> a clx:Provision ;
    rdfs:label "《民法典》第一百五十三条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百五十三条　违反法律、行政法规的强制性规定的民事法律行为无效。但是，该强制性规定不导致该民事法律行为无效的除外。
违背公序良俗的民事法律行为无效。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_205> a clx:Provision ;
    rdfs:label "《民法典》第二百零五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百零五条　本编调整因物的归属和利用产生的民事关系。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_3> a clx:Provision ;
    rdfs:label "《民法典》第三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第三条　民事主体的人身权利、财产权利以及其他合法权益受法律保护，任何组织或者个人不得侵犯。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_510> a clx:Provision ;
    rdfs:label "《民法典》第五百一十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百一十条　合同生效后，当事人就质量、价款或者报酬、履行地点等内容没有约定或者约定不明确的，可以协议补充；不能达成补充协议的，按照合同相关条款或者交易习惯确定。"@zh .

<http://example.org/clexml/norm/civil/c-revocation-right> a clx:PrescriptiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c147>,
