    clx:strength "Defeasible" ;
    rdfs:comment "未经登记，不得对抗善意第三人（第374条；npc）"@zh .

<http://example.org/clexml/norm/civil/c395> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:hasDisposalPower,
