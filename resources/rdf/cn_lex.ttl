off:组织卖淫罪 a clx:Offence ;
    rdfs:label "组织卖淫罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c131-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_358> ;
    clx:hasObject "社会道德风尚和社会治安管理秩序"@zh ;
    clx:hasObjectiveAspect "组织多人卖淫的行为“组织多人卖淫”，"@zh ;
    clx:hasSubject "一般主体.即年满16周岁具有刑事责任能力的自然人。既可以是男性，也可以是女性"@zh ;
    clx:hasSubjectiveAspect "故意，一般以营利为目的"@zh ;
    clx:structureNode "t8755" ;
    rdfs:comment "概念组织卖淫罪，是指以招募、雇佣、纠集、强迫、引诱、容留等手段，控制多人从事卖淫的行为"@zh .

off:虚假诉讼罪 a clx:Offence ;
    rdfs:label "虚假诉讼罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c119-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_307> ;
    clx:hasObject "复杂客体，即正常的司法秩序和利益相关人的合法权益"@zh ;
    clx:hasObjectiveAspect "以捏造的事实提起民事诉讼，妨害司法秩序或严重侵害他人合法权益的行为常见的虚假诉讼表现形式有："@zh ;
    clx:hasSubject "一般主体，自然人和单位。"@zh ;
    clx:hasSubjectiveAspect "直接故意"@zh ;
    clx:structureNode "t8280" ;
    rdfs:comment "概念指以捏造的事实提起民事诉讼，妨害司法秩序或严重侵害他人合法权益的行为"@zh .

off:行贿罪 a clx:Offence ;
    rdfs:label "行贿罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c141-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_389> ;
    clx:hasObject "国家工作人员职务行为的廉洁性"@zh ;
    clx:hasObjectiveAspect "给予国家工作人员以财物的行为“谋取不正当利益”"@zh ;
    clx:hasSubject "一般主体，即自然人（单位行贿的，成立单位行贿罪）"@zh ;
    clx:hasSubjectiveAspect "故意，并且具有谋取不正当利益的目的"@zh ;
    clx:structureNode "t9232" ;
    rdfs:comment "概念指为谋取不正当利益，给予国家工作人员以财物的行为"@zh .

<http://example.org/clexml/offence/走私、贩卖、运输、制造毒品罪> a clx:Offence ;
    rdfs:label "走私、贩卖、运输、制造毒品罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c129-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_347> ;
    clx:hasObject "国家对毒品的管理制度和公民的身心健康。行为对象是毒品，如海洛因、鸦片、冰毒、大麻等"@zh ;
    clx:hasObjectiveAspect "走私、贩卖、运输、制造毒品的行为“贩卖毒品”代购毒品"@zh ;
    clx:hasSubject "一般主体，包括自然人和单位，14-16周岁的人可成为贩卖毒品罪的主体"@zh ;
    clx:hasSubjectiveAspect "故意，即行为人明知是毒品而故意走私、贩卖、运输、制造。如果不是明知，而是被别人利用或受蒙蔽而实施上述行为的，不构成犯罪"@zh ;
    clx:relatedOffence off:诈骗罪 ;
    clx:structureNode "t8656" ;
    rdfs:comment "概念指明知是毒品而故意实施走私、贩卖、运输、制造的行为"@zh ;
    prov:wasDerivedFrom "t8721" .

off:逃税罪 a clx:Offence ;
    rdfs:label "逃税罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c046-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_201> ;
    clx:hasObject "国家的税收征管制度"@zh ;
    clx:hasObjectiveAspect "纳税人采取欺骗、隐瞒手段进行虚假纳税申报或者不申报，逃避缴纳税款数额较大且占应纳税额10%以上或者扣缴义务人采用上述手段不缴或少缴已扣、已收税款，数额较大的行为"@zh ;
    clx:hasSubject "特殊主体，即纳税人、扣缴义务人，包括个人和单位(1)“纳税人”，即纳税义务人，是指按照税收征管的一系列法律规定，有义务向国家纳税的个人和企事业单位。(2)“扣缴义务人”，指根据税收征管法律的规定，负有代扣代缴义务的单位和个人，具体包括代缴义务人和代收代缴义务人。"@zh ;
    clx:hasSubjectiveAspect "故意，并具有逃避纳税义务，谋取非法利益的目的"@zh ;
    clx:structureNode "t5089" ;
    rdfs:comment "概念指纳税人釆取欺骗、隐瞒手段进行虚假纳税申报或者不申报，逃避缴纳税款数额较大且占应纳税额10%以上，或者扣缴义务人采用上述手段不缴或少缴已扣、已收税款，数额较大的行为"@zh .

off:非国家工作人员受贿罪 a clx:Offence ;
    rdfs:label "非国家工作人员受贿罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c033-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_163> ;
    clx:hasObject "国家对公司、企业以及非国有事业单位、其他组织的工作人员职务活动的管理制度"@zh ;
    clx:hasObjectiveAspect "利用职务上的便利，索取他人财物或非法收受他人财物，为他人谋取利益，数额较大的行为(2)“为他人谋取利益”"@zh ;
    clx:hasSubjectiveAspect "故意，即故意利用职务之便接受或索取贿赂，为他人谋取利益无论是索取他人财物还是非法收受他人财物’都必须为他人谋取利益"@zh ;
    clx:relatedOffence off:受贿罪 ;
    clx:structureNode "t4419" ;
    rdfs:comment "概念指公司、企业或者其他单位的工作人员利用职务上的便利，索取他人财物或者非法收受他人财物，为他人谋取利益，数额较大的行为"@zh ;
    prov:wasDerivedFrom "t4450" .

off:非法吸收公众存款罪 a clx:Offence ;
    rdfs:label "非法吸收公众存款罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c036-r-main> ;
