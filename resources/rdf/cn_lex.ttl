    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_551__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "催告后债权人未作表示的，视为不同意（第551条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c585-3> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Obligation" ;
    clx:hasCondition pred:breachingParty,
        pred:liquidatedDamagesForDelay,
        pred:paidLD ;
    clx:hasEffect pred:stillPerform ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_585__para_3> ;
    clx:strength "Defeasible" ;
    rdfs:comment "就迟延履行约定违约金的，违约方支付违约金后，还应当履行债务（第585条第3款；npc）"@zh .

<http://example.org/clexml/norm/civil/c585-increase> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:liquidatedDamages,
        pred:lowerThanLoss,
        pred:partyRequestsAdjustment ;
    clx:hasEffect pred:courtMayIncreaseLD ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_585__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "约定的违约金低于造成的损失的，可以根据当事人的请求予以增加（第585条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c585-reduce> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:excessivelyHigherThanLoss,
        pred:liquidatedDamages,
        pred:partyRequestsAdjustment ;
    clx:hasEffect pred:courtMayReduceLD ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_585__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "约定的违约金过分高于造成的损失的，可以根据当事人的请求予以适当减少（第585条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c586-cap> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c586> ;
    clx:hasCondition pred:depositContractFormed,
        pred:exceeds20PercentOfSubject ;
    clx:hasEffect pred:excessNotDeposit ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_586__para_2> ;
    clx:strength "Defeasible" ;
