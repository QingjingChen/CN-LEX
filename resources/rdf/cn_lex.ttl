    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_145__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "拒绝追认的，确定不发生效力（第145条第1款；doctrine）"@zh .

<http://example.org/clexml/norm/civil/c157> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Obligation" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c-revoked>,
        <http://example.org/clexml/norm/civil/c144>,
        <http://example.org/clexml/norm/civil/c145-refused>,
        <http://example.org/clexml/norm/civil/c146>,
        <http://example.org/clexml/norm/civil/c153-1>,
        <http://example.org/clexml/norm/civil/c153-2>,
        <http://example.org/clexml/norm/civil/c154> ;
    clx:hasCondition pred:ineffective,
        pred:obtainedPropertyUnder,
        pred:revoked,
        pred:void ;
    clx:hasEffect pred:returnOrCompensateValue ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_157> ;
    clx:strength "Defeasible" ;
    rdfs:comment "因该行为取得的财产应当返还；不能返还的折价补偿（第157条；npc）"@zh .

<http://example.org/clexml/norm/civil/c21-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:adult,
        pred:cannotDiscern ;
    clx:hasEffect pred:noCapacity ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_21__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "不能辨认自己行为的成年人为无民事行为能力人（第21条第1款；npc）"@zh .

pred:limitedCapacity a clx:Predicate .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_234> a clx:Provision ;
    rdfs:label "《刑法》第234条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第234条　故意伤害他人身体的，处三年以下有期徒刑、拘役或者管制。犯前款罪，致人重伤的，处三年以上十年以下有期徒刑；致人死亡或者以特别残忍手段致人重伤造成严重残疾的，处十年以上有期徒刑、无期徒刑或者死刑。本法另有规定的，依照规定。"@zh,
        "《刑法》第234条：故意伤害他人身体的，处三年以下有期徒刑、拘役或者管制。犯前款罪，致人重伤的，处三年以上十年以下有期徒刑；致人死亡或者以特别残忍手段致人重伤造成严重残疾的，处十年以上有期徒刑、无期徒刑或者死刑。本法另有规定的，依照规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_136> a clx:Provision ;
    rdfs:label "《民法典》第一百三十六条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百三十六条　民事法律行为自成立时生效，但是法律另有规定或者当事人另有约定的除外。
行为人非依法律规定或者未经对方同意，不得擅自变更或者解除民事法律行为。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_147> a clx:Provision ;
    rdfs:label "《民法典》第147条"@zh,
        "《民法典》第一百四十七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第147条：基于重大误解实施的民事法律行为，行为人有权请求人民法院或者仲裁机构予以撤销。"@zh,
        "《民法典》第一百四十七条　基于重大误解实施的民事法律行为，行为人有权请求人民法院或者仲裁机构予以撤销。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_19> a clx:Provision ;
    rdfs:label "《民法典》第十九条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第十九条　八周岁以上的未成年人为限制民事行为能力人，实施民事法律行为由其法定代理人代理或者经其法定代理人同意、追认；但是，可以独立实施纯获利益的民事法律行为或者与其年龄、智力相适应的民事法律行为。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_194> a clx:Provision ;
    rdfs:label "《民法典》第一百九十四条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百九十四条　在诉讼时效期间的最后六个月内，因下列障碍，不能行使请求权的，诉讼时效中止：
（一）不可抗力；
（二）无民事行为能力人或者限制民事行为能力人没有法定代理人，或者法定代理人死亡、丧失民事行为能力、丧失代理权；
（三）继承开始后未确定继承人或者遗产管理人；
（四）权利人被义务人或者其他人控制；
（五）其他导致权利人不能行使请求权的障碍。
自中止时效的原因消除之日起满六个月，诉讼时效期间届满。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_236> a clx:Provision ;
    rdfs:label "《民法典》第二百三十六条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百三十六条　妨害物权或者可能妨害物权的，权利人可以请求排除妨害或者消除危险。"@zh .

<http://example.org/clexml/norm/civil/c145-consent> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c18-emancipated>,
        <http://example.org/clexml/norm/civil/c19>,
        <http://example.org/clexml/norm/civil/c21-2>,
        <http://example.org/clexml/norm/civil/c22> ;
    clx:hasCondition pred:actOf,
        pred:guardianConsents,
        pred:guardianRatifies,
        pred:limitedCapacity ;
    clx:hasEffect pred:valid ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_145__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "其他行为经法定代理人同意或者追认后有效（第145条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c146-hidden> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:concealedBy,
        pred:shamIntent ;
    clx:hasEffect pred:validityByApplicableLaw ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_146__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "被隐藏的行为的效力，依照有关法律规定处理（不因通谋虚伪而当然无效）（第146条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c150> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c152-1-1> ;
    clx:hasCondition pred:coercedByCounterparty,
        pred:coercedByThirdParty ;
    clx:hasEffect pred:duressCase,
        pred:revocationGround ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_150> ;
    clx:strength "Defeasible" ;
    rdfs:comment "一方或者第三人胁迫的，受胁迫方有权请求撤销（第三人胁迫不问相对人是否知情）（第150条；npc）"@zh .

<http://example.org/clexml/norm/civil/c155> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c-revoked>,
        <http://example.org/clexml/norm/civil/c144>,
        <http://example.org/clexml/norm/civil/c146>,
        <http://example.org/clexml/norm/civil/c153-1>,
        <http://example.org/clexml/norm/civil/c153-2>,
        <http://example.org/clexml/norm/civil/c154> ;
    clx:hasCondition pred:revoked,
        pred:void ;
    clx:hasEffect pred:noBindingForceAbInitio ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_155> ;
    clx:strength "Defeasible" ;
    rdfs:comment "无效的或者被撤销的民事法律行为自始没有法律约束力（第155条；npc）"@zh .

<http://example.org/clexml/norm/civil/c22> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:adult,
        pred:cannotFullyDiscern ;
    clx:hasEffect pred:limitedCapacity ;
    clx:hasExceptionCondition pred:cannotDiscern ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_22> ;
    clx:strength "Defeasible" ;
    rdfs:comment "不能完全辨认自己行为的成年人为限制民事行为能力人（第22条；npc）"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_224> a clx:Provision ;
    rdfs:label "《刑法》第224条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第224条　有下列情形之一，以非法占有为目的，在签订、履行合同过程中，骗取对方当事人财物，数额较大的，处三年以下有期徒刑或者拘役，并处或者单处罚金；数额巨大或者有其他严重情节的，处三年以上十年以下有期徒刑，并处罚金；数额特别巨大或者有其他特别严重情节的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产：（一）以虚构的单位或者冒用他人名义签订合同的；（二）以伪造、变造、作废的票据或者其他虚假的产权证明作担保的；（三）没有实际履行能力，以先履行小额合同或者部分履行合同的方法，诱骗对方当事人继续签订和履行合同的；（四）收受对方当事人给付的货物、货款、预付款或者担保财产后逃匿的；（五）以其他方法骗取对方当事人财物的。"@zh,
        "《刑法》第224条：有下列情形之一，以非法占有为目的，在签订、履行合同过程中，骗取对方当事人财物，数额较大的，处三年以下有期徒刑或者拘役，并处或者单处罚金；数额巨大或者有其他严重情节的，处三年以上十年以下有期徒刑，并处罚金；数额特别巨大或者有其他特别严重情节的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产：（一）以虚构的单位或者冒用他人名义签订合同的；（二）以伪造、变造、作废的票据或者其他虚假的产权证明作担保的；（三）没有实际履行能力，以先履行小额合同或者部分履行合同的方法，诱骗对方当事人继续签订和履行合同的；（四）收受对方当事人给付的货物、货款、预付款或者担保财产后逃匿的；（五）以其他方法骗取对方当事人财物的。"@zh .

<http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_236> a clx:Provision ;
    rdfs:label "《刑法》第236条"@zh ;
    clx:code "criminal" ;
    clx:text "《刑法》第236条　以暴力、胁迫或者其他手段强奸妇女的，处三年以上十年以下有期徒刑。奸淫不满十四周岁的幼女的，以强奸论，从重处罚。强奸妇女、奸淫幼女，有下列情形之一的，处十年以上有期徒刑、无期徒刑或者死刑：（一）强奸妇女、奸淫幼女情节恶劣的；（二）强奸妇女、奸淫幼女多人的；（三）在公共场所当众强奸妇女、奸淫幼女的；（四）二人以上轮奸的；（五）奸淫不满十周岁的幼女或者造成幼女伤害的；（六）致使被害人重伤、死亡或者造成其他严重后果的。"@zh,
        "《刑法》第236条：以暴力、胁迫或者其他手段强奸妇女的，处三年以上十年以下有期徒刑。奸淫不满十四周岁的幼女的，以强奸论，从重处罚。强奸妇女、奸淫幼女，有下列情形之一的，处十年以上有期徒刑、无期徒刑或者死刑：（一）强奸妇女、奸淫幼女情节恶劣的；（二）强奸妇女、奸淫幼女多人的；（三）在公共场所当众强奸妇女、奸淫幼女的；（四）二人以上轮奸的；（五）奸淫不满十周岁的幼女或者造成幼女伤害的；（六）致使被害人重伤、死亡或者造成其他严重后果的。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_116> a clx:Provision ;
    rdfs:label "《民法典》第一百一十六条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百一十六条　物权的种类和内容，由法律规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_132> a clx:Provision ;
    rdfs:label "《民法典》第一百三十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百三十二条　民事主体不得滥用民事权利损害国家利益、社会公共利益或者他人合法权益。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_150> a clx:Provision ;
    rdfs:label "《民法典》第150条"@zh,
        "《民法典》第一百五十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第150条：一方或者第三人以胁迫手段，使对方在违背真实意思的情况下实施的民事法律行为，受胁迫方有权请求人民法院或者仲裁机构予以撤销。"@zh,
        "《民法典》第一百五十条　一方或者第三人以胁迫手段，使对方在违背真实意思的情况下实施的民事法律行为，受胁迫方有权请求人民法院或者仲裁机构予以撤销。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_157> a clx:Provision ;
    rdfs:label "《民法典》第157条"@zh,
        "《民法典》第一百五十七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第157条：民事法律行为无效、被撤销或者确定不发生效力后，行为人因该行为取得的财产，应当予以返还；不能返还或者没有必要返还的，应当折价补偿。有过错的一方应当赔偿对方由此所受到的损失；各方都有过错的，应当各自承担相应的责任。法律另有规定的，依照其规定。"@zh,
        "《民法典》第一百五十七条　民事法律行为无效、被撤销或者确定不发生效力后，行为人因该行为取得的财产，应当予以返还；不能返还或者没有必要返还的，应当折价补偿。有过错的一方应当赔偿对方由此所受到的损失；各方都有过错的，应当各自承担相应的责任。法律另有规定的，依照其规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_209> a clx:Provision ;
    rdfs:label "《民法典》第二百零九条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第二百零九条　不动产物权的设立、变更、转让和消灭，经依法登记，发生效力；未经登记，不发生效力，但是法律另有规定的除外。
依法属于国家所有的自然资源，所有权可以不登记。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_234> a clx:Provision ;
    rdfs:label "《民法典》第二百三十四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百三十四条　因物权的归属、内容发生争议的，利害关系人可以请求确认权利。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_4> a clx:Provision ;
    rdfs:label "《民法典》第四条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第四条　民事主体在民事活动中的法律地位一律平等。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_986> a clx:Provision ;
    rdfs:label "《民法典》第九百八十六条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第九百八十六条　得利人不知道且不应当知道取得的利益没有法律根据，取得的利益已经不存在的，不承担返还该利益的义务。"@zh .

<http://example.org/clexml/norm/civil/c149> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:counterpartyKnewOrShouldKnowFraud,
        pred:deceivedByThirdParty ;
    clx:hasEffect pred:revocationGround ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_149> ;
    clx:strength "Defeasible" ;
    rdfs:comment "第三人欺诈，对方知道或应当知道的，受欺诈方有权请求撤销（第149条；npc）"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1173> a clx:Provision ;
    rdfs:label "《民法典》第一千一百七十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百七十三条　被侵权人对同一损害的发生或者扩大有过错的，可以减轻侵权人的责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_133> a clx:Provision ;
    rdfs:label "《民法典》第一百三十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百三十三条　民事法律行为是民事主体通过意思表示设立、变更、终止民事法律关系的行为。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_207> a clx:Provision ;
    rdfs:label "《民法典》第二百零七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百零七条　国家、集体、私人的物权和其他权利人的物权受法律平等保护，任何组织或者个人不得侵犯。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_508> a clx:Provision ;
    rdfs:label "《民法典》第五百零八条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百零八条　本编对合同的效力没有规定的，适用本法第一编第六章的有关规定。"@zh .

<http://example.org/clexml/norm/civil/c-revocable-valid> a clx:ConstitutiveNorm ;
