    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_141> ;
    clx:hasObject "复杂客体，既侵犯了国家对药品的管理制度，又侵犯了不特定多数人的身体健康权利"@zh ;
    clx:hasObjectiveAspect "指生产者、销售者违反国家药品管理法律法规，生产、销售假药或者药品使用单位的人员明知是假药而提供给他人使用的行为(1)“药品”，是指依照《药品管理法》的规定属于按假药处理的药品。根据该法第98条的规定，有下列情形之一的，为假药:(4)“生产”(5)“销售”“提供”"@zh ;
    clx:hasSubject "一般主体，个人和单位，包括假药的生产者和销售者、提供者。"@zh ;
    clx:hasSubjectiveAspect "故意，一般出于营利的目的，但是否具有营利目的不影响本罪成立。在生产领域表现为生产者故意制造假药，在销售领域包括医疗机构表现为明知是假药而使用或销售"@zh ;
    clx:relatedOffence <http://example.org/clexml/offence/生产、销售伪劣产品罪>,
        off:非法经营罪 ;
    clx:structureNode "t4148" ;
    rdfs:comment "概念指生产者、销售者违反国家药品管理法律法规，生产、销售假药或者药品使用单位的人员明知是假药而提供给他人使用的行为"@zh ;
    prov:wasDerivedFrom "t4203",
        "t4207" .

off:盗伐林木罪 a clx:Offence ;
    rdfs:label "盗伐林木罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c128-r-main> ;
