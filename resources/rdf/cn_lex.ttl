    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1246> ;
    clx:strength "Defeasible" ;
    rdfs:comment "违反管理规定的，只有被侵权人故意才可以减轻责任（不能免除）（第1246条；npc）"@zh .

<http://example.org/clexml/norm/civil/c193> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Prohibition" ;
    clx:hasCondition pred:claim,
        pred:courtHears ;
    clx:hasEffect pred:applyLimitationExOfficio ;
    clx:layer "civil" ;
    clx:module "诉讼时效"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_193> ;
    clx:strength "Defeasible" ;
    rdfs:comment "人民法院不得主动适用诉讼时效的规定（第193条；npc）"@zh .

<http://example.org/clexml/norm/civil/c406-early> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:hasCondition pred:mortgageContract,
        pred:transferMayHarmMortgage,
        pred:transfersProperty ;
    clx:hasEffect pred:demandEarlyPaymentOrEscrow ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_406__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "能够证明转让可能损害抵押权的，可以请求以转让价款提前清偿或者提存（第406条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c406-notify> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Obligation" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c402>,
        <http://example.org/clexml/norm/civil/c402-noreg>,
        <http://example.org/clexml/norm/civil/c403> ;
    clx:hasCondition pred:mortgageContract,
        pred:mortgageEstablished,
        pred:transfersProperty ;
    clx:hasEffect pred:notifyMortgagee ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_406__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "抵押人转让抵押财产的，应当及时通知抵押权人（第406条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c406-perm> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Permission" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c402>,
        <http://example.org/clexml/norm/civil/c402-noreg>,
        <http://example.org/clexml/norm/civil/c403> ;
    clx:hasCondition pred:mortgageContract,
        pred:mortgageEstablished ;
    clx:hasEffect pred:transferMortgagedProperty ;
    clx:hasExceptionCondition pred:agreedNoTransfer ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_406__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "抵押期间，抵押人可以转让抵押财产；当事人另有约定的，按照其约定（第406条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c407-follow> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c402>,
        <http://example.org/clexml/norm/civil/c402-noreg>,
        <http://example.org/clexml/norm/civil/c403>,
        <http://example.org/clexml/norm/civil/c420-in>,
        <http://example.org/clexml/norm/civil/c420-pre>,
        <http://example.org/clexml/norm/civil/c423-after> ;
    clx:hasCondition pred:claimAssigned,
        pred:mortgageContract,
        pred:mortgageEstablished,
        pred:securedClaim ;
    clx:hasEffect pred:mortgageTransfersTo ;
    clx:hasExceptionCondition pred:agreedMortgageNotFollow ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_407> ;
    clx:strength "Defeasible" ;
    rdfs:comment "债权转让的，担保该债权的抵押权一并转让；法律另有规定或当事人另有约定的除外（第407条；npc）"@zh .

<http://example.org/clexml/norm/civil/c415> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:mortgageVsPledge,
        pred:perfectedEarlier,
        pred:sameCollateral ;
    clx:hasEffect pred:ranksBefore ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_415> ;
    clx:strength "Defeasible" ;
    rdfs:comment "同一财产既抵押又出质的，按登记、交付的时间先后确定清偿顺序（第415条；npc）"@zh .

<http://example.org/clexml/norm/civil/c420-in> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:claimArisesInPeriod,
        pred:maxAmountMortgage ;
    clx:hasEffect pred:securedClaim ;
    clx:hasExceptionCondition pred:arisesAfterDetermination ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_420__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "一定期间内连续发生的债权，在最高债权额限度内受担保（第420条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c423> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c421> ;
    clx:hasCondition pred:agreedDeterminationPeriodExpired,
        pred:debtorOrMortgagorBankruptOrDissolved,
        pred:determinationRequested,
        pred:maxAmountMortgage,
        pred:mortgageeKnowsSeizure,
        pred:noAgreedPeriod,
        pred:noNewClaimPossible,
        pred:twoYearsSinceEstablished ;
    clx:hasEffect pred:securedClaimsDetermined ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_423> ;
    clx:strength "Defeasible" ;
    rdfs:comment "约定期间届满、无约定满二年请求确定、不可能发生新债权、知道查封扣押、破产解散等，债权确定（第423条；npc）"@zh .

<http://example.org/clexml/norm/civil/c447-priority> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c447>,
        <http://example.org/clexml/norm/civil/c449> ;
    clx:hasCondition pred:lienRight ;
    clx:hasEffect pred:priorityFromLien ;
    clx:layer "civil" ;
    clx:module "留置权"@zh ;
