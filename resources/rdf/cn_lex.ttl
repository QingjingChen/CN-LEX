pred:sentence a clx:Predicate .

pred:responsible a clx:Predicate .

clx:PrescriptiveNorm a owl:Class ;
    rdfs:subClassOf clx:Norm .

clx:Offence a owl:Class ;
    rdfs:subClassOf owl:Thing .

pred:constitutes a clx:Predicate .

clx:TaxonomicNorm a owl:Class ;
    rdfs:subClassOf clx:ConstitutiveNorm .

pred:isA a clx:Predicate .

clx:ConstitutiveNorm a owl:Class ;
    rdfs:subClassOf clx:Norm .

clx:Provision a owl:Class ;
    rdfs:subClassOf lrmlmm:LegalSource .

clx:Predicate a owl:Class ;
    rdfs:subClassOf owl:Thing .

