    clx:strength "Defeasible" ;
    rdfs:comment "兄弟姐妹先于被继承人死亡的，由兄弟姐妹的子女代位继承（属第二顺序）（第1128条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c145-revoke> a clx:PrescriptiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Right" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c145-pending> ;
    clx:hasCondition pred:counterpartyOf,
        pred:inGoodFaith,
        pred:pendingValidity ;
    clx:hasEffect pred:revokeRight ;
    clx:layer "civil" ;
    clx:module "民事行为能力与法律行为效力"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_145__para_2> ;
    clx:strength "Defeasible" ;
    rdfs:comment "追认前，善意相对人有撤销的权利（第145条第2款；npc）"@zh .

<http://example.org/clexml/norm/civil/c152-1-1> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c147>,
        <http://example.org/clexml/norm/civil/c148>,
        <http://example.org/clexml/norm/civil/c149>,
        <http://example.org/clexml/norm/civil/c150>,
        <http://example.org/clexml/norm/civil/c151> ;
    clx:hasCondition pred:oneYearSinceKnewGround,
        pred:revocationGround ;
    clx:hasEffect pred:revocationRight ;
    clx:hasExceptionCondition pred:duressCase,
        pred:majorMisunderstanding ;
    clx:layer "civil" ;
    clx:module "可撤销的民事法律行为"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c-revocation-right> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_152__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "自知道或应当知道撤销事由之日起一年内没有行使的，撤销权消灭（第152条第1款；npc）"@zh .

<http://example.org/clexml/norm/civil/c226-delivery> a clx:ConstitutiveNorm ;
    clx:authority auth:doctrine ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:exceptionTo <http://example.org/clexml/norm/civil/c604-before> ;
    clx:hasCondition pred:buyerAlreadyPossesses,
        pred:sale ;
    clx:hasEffect pred:delivered ;
    clx:layer "civil" ;
    clx:module "合同"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_226>,
        <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_604> ;
    clx:strength "Defeasible" ;
    rdfs:comment "买受人已经占有标的物的（如借用、租赁中买下），买卖合同生效时视为交付（简易交付），风险随之转移（第226条、第604条；doctrine）"@zh .

<http://example.org/clexml/norm/civil/c402> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c-revocable-valid>,
        <http://example.org/clexml/norm/civil/c-valid-default>,
        <http://example.org/clexml/norm/civil/c-void-not-valid>,
        <http://example.org/clexml/norm/civil/c145-consent>,
        <http://example.org/clexml/norm/civil/c145-pure>,
        <http://example.org/clexml/norm/civil/c145-refused>,
        <http://example.org/clexml/norm/civil/c395>,
        <http://example.org/clexml/norm/civil/c402-type> ;
    clx:hasCondition pred:mortgageContract,
        pred:mortgageObjectOk,
        pred:mortgageRegistered,
        pred:registrationConstitutive,
        pred:valid ;
    clx:hasEffect pred:mortgageEstablished ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_402> ;
    clx:strength "Defeasible" ;
    rdfs:comment "不动产抵押：抵押权自登记时设立（第402条；npc）"@zh .

<http://example.org/clexml/norm/civil/c402-noreg> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c402-type> ;
    clx:hasCondition pred:mortgageContract,
        pred:registrationConstitutive ;
    clx:hasEffect pred:mortgageEstablished ;
    clx:hasExceptionCondition pred:mortgageRegistered ;
    clx:layer "civil" ;
    clx:module "抵押权"@zh ;
    clx:negatedEffect true ;
    clx:overrides <http://example.org/clexml/norm/civil/c403> ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_402> ;
    clx:strength "Defeasible" ;
    rdfs:comment "应当登记而未登记的，抵押权不设立（抵押合同效力不受影响，第215条）（第402条；npc）"@zh .

off:故意杀人罪 a clx:Offence ;
    rdfs:label "故意杀人罪"@zh ;
    clx:definedBy <http://example.org/clexml/norm/criminal/jx-c057-r-main> ;
    clx:groundedIn <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_232> ;
    clx:hasObject "他人的生命权利。我国刑法学界一般认为，人的生命自胎儿分离出母体并能够独立呼吸时开始，自大脑停止活动时结束"@zh ;
    clx:hasObjectiveAspect "实施非法剥夺他人生命的行为，包括作为和不作为"@zh ;
    clx:hasSubject "一般主体，即年满14周岁并具有刑事责任能力的自然人"@zh ;
    clx:hasSubjectiveAspect "故意，包括直接故意和间接故意。动机是多种多样和错综复杂的，常见的如报复、图财、拒捕、义愤、气愤、失恋、流氓动机等，动机可以反映杀人者主观恶性的不同程度，对正确量刑有重要意义，但不影响本罪的成立"@zh ;
    clx:relatedOffence off:放火罪 ;
    clx:structureNode "t5656" ;
    rdfs:comment "概念指故意非法剥夺他人生命的行为"@zh ;
    prov:wasDerivedFrom "t5685" .

pred:mortgageEstablished a clx:Predicate .

pred:noCapacity a clx:Predicate .

pred:revocationGround a clx:Predicate .

pred:void a clx:Predicate .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_112> a clx:Provision ;
    rdfs:label "《民法典》第一百一十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百一十二条　自然人因婚姻家庭关系等产生的人身权利受法律保护。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1121> a clx:Provision ;
    rdfs:label "《民法典》第一千一百二十一条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一千一百二十一条　继承从被继承人死亡时开始。
相互有继承关系的数人在同一事件中死亡，难以确定死亡时间的，推定没有其他继承人的人先死亡。都有其他继承人，辈份不同的，推定长辈先死亡；辈份相同的，推定同时死亡，相互不发生继承。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1123> a clx:Provision ;
    rdfs:label "《民法典》第1123条"@zh,
        "《民法典》第一千一百二十三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第1123条：继承开始后，按照法定继承办理；有遗嘱的，按照遗嘱继承或者遗赠办理；有遗赠扶养协议的，按照协议办理。"@zh,
        "《民法典》第一千一百二十三条　继承开始后，按照法定继承办理；有遗嘱的，按照遗嘱继承或者遗赠办理；有遗赠扶养协议的，按照协议办理。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1172> a clx:Provision ;
    rdfs:label "《民法典》第一千一百七十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一千一百七十二条　二人以上分别实施侵权行为造成同一损害，能够确定责任大小的，各自承担相应的责任；难以确定责任大小的，平均承担责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_12> a clx:Provision ;
    rdfs:label "《民法典》第十二条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第十二条　中华人民共和国领域内的民事活动，适用中华人民共和国法律。法律另有规定的，依照其规定。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_135> a clx:Provision ;
    rdfs:label "《民法典》第一百三十五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第一百三十五条　民事法律行为可以采用书面形式、口头形式或者其他形式；法律、行政法规规定或者当事人约定采用特定形式的，应当采用特定形式。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_151> a clx:Provision ;
    rdfs:label "《民法典》第151条"@zh,
        "《民法典》第一百五十一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第151条：一方利用对方处于危困状态、缺乏判断能力等情形，致使民事法律行为成立时显失公平的，受损害方有权请求人民法院或者仲裁机构予以撤销。"@zh,
        "《民法典》第一百五十一条　一方利用对方处于危困状态、缺乏判断能力等情形，致使民事法律行为成立时显失公平的，受损害方有权请求人民法院或者仲裁机构予以撤销。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_152> a clx:Provision ;
    rdfs:label "《民法典》第一百五十二条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第一百五十二条　有下列情形之一的，撤销权消灭：
（一）当事人自知道或者应当知道撤销事由之日起一年内、重大误解的当事人自知道或者应当知道撤销事由之日起九十日内没有行使撤销权；
（二）当事人受胁迫，自胁迫行为终止之日起一年内没有行使撤销权；
（三）当事人知道撤销事由后明确表示或者以自己的行为表明放弃撤销权。
当事人自民事法律行为发生之日起五年内没有行使撤销权的，撤销权消灭。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_20> a clx:Provision ;
    rdfs:label "《民法典》第20条"@zh,
        "《民法典》第二十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第20条：不满八周岁的未成年人为无民事行为能力人，由其法定代理人代理实施民事法律行为。"@zh,
        "《民法典》第二十条　不满八周岁的未成年人为无民事行为能力人，由其法定代理人代理实施民事法律行为。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_231> a clx:Provision ;
    rdfs:label "《民法典》第二百三十一条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百三十一条　因合法建造、拆除房屋等事实行为设立或者消灭物权的，自事实行为成就时发生效力。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_235> a clx:Provision ;
    rdfs:label "《民法典》第二百三十五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百三十五条　无权占有不动产或者动产的，权利人可以请求返还原物。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_240> a clx:Provision ;
    rdfs:label "《民法典》第二百四十条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第二百四十条　所有权人对自己的不动产或者动产，依法享有占有、使用、收益和处分的权利。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_503> a clx:Provision ;
    rdfs:label "《民法典》第五百零三条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百零三条　无权代理人以被代理人的名义订立合同，被代理人已经开始履行合同义务或者接受相对人履行的，视为对合同的追认。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_528> a clx:Provision ;
    rdfs:label "《民法典》第五百二十八条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百二十八条　当事人依据前条规定中止履行的，应当及时通知对方。对方提供适当担保的，应当恢复履行。中止履行后，对方在合理期限内未恢复履行能力且未提供适当担保的，视为以自己的行为表明不履行主要债务，中止履行的一方可以解除合同并可以请求对方承担违约责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_57> a clx:Provision ;
    rdfs:label "《民法典》第五十七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五十七条　法人是具有民事权利能力和民事行为能力，依法独立享有民事权利和承担民事义务的组织。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_577> a clx:Provision ;
    rdfs:label "《民法典》第五百七十七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第五百七十七条　当事人一方不履行合同义务或者履行合同义务不符合约定的，应当承担继续履行、采取补救措施或者赔偿损失等违约责任。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_580> a clx:Provision ;
    rdfs:label "《民法典》第五百八十条"@zh ;
    clx:code "civil" ;
    clx:text """《民法典》第五百八十条　当事人一方不履行非金钱债务或者履行非金钱债务不符合约定的，对方可以请求履行，但是有下列情形之一的除外：
（一）法律上或者事实上不能履行；
（二）债务的标的不适于强制履行或者履行费用过高；
（三）债权人在合理期限内未请求履行。
有前款规定的除外情形之一，致使不能实现合同目的的，人民法院或者仲裁机构可以根据当事人的请求终止合同权利义务关系，但是不影响违约责任的承担。"""@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_7> a clx:Provision ;
    rdfs:label "《民法典》第七条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第七条　民事主体从事民事活动，应当遵循诚信原则，秉持诚实，恪守承诺。"@zh .

<http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_725> a clx:Provision ;
    rdfs:label "《民法典》第七百二十五条"@zh ;
    clx:code "civil" ;
    clx:text "《民法典》第七百二十五条　租赁物在承租人按照租赁合同占有期限内发生所有权变动的，不影响租赁合同的效力。"@zh .

<http://example.org/clexml/norm/civil/c1123-intestate> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:estateOf ;
    clx:hasEffect pred:byIntestacy ;
    clx:hasExceptionCondition pred:effectiveWillCovers,
        pred:supportAgreementCovers ;
    clx:layer "civil" ;
    clx:module "继承"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/2020-05-28/civil-code/zho@/!main#art_1123> ;
    clx:strength "Defeasible" ;
    rdfs:comment "继承开始后，按照法定继承办理（第1123条；npc）"@zh .

<http://example.org/clexml/norm/civil/c1127-2-second> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:dependsOn <http://example.org/clexml/norm/civil/c1123-intestate>,
