<http://example.org/clexml/norm/civil/c528-resume> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "civil" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:adequateSecurityProvided,
