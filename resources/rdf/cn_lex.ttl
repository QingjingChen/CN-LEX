        pred:causesGraveInjuryOrDeath,
        pred:convicted,
        pred:impersonatesMilitaryOrPolice,
        pred:inHome,
        pred:militaryOrReliefSupplies,
        pred:multipleRobberyOrHugeAmount,
        pred:onPublicTransport,
        pred:targetsBankOrFinancialInstitution ;
    clx:hasEffect pred:aggravatedRobbery ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_263> ;
    clx:strength "Defeasible" ;
    rdfs:comment "入户、在公共交通工具上、抢劫银行、多次或数额巨大、致人重伤死亡、冒充军警、持枪、抢劫军用或救灾物资：十年以上、无期或死刑（第263条；npc）"@zh .

