    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_232> ;
    clx:strength "Defeasible" ;
    rdfs:comment "故意杀人的（第232条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k234> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:intentionallyInjures ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_234__para_1> ;
    clx:strength "Defeasible" ;
    rdfs:comment "故意伤害他人身体的（第234条第1款；npc）"@zh .

<http://example.org/clexml/norm/criminal/k263> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:illegalPossessionPurpose,
        pred:takesProperty,
        pred:violenceOrCoercion ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_263> ;
    clx:strength "Defeasible" ;
    rdfs:comment "以暴力、胁迫或者其他方法抢劫财物的（第263条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k264> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:burglaryOfHome,
        pred:carryingWeapon,
        pred:illegalPossessionPurpose,
        pred:multipleTheft,
        pred:pickpocketing,
        pred:takesSecretly ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
    clx:sourceProvision <http://example.org/akn/cn/act/1997-03-14/criminal-law/zho@2023-12-29/!main#art_264> ;
    clx:strength "Defeasible" ;
    rdfs:comment "盗窃公私财物，数额较大，或者多次盗窃、入户盗窃、携带凶器盗窃、扒窃的（第264条；npc）"@zh .

<http://example.org/clexml/norm/criminal/k266> a clx:ConstitutiveNorm ;
    clx:authority auth:npc ;
    clx:code "criminal" ;
    clx:deonticMode "Constitutive" ;
    clx:hasCondition pred:amountRelativelyLarge,
        pred:deceives,
        pred:illegalPossessionPurpose,
        pred:victimDisposesUnderMistake ;
    clx:hasEffect pred:constitutes ;
    clx:layer "criminal" ;
    clx:module "分则常见罪名"@zh ;
