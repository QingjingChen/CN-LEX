      <lrml:Comment>传染病防治失职罪：客观方面</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c154-r-oa">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c154_conduct"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:threshold"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Ind>circumstancesSerious</ruleml:Ind>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnj:c154_objective"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="jx-c154-r-sub">
      <lrml:Comment>传染病防治失职罪：犯罪主体</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c154-r-sub">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:specialSubject"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Ind>other</ruleml:Ind>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnj:c154_subject"/>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="jx-c154-r-sa">
      <lrml:Comment>传染病防治失职罪：主观方面</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c154-r-sa">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:mens"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
            <ruleml:Ind>intent</ruleml:Ind>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnj:c154_subjective"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="jx-c154-r-main">
      <lrml:Comment>传染病防治失职罪：犯罪构成 = 客体 ∧ 客观方面 ∧ 主体 ∧ 主观方面，除非 1 项出罪情形</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c154-r-main">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c154_object"/>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c154_objective"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c154_subject"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c154_subjective"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnj:c154_exc_sa_0"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:constitutes"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
            <ruleml:Ind>c154</ruleml:Ind>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
  </lrml:Statements>
</lrml:LegalRuleML>
