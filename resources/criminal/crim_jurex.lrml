    <lrml:ConstitutiveStatement key="jx-c062-r-enum-0.5">
      <lrml:Comment>强奸罪：针对未成年人实施强奸、猥亵犯罪的，应当从重处罚，具有下列情形（7 种方式择一）</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c062-r-enum-0.5">
        <ruleml:if>
          <ruleml:Or>
