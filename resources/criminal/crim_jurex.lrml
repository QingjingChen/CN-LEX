    <lrml:ConstitutiveStatement key="jx-c041-r-enum-0.0">
      <lrml:Comment>洗钱罪：洗钱罪的行为方式有五种（通过金融手段）（5 种方式择一）</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c041-r-enum-0.0">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c041_oa_0_0_0"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c041_oa_0_0_1"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c041_oa_0_0_2"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
