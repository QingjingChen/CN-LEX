    <lrml:ConstitutiveStatement key="jx-c062-r-enum-0.7">
      <lrml:Comment>强奸罪：考生应当牢记强奸罪法定刑升格的情形，这是法硕考试的常考点。（5 种方式择一）</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c062-r-enum-0.7">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_7_0"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_7_1"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_7_2"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_7_3"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
