    <lrml:ConstitutiveStatement key="jx-c030-r-main">
      <lrml:Comment>生产、销售有毒、有害食品罪：犯罪构成 = 客体 ∧ 客观方面 ∧ 主体 ∧ 主观方面</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c030-r-main">
