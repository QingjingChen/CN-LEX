            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_5_5"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnj:c062_oa_0_5_6"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnj:c062_oa_0_5"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
