    <lrml:ConstitutiveStatement key="jx-c053-r-enum-0">
      <lrml:Comment>合同诈骗罪：在签订、履行合同的过程中，骗取合同一方当事人的财物，【数额较（5 种方式择一）</lrml:Comment>
      <ruleml:Rule closure="universal" key=":jx-c053-r-enum-0">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
