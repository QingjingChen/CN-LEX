    <lrml:PrescriptiveStatement key="c365-transfer-ds">
      <lrml:Comment>已经登记的宅基地使用权转让的，应当及时办理变更登记；条文未明确义务人，此处以宅基地使用权人为义务人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c365-transfer-ds", "articles": ["365"], "provenance": {"kind": "draft", "row_id": "art:365", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c365-transfer-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:registeredInRegister"/>
              <ruleml:Var>H</ruleml:Var>
