              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:fatherOf"/>
              <ruleml:Var>F</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:marriageDissolved"/>
              <ruleml:Var>F</ruleml:Var>
              <ruleml:Var>M</ruleml:Var>
