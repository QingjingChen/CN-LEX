              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c1151-1">
      <lrml:Comment>存有遗产的人，应当妥善保管遗产
