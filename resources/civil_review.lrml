    <lrml:FactualStatement key="review-draft_annotations-000869">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1226", "field": "distinguish", "annotation": {"text": "保密义务的主体既包括医疗机构，也包括其医务人员；侵权责任分别由实施泄露、公开行为的主体承担", "rules": ["c1226-1-ds", "c1226-2-ds", "c1226-3-ds", "c1226-4-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
