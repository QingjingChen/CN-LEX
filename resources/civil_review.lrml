              <ruleml:Rel iri="cnv:constructionPricePriority"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c807-spc40">
      <lrml:Comment>法释〔2020〕25号第40条：优先受偿范围依国务院有关行政主管部门关于建设工程价款范围的规定确定；承包人就逾期支付建设工程价款的利息、违约金、损害赔偿金等主张优先受偿的，人民法院不予支持（已逐字核对）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c807-spc40", "articles": ["807"], "provenance": {"kind": "draft", "row_id": "card:g5525", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记两处过时：优先受偿权期限“竣工之日起六个月”已按施工合同解释（一）第41条改为“合理期限、最长十八个月、自应付款之日起算”；装饰装修但书已按第37条改为“具备折价或者拍卖条件”\n  · 起草者提示：三条反面推论待复核：c807-qual（质量不合格不享有优先受偿权，学理）、c807-spc41（超期丧失）、c807-spc42（未损害工人利益的放弃约定可对抗承包人）；《商品房消费者权利保护批复》未逐字核对，只写在区分栏\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c807-spc40">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionPricePriority"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:projectOf"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lateInterestPenaltyOrDamages"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:coveredByConstructionPriority"/>
