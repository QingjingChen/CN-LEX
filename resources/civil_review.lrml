      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:331", "field": "distinguish", "annotation": {"text": "笔记未引用原文或条号，LEGO 卡片缺失，本条形式化仅以法条原文为准，未引入学理内容", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
