                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1223-1-ds">
      <lrml:Comment>因药品、消毒产品、医疗器械缺陷或输入不合格血液致害的，患者可以向药品上市许可持有人、生产者、血液提供机构请求赔偿
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1223-1-ds", "articles": ["1223"], "provenance": {"kind": "draft", "row_id": "card:g7757", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1223-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:patient"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:damage"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:defectiveMedicalProduct"/>
