    <lrml:ConstitutiveStatement key="c858-1-ds">
      <lrml:Comment>技术开发合同履行中因无法克服的技术困难致研究开发失败或部分失败的，风险由当事人约定负担
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c858-1-ds", "articles": ["858"], "provenance": {"kind": "draft", "row_id": "art:858", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c858-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:techDevelopmentContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:insurmountableTechnicalDifficulty"/>
              <ruleml:Var>K</ruleml:Var>
