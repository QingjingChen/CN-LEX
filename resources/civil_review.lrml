            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:partOfContractedWork"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mainStructureConstruction"/>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerConsentedSubcontract"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c791-3c-h0">
              <lrml:Paraphrase>建设工程主体结构的施工必须由承包人自行完成，即使经发包人同意也不得分包</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:subcontractToThirdParty"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c791-3d">
      <lrml:Comment>建设工程主体结构的施工必须由承包人自行完成
