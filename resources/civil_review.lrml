            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:parentsMaySeriouslyHarm"/>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c1095-1-ds-h0">
              <lrml:Paraphrase>父母均不具备完全民事行为能力且可能严重危害该未成年人的，其监护人可以将其送养</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>G</ruleml:Var>
