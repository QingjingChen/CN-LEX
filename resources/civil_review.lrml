        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c511-methodg4164">
      <lrml:Comment>履行方式不明确的，按照有利于实现合同目的的方式履行
