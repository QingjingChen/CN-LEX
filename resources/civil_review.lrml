    <lrml:PrescriptiveStatement key="c1100-a47">
      <lrml:Comment>无子女的收养人可以收养两名子女
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1100-a47", "articles": ["1100"], "provenance": {"kind": "draft", "row_id": "card:g6847", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第1104条“双方自愿”写成收养合意 adoptionConsensusReached，作为收养成立的前提；同时把第1098条资格、可被收养并入成立条件，属形式化取舍；第1113条无效规则不在本行\n  · 起草者提示：八周岁以上被收养人未同意写成 -adoptionEstablished，并声明优先于成立规则\n  · 起草者提示：第1117条“成年养子女”以解除时是否成年判断\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1100-a47">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:prospectiveAdopter"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noChildren"/>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c1100-a47-h0">
              <lrml:Paraphrase>无子女的收养人可以收养两名子女</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adoptTwoChildren"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1100-b47">
      <lrml:Comment>有子女的收养人只能收养一名子女
