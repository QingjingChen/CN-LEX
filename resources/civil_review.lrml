              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
