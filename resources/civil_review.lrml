                <ruleml:Rel iri="cnv:sameLegalRelation"/>
                <ruleml:Var>T</ruleml:Var>
                <ruleml:Var>Z</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:betweenEnterprises"/>
