    <lrml:PrescriptiveStatement key="c629-1-ds">
      <lrml:Comment>出卖人多交标的物的，买受人可以接收或者拒绝接收多交的部分
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c629-1-ds", "articles": ["629"], "provenance": {"kind": "draft", "row_id": "art:629", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c629-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:buyerOf"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:sellerOf"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:excessSubjectMatterDelivered"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Permission key="c629-1-ds-h0">
              <lrml:Paraphrase>出卖人多交标的物的，买受人可以接收或者拒绝接收多交的部分</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:acceptExcessPart"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
            <lrml:Permission key="c629-1-ds-h1">
              <lrml:Paraphrase>出卖人多交标的物的，买受人可以接收或者拒绝接收多交的部分</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:rejectExcessPart"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
