    <lrml:PrescriptiveStatement key="c935-ds">
      <lrml:Comment>因委托人死亡或被宣告破产、解散致委托合同终止将损害委托人利益的，在继承人、遗产管理人或者清算人承受委托事务之前，受托人应当继续处理委托事务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c935-ds", "articles": ["935"], "provenance": {"kind": "draft", "row_id": "card:g5741", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c935-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:principalOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mandataryOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:dead"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:principalBankruptOrDissolved"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationWouldHarmPrincipal"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:successorTookOverAffairs"/>
