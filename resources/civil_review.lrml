                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:preemptivePurchaseOfShare"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
