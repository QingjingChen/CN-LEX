        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c990-2-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:enjoyOtherPersonalityInterest"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c992">
      <lrml:Comment>人格权不得放弃、转让或者继承
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c992", "articles": ["992"], "provenance": {"kind": "draft", "row_id": "card:g6049", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第990条第1款、第993条的“等”为开放列举，具体权利靠输入谓词 enumeratedPersonalityRight/licensableAttribute 提供\n  · 起草者提示：c992“不得继承”写成构成性结论 -heritableRight(P,R)；放弃、转让人格权协议的效力条文未写，未入规则\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c992">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
