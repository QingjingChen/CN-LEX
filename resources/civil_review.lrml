          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c556-1-ds">
      <lrml:Comment>合同的权利和义务一并转让的，其中的债权部分适用债权转让的规定，债务部分适用债务转移的规定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c556-1-ds", "articles": ["556"], "provenance": {"kind": "draft", "row_id": "art:556", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c556-1-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:transferContractRightsAndObligationsTogether"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:applyClaimAssignmentProvisions"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:applyDebtTransferProvisions"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c554-1-ds">
      <lrml:Comment>债务人D将债务Debt转移给新债务人N的，N应当承担与主债务有关的从债务Acc，但从债务专属于原债务人自身的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c554-1-ds", "articles": ["554"], "provenance": {"kind": "draft", "row_id": "art:554", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c554-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtTransfer"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>N</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:accessoryDebtOf"/>
              <ruleml:Var>Acc</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:personalToOriginalDebtor"/>
                <ruleml:Var>Acc</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c554-1-ds-h0">
              <lrml:Paraphrase>债务人D将债务Debt转移给新债务人N的，N应当承担与主债务有关的从债务Acc，但从债务专属于原债务人自身的除外</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>N</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:bearAccessoryDebt"/>
                <ruleml:Var>N</ruleml:Var>
                <ruleml:Var>Acc</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c554-exc-ds">
      <lrml:Comment>从债务专属于原债务人自身的，不随主债务移转，新债务人不承担该从债务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c554-exc-ds", "articles": ["554"], "provenance": {"kind": "draft", "row_id": "art:554", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c554-exc-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtTransfer"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>N</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:accessoryDebtOf"/>
              <ruleml:Var>Acc</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:personalToOriginalDebtor"/>
              <ruleml:Var>Acc</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:bearAccessoryDebt"/>
