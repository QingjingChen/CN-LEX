                <ruleml:Var>R</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:contributesLandUseRight"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:giftsLandUseRight"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:attachedStructure"/>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:attachedToLand"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c356-1-ds-h0">
