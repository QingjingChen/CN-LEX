    <lrml:FactualStatement key="review-draft_annotations-000695">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "card:g0579", "field": "distinguish", "annotation": {"text": "LEGO 卡片所称“补充责任优先于一般按份责任适用”“多个补充责任人依顺序承担”“相应责任与按份责任并列”等，均无本行条文依据，不予采纳；第177条的“相应的责任”即按份责任的分担结果", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
