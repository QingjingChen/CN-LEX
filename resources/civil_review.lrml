        <ruleml:then>
          <ruleml:And>
            <lrml:Permission key="c1234-2-ds-h0">
              <lrml:Paraphrase>侵权人在合理期限内未修复的，请求权人可以自行或者委托他人修复，所需费用由侵权人负担</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
