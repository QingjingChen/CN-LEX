    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1114-1k47">
      <lrml:Comment>收养人在被收养人成年以前不得解除收养关系，但收养人、送养人双方协议解除的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1114-1k47", "articles": ["1114"], "provenance": {"kind": "draft", "row_id": "card:g6847", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第1104条“双方自愿”写成收养合意 adoptionConsensusReached，作为收养成立的前提；同时把第1098条资格、可被收养并入成立条件，属形式化取舍；第1113条无效规则不在本行\n  · 起草者提示：八周岁以上被收养人未同意写成 -adoptionEstablished，并声明优先于成立规则\n  · 起草者提示：第1117条“成年养子女”以解除时是否成年判断\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1114-1k47">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adoptionEstablished"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:minor"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adopterAndPlacerAgreeToDissolve"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c1114-1k47-h0">
              <lrml:Paraphrase>收养人在被收养人成年以前不得解除收养关系，但收养人、送养人双方协议解除的除外</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:dissolveAdoption"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1114-8k47">
      <lrml:Comment>协议解除时养子女八周岁以上的，应当征得本人同意
