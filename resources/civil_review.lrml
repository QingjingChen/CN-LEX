            <ruleml:Var>G</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c842-2">
      <lrml:Comment>发生区段不能确定的，依照本章规定承担赔偿责任
