            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:mainSupportProvided"/>
            <ruleml:Var>H</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
