        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:liable"/>
            <ruleml:Var>S</ruleml:Var>
            <ruleml:Var>V</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1200">
      <lrml:Comment>限制民事行为能力人受到人身损害，教育机构未尽到教育、管理职责的，承担责任（过错责任，受害人举证）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1200", "articles": ["1200"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
