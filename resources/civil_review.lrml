            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:subleaseContractOf"/>
              <ruleml:Var>K2</ruleml:Var>
              <ruleml:Var>Sub</ruleml:Var>
              <ruleml:Var>Te</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:subleaseUnder"/>
