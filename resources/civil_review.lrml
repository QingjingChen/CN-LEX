    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1207-knew">
      <lrml:Comment>明知产品存在缺陷仍然生产、销售，造成他人死亡或者健康严重损害的，被侵权人有权请求相应的惩罚性赔偿
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1207-knew", "articles": ["1207"], "provenance": {"kind": "draft", "row_id": "card:g7473", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第1182条“损失或获利”写成选择性赔偿义务\n  · 起草者提示：第1207条拆为“明知缺陷仍生产销售”与“未采取有效补救措施”两条，主体未限定为生产者或销售者\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1207-knew">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:defectiveProduct"/>
              <ruleml:Var>Pr</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:damagedBy"/>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>Pr</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:producesOrSellsKnowingDefect"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>Pr</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:deathCaused"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seriousHealthDamage"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c1207-knew-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimPunitiveDamages"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1207-noremedy">
