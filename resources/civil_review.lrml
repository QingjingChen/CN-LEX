              <ruleml:Var>Claim</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtMatured"/>
              <ruleml:Var>Claim</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:nonSetOffByNature"/>
