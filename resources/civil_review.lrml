                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminateContract"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c711-comp">
      <lrml:Comment>同上情形，出租人可以请求承租人赔偿损失
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c711-comp", "articles": ["711"], "provenance": {"kind": "draft", "row_id": "art:711", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
