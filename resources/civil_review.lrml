        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:securedClaimsDetermined"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c420-in">
      <lrml:Comment>一定期间内连续发生的债权，在最高债权额限度内受担保
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c420-in", "articles": ["420"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
