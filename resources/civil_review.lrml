            <lrml:Obligation key="c587-perform-offset-ds-h0">
              <lrml:Paraphrase>债务人履行债务的，定金应当抵作价款或者收回（由收受定金方抵作价款或返还）</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>D</ruleml:Var>
