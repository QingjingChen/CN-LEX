    <lrml:PrescriptiveStatement key="c498-3-ds">
      <lrml:Comment>格式条款和非格式条款不一致的，应当采用非格式条款
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c498-3-ds", "articles": ["498"], "provenance": {"kind": "draft", "row_id": "art:498", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c498-3-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:standardTerm"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:nonStandardTerm"/>
              <ruleml:Var>N</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:inconsistentWith"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>N</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
