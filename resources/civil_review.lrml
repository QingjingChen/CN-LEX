                <lrml:Bearer/>
                <ruleml:Ind>court</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:grantDivorce"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c1079-spc1">
      <lrml:Comment>《最高人民法院关于适用〈中华人民共和国民法典〉婚姻家庭编的解释（一）》第1条：持续性、经常性的家庭暴力，可以认定为民法典第1042、1079、1091条所称的“虐待”
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1079-spc1", "articles": ["1079"], "provenance": {"kind": "draft", "row_id": "card:g6734", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“感情未破裂即使调解无效也不准离婚”为学理（出自笔记），由第1079条第3–5款压住；第3款第4、5项同时推出“感情确已破裂”\n  · 起草者提示：《婚姻家庭编解释（一）》条号按最高法官网摘要核对，未逐字核对原文；《婚姻家庭编解释（二）》（2025）未核对、未使用\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1079-spc1">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:persistentFrequentDomesticViolence"/>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:abuseOrDesertFamilyMember"/>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1079-spc2">
      <lrml:Comment>《最高人民法院关于适用〈中华人民共和国民法典〉婚姻家庭编的解释（一）》第2条：“与他人同居”是指有配偶者与婚外异性，不以夫妻名义，持续、稳定地共同居住
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1079-spc2", "articles": ["1079"], "provenance": {"kind": "draft", "row_id": "card:g6734", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“感情未破裂即使调解无效也不准离婚”为学理（出自笔记），由第1079条第3–5款压住；第3款第4、5项同时推出“感情确已破裂”\n  · 起草者提示：《婚姻家庭编解释（一）》条号按最高法官网摘要核对，未逐字核对原文；《婚姻家庭编解释（二）》（2025）未核对、未使用\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1079-spc2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:spouseOf"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>Y</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:livesWithExtramaritalPartnerStablyNotAsSpouses"/>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:cohabitingWithOther"/>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c1079-spc63">
      <lrml:Comment>《最高人民法院关于适用〈中华人民共和国民法典〉婚姻家庭编的解释（一）》第63条：符合第1079条第3款“应当准予离婚”情形的，不应当因当事人有过错而判决不准离婚
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1079-spc63", "articles": ["1079"], "provenance": {"kind": "draft", "row_id": "card:g6734", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“感情未破裂即使调解无效也不准离婚”为学理（出自笔记），由第1079条第3–5款压住；第3款第4、5项同时推出“感情确已破裂”\n  · 起草者提示：《婚姻家庭编解释（一）》条号按最高法官网摘要核对，未逐字核对原文；《婚姻家庭编解释（二）》（2025）未核对、未使用\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
