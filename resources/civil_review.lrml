              <ruleml:Rel iri="cnv:registrationApplied"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>U</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:needsFurtherProof"/>
              <ruleml:Var>U</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c212-suppg2305-h0">
              <lrml:Paraphrase>不动产有关情况需要进一步证明的，登记机构可以要求补充材料，必要时可以实地查看</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
