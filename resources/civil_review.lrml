              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>U</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:registeredRightHolder"/>
              <ruleml:Var>H</ruleml:Var>
              <ruleml:Var>U</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
