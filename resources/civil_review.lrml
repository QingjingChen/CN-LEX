              <ruleml:Var>K</ruleml:Var>
              <ruleml:Ind>quality</ruleml:Ind>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:standardExists"/>
                <ruleml:Var>K</ruleml:Var>
                <ruleml:Ind>mandatoryNational</ruleml:Ind>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:standardExists"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Ind>recommendedNational</ruleml:Ind>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
