    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-001997">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:334", "field": "distinguish", "annotation": {"text": "笔记把“维持土地的农业用途”列为土地承包经营权人的义务；第334条第1款本身未使用“义务”表述，只规定“未经依法批准，不得将承包地用于非农建设”，故该义务以 doctrine 规则呈现", "rules": ["c334-duty-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
