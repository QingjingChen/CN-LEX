      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1219", "field": "distinguish", "annotation": {"text": "因抢救生命垂危的患者等紧急情况不能取得患者或者其近亲属意见的，经医疗机构负责人或者授权的负责人批准可以立即实施相应医疗措施，属第1221条，不适用本条的同意要求", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-000864">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1219", "field": "distinguish", "annotation": {"text": "本条只规定医疗机构的赔偿责任，未规定免责事由；患者或者其近亲属不配合诊疗等免责事由规定在第1224条", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
