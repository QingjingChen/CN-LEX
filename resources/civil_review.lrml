            <lrml:Permission key="c1132-fail-h0">
              <lrml:Paraphrase>协商不成的，可以由人民调解委员会调解或者向人民法院提起诉讼</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>H</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seekPeoplesMediation"/>
                <ruleml:Var>H</ruleml:Var>
