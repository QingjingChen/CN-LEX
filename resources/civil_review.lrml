            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:needsRepresentationOrConsent"/>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c20-rep">
      <lrml:Comment>无民事行为能力人由其法定代理人代理实施民事法律行为
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c20-rep", "articles": ["20", "21"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c20-rep">
        <ruleml:if>
