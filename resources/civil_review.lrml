              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:deliverOrdinaryStandardQuality"/>
