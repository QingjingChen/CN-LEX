                <ruleml:Var>D</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:receiveBequestUnderAgreement"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
