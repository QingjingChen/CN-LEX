                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:friendOfBiologicalParents"/>
                <ruleml:Var>F</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c1107-1-ds-h0">
              <lrml:Paraphrase>孤儿或者生父母无力抚养的子女，可以由生父母的亲属、朋友抚养</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:raiseChild"/>
                <ruleml:Var>F</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
