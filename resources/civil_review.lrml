              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:signedOrSealedByKeeper"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:transfersCollectionRightTo"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
