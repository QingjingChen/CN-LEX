                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:giveNecessaryPreparationTime"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation key="c511-termprepg4164-h1">
              <lrml:Paraphrase>但是应当给对方必要的准备时间</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:giveNecessaryPreparationTime"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
