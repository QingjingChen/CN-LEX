    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-001896">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:263", "field": "distinguish", "annotation": {"text": "本条为城镇集体所有权及其权能的宣示性规定，未设具体行使程序与救济；集体所有权的行使、保护以及集体成员的相关权利，另依法律、行政法规及物权编其他规定处理", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
