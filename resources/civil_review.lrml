            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:preemptivePurchaseOfShare"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c305-exc5-ds">
      <lrml:Comment>学理（笔记、LEGO卡片）：因继承、遗赠取得份额不属于“转让”，不产生优先购买权
