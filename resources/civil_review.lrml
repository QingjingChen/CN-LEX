    <lrml:FactualStatement key="review-draft_annotations-001616">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:757", "field": "exceptions", "annotation": {"text": "当事人已明确约定归属，或者虽无约定、约定不明确但依第510条可以确定的，不适用“归出租人”的默认规则", "rules": ["c757-default-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
