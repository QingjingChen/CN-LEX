              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:jointMaritalDebt"/>
              <ruleml:Var>Z</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:propertyOfMarriage"/>
              <ruleml:Var>Z</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c1089-1-h0">
              <lrml:Paraphrase>离婚时，夫妻共同债务应当共同偿还</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:repayJointly"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>Z</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1089-agree">
      <lrml:Comment>共同财产不足清偿或者财产归各自所有的，由双方协议清偿
