              <ruleml:Rel iri="cnv:warehouseReceipt"/>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:storerOf"/>
