    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c956-1g5812">
      <lrml:Comment>卖出或买入具有市场定价的商品，除委托人有相反意思表示外，行纪人自己可以作为买受人或出卖人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c956-1g5812", "articles": ["956"], "provenance": {"kind": "draft", "row_id": "card:g5812", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第510条在本行只作为第955条第2款的引用条款，沿用 card:g4158 的写法另起 key\n  · 起草者提示：第959条留置权写作 lienRight(A,G,K)，“另有约定”用 ~lienExcludedByAgreement(G) 表达，沿用第449条以物为参数的用法\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c956-1g5812">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:commissionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:commissionAgentOf"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:commissionPrincipalOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:commissionGoodsOf"/>
              <ruleml:Var>G</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:marketPricedGoods"/>
              <ruleml:Var>G</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:contraryIntentionOfPrincipal"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c956-1g5812-h0">
              <lrml:Paraphrase>卖出或买入具有市场定价的商品，除委托人有相反意思表示外，行纪人自己可以作为买受人或出卖人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:actsAsBuyerOrSeller"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
