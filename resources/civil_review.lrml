              <ruleml:Rel iri="cnv:revocationGround"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:oneYearSinceKnewGround"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
