          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:actsOnlyThroughRepresentative"/>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c23">
      <lrml:Comment>无民事行为能力人、限制民事行为能力人的监护人是其法定代理人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c23", "articles": ["23"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c23">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:guardianOf"/>
              <ruleml:Var>G</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:noCapacity"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:limitedCapacity"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalRepresentative"/>
            <ruleml:Var>G</ruleml:Var>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c24-1">
      <lrml:Comment>利害关系人或者有关组织可以申请认定成年人为无或限制民事行为能力人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c24-1", "articles": ["24"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c24-1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adult"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:cannotDiscern"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:cannotFullyDiscern"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:interestedParty"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:And>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:concernsPerson"/>
                  <ruleml:Var>A</ruleml:Var>
                  <ruleml:Var>P</ruleml:Var>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:relevantOrg"/>
                  <ruleml:Var>A</ruleml:Var>
                </ruleml:Atom>
              </ruleml:And>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c24-1-h0">
              <lrml:Paraphrase>利害关系人或者有关组织可以申请认定成年人为无或限制民事行为能力人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:applyCapacityDeclaration"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c24-2">
      <lrml:Comment>经本人、利害关系人或者有关组织申请，人民法院可以认定其恢复为限制或完全民事行为能力人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c24-2", "articles": ["24"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c24-2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:declaredIncapable"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:capacityRecovered"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:appliedForRestoration"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:isSelf"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:interestedParty"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:relevantOrg"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c24-2-h0">
