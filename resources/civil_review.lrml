              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c356-doctrine-ds">
      <lrml:Comment>笔记（学理）：建设用地使用权人享有处分权，处分的客体是建设用地使用权而非土地本身，故本条不导致土地所有权变动
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c356-doctrine-ds", "articles": ["356"], "provenance": {"kind": "draft", "row_id": "art:356", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
