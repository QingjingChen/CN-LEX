            <ruleml:Atom>
              <ruleml:Rel iri="cnv:age16plus"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:ownLabourIncomeMainSource"/>
              <ruleml:Var>P</ruleml:Var>
