                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:actOf"/>
              <ruleml:Var>Act</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agentUnawareOfPrincipalEnd"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:successorRatifies"/>
