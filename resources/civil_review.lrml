              <ruleml:Rel iri="cnv:maxAmountMortgage"/>
              <ruleml:Var>M</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mortgage"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mortgageeOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtOf"/>
              <ruleml:Var>D</ruleml:Var>
