    <lrml:FactualStatement key="review-draft_annotations-000865">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1225", "field": "distinguish", "annotation": {"text": "第1222条（本行未挂载）就隐匿或拒绝提供、遗失、伪造、篡改、违法销毁病历资料规定过错推定，属举证责任规则；本条只规定填写、保管与提供义务，不涉及过错推定", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-000866">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1225", "field": "distinguish", "annotation": {"text": "第1226条（本行未挂载）规定医疗机构及其医务人员对患者隐私和个人信息的保密义务，与本条的病历资料提供义务并行，不因提供查阅、复制而免除", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
