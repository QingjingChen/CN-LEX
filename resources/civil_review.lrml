              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seizedOrDetainedByAuthority"/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:disputedOwnership"/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:violatesMandatoryUseConditions"/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leasedThingUnusable"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:unusableDueToTenant"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c724-h0">
              <lrml:Paraphrase>租赁物被司法机关或行政机关依法查封、扣押，权属有争议，或具有违反法律、行政法规关于使用条件的强制性规定情形，非因承租人原因致使租赁物无法使用的，承租人可以解除合同</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminateContract"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
