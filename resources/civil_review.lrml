                <lrml:Bearer/>
                <ruleml:Var>G</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestDissolutionOfAdoption"/>
                <ruleml:Var>G</ruleml:Var>
