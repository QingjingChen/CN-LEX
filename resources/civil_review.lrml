                <ruleml:Var>L</ruleml:Var>
                <ruleml:Ind>rentPaymentTime</ruleml:Ind>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
