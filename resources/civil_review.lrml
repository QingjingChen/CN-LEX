              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:realRightChangeEffective"/>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>R</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c229-performance-ds">
      <lrml:Comment>通说：给付判决基于债权请求权，须经登记或交付（执行）才发生物权变动，判决生效本身不引起物权变动
