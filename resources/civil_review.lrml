              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:preExistingClaim"/>
              <ruleml:Var>Z</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
