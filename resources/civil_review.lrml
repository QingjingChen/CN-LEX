              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:payPunitiveDamagesPerConsumerProtectionLaw"/>
