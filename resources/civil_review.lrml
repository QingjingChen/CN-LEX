              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c981-g5961nointerrupt">
      <lrml:Comment>中断管理对受益人不利的，无正当理由不得中断
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c981-g5961nointerrupt", "articles": ["981"], "provenance": {"kind": "draft", "row_id": "card:g5961", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记前后矛盾：一处说必要费用“一般以本人所受利益范围为限”，另一处说“即使受益人没有获益也要承担”。按第979条原文，真正无因管理的费用偿还不以受益人获益为要件，以获益范围为限的是第980条；已在 distinguish 中写明\n  · 起草者提示：“管理人无报酬请求权”“以自己名义负担的债务可请求本人直接清偿”两条写成学理规则\n  · 起草者提示：第980条“不属于前条规定的情形”只形式化为“违背受益人合法真实意思”这一种情形（谓词 gestorClaimsExcluded），可能比条文窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c981-g5961nointerrupt">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:negotiorumManagement"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:interruptionUnfavorableToBeneficiary"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:justifiedReason"/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c981-g5961nointerrupt-h0">
              <lrml:Paraphrase>中断管理对受益人不利的，无正当理由不得中断</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:interruptManagement"/>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c982-g5961notify">
      <lrml:Comment>能够通知受益人的，应当及时通知受益人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c982-g5961notify", "articles": ["982"], "provenance": {"kind": "draft", "row_id": "card:g5961", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记前后矛盾：一处说必要费用“一般以本人所受利益范围为限”，另一处说“即使受益人没有获益也要承担”。按第979条原文，真正无因管理的费用偿还不以受益人获益为要件，以获益范围为限的是第980条；已在 distinguish 中写明\n  · 起草者提示：“管理人无报酬请求权”“以自己名义负担的债务可请求本人直接清偿”两条写成学理规则\n  · 起草者提示：第980条“不属于前条规定的情形”只形式化为“违背受益人合法真实意思”这一种情形（谓词 gestorClaimsExcluded），可能比条文窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
