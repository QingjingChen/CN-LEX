            <ruleml:Rel iri="cnv:rentDeterminedByCostAndProfit"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
