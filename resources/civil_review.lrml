          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:priceDeterminedAs"/>
            <ruleml:Var>K</ruleml:Var>
            <ruleml:Ind>marketPriceAtPerformancePlaceOnConclusion</ruleml:Ind>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
