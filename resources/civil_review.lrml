              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:unqualifiedBlood"/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:causation"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:marketingAuthorizationHolder"/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:producer"/>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
