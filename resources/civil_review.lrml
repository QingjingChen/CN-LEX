              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c354-term-limit-ds-h0">
              <lrml:Paraphrase>但书：约定的使用期限不得超过建设用地使用权的剩余期限</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
