    <lrml:PrescriptiveStatement key="c570-1-ds">
      <lrml:Comment>因债权人无正当理由拒绝受领、下落不明、死亡未定继承人或遗产管理人、丧失行为能力未定监护人及法律规定的其他情形致难以履行的，债务人可以将标的物提存
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c570-1-ds", "articles": ["570"], "provenance": {"kind": "draft", "row_id": "card:g4667", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c570-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:creditorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:subjectMatterOf"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:creditorRefusesAcceptanceWithoutJustification"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:creditorWhereaboutsUnknown"/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
              <ruleml:And>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:dead"/>
                  <ruleml:Var>C</ruleml:Var>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:heirOrAdministratorUndetermined"/>
                  <ruleml:Var>C</ruleml:Var>
                </ruleml:Atom>
              </ruleml:And>
              <ruleml:And>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:incapableAdult"/>
                  <ruleml:Var>C</ruleml:Var>
                </ruleml:Atom>
