            <ruleml:Var>A</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c540-doctrine-nopriority-ds">
      <lrml:Comment>笔记：债权人撤销权无优先受偿效力，债权人就追回财产不享有优先受偿权
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c540-doctrine-nopriority-ds", "articles": ["540"], "provenance": {"kind": "draft", "row_id": "card:g4373", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c540-doctrine-nopriority-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:exercisesRevocation"/>
            <ruleml:Var>C</ruleml:Var>
            <ruleml:Var>A</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:priorityRightInRecoveredProperty"/>
