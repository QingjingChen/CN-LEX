              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>G</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:placeChildForAdoption"/>
                <ruleml:Var>G</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1096-1k47">
      <lrml:Comment>监护人送养孤儿的，应当征得有抚养义务的人同意
