                <ruleml:Var>D</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:assertNonexistenceAgainst"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:Atom>
