          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c765-1-ds">
      <lrml:Comment>债务人接到转让通知后，债权人与债务人无正当理由协商变更或者终止基础交易合同，对保理人产生不利影响的，对保理人不发生效力
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c765-1-ds", "articles": ["765"], "provenance": {"kind": "draft", "row_id": "card:g5423", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 3 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
