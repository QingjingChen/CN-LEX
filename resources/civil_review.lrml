        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c272-1-ds">
      <lrml:Comment>业主对其建筑物专有部分享有占有、使用、收益和处分的权利
