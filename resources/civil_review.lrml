                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c409-1d-ds-h0">
              <lrml:Paraphrase>抵押权的变更未经其他抵押权人书面同意的，不得对其他抵押权人产生不利影响</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:causeAdverseEffectTo"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c409-2-ds">
      <lrml:Comment>债务人以自己的财产设定抵押，抵押权人放弃该抵押权、抵押权顺位或者变更抵押权的，其他担保人在抵押权人丧失优先受偿权益的范围内免除担保责任；其他担保人承诺仍然提供担保的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c409-2-ds", "articles": ["409"], "provenance": {"kind": "draft", "row_id": "art:409", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c409-2-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mortgage"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtorOf"/>
