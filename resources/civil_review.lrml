              <ruleml:Rel iri="cnv:purchasePriceMortgage"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>M</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:registeredWithin10DaysOfDelivery"/>
