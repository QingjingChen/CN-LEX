        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c683-2-h0">
              <lrml:Paraphrase>以公益为目的的非营利法人、非法人组织不得为保证人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>G</ruleml:Var>
              </ruleml:slot>
