                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c714-keep">
      <lrml:Comment>承租人应当妥善保管租赁物
