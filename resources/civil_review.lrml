              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
