    <lrml:ConstitutiveStatement key="c730-1">
      <lrml:Comment>对租赁期限没有约定或约定不明确，依第510条仍不能确定的，视为不定期租赁（常量 leaseTerm 指租赁期限）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c730-1", "articles": ["730"], "provenance": {"kind": "draft", "row_id": "card:g5276", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第707条只在本行写成规则；707-2（视为不定期租赁）规则体未放“六个月以上”条件\n  · 起草者提示：第730条提前通知义务写给双方；第734条不在本行挂载法条内，未写\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c730-1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:unclearTerm"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Ind>leaseTerm</ruleml:Ind>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:notDeterminableUnderArt510"/>
              <ruleml:Ind>leaseTerm</ruleml:Ind>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:indefiniteLease"/>
            <ruleml:Var>L</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
