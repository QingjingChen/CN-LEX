    <lrml:ConstitutiveStatement key="c128-1-ds">
      <lrml:Comment>法律对未成年人、老年人、残疾人、妇女、消费者等的民事权利保护有特别规定的，就该主体的该民事权利依照特别规定处理
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c128-1-ds", "articles": ["128"], "provenance": {"kind": "draft", "row_id": "art:128", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c128-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:minor"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:elderly"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:disabledPerson"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:woman"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:consumer"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:otherProtectedSubject"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:specialProtectionProvisionExists"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:specialProtectionProvisionApplies"/>
