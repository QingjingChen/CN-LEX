                <ruleml:Var>K</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c757-agreed-ds">
      <lrml:Comment>当事人约定租赁期限届满租赁物归某方的，该方取得租赁物所有权（法条只写“可以约定”，约定之归属效果为学理归纳）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c757-agreed-ds", "articles": ["757"], "provenance": {"kind": "draft", "row_id": "art:757", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
