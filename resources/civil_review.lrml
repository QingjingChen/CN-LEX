              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:paidBeyondOwnShare"/>
              <ruleml:Var>G</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
