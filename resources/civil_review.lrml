"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第二编物权_第十四章居住权.json", "sha256": "610c50c41e659be503badde3354f458b1145755f090df2c0cc6459c9ea6bbb94"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第二编物权_第十章一般规定.json", "sha256": "c5a69d0326be7c71c4b3bb49ae9639eafd08cd4680279f1d6907818fb7687108"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第二编物权_第四章一般规定.json", "sha256": "4b6d48ce878ffa5cc3da9ddb2ec44def30611b835ef784f2387549a1d0753081"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第五编婚姻家庭_第一章一般规定.json", "sha256": "500e2574f8e59f2f9e3b9df6ee6fb4fe151c72b60e955e165576d3a48c8a1209"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第五编婚姻家庭_第二章结婚.json", "sha256": "fb49718308a0fefa88d1ee0cc8193e97dfadd1ffc667c13d562ff8c3fc098732"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第五编婚姻家庭_第五章收养.json", "sha256": "e990173945454f5011e233f8622f3c0b8a50a882fc7d793ece3d9fa4b3816d2c"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第六编继承_第一章一般规定.json", "sha256": "72bd433f3eb23d4b2104fb960892cf3f7b7edcff45585f6a7760a30a935dc7cb"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第四编人格权_第三章姓名权和名称权.json", "sha256": "bdcfd61ea45467388430f5875b55c8c42da701d9d5562894ed28aec60efbc7ea"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第四编人格权_第二章生命权、身体权和健康权.json", "sha256": "6cd057b77ed8f35de91bf8a43f975f437a73b4cbcb7491563247183ef2f34065"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第四编人格权_第五章名誉权和荣誉权.json", "sha256": "49ad1428100c24bca739b591cf31450b898e0576a5a173e6d6b2da6ce671f05c"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第四编人格权_第六章隐私权和个人信息保护.json", "sha256": "c523ebd8b21df038e228006b82ccf34090e70409d57a841d47aeda77899cd713"}, {"path": "LexReAct/graph/civil/codebook/drafts/deepseek-v4.1-flash-mb/第四编人格权_第四章肖像权.json", "sha256": 