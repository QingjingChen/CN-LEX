        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:setOffRight"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>Claim</ruleml:Var>
              <ruleml:Var>Debt</ruleml:Var>
