    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c487-exc-ds">
      <lrml:Comment>条文但书的反面推论：要约人及时通知受要约人因承诺超过期限不接受该承诺的，该迟到承诺不生效（学理上按新要约处理）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c487-exc-ds", "articles": ["487"], "provenance": {"kind": "draft", "row_id": "art:487", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c487-exc-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:offerorOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:notifiesRefusalOfLateAcceptance"/>
