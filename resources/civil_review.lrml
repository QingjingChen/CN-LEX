    <lrml:ConstitutiveStatement key="c703">
      <lrml:Comment>租赁合同是出租人将租赁物交付承租人使用、收益，承租人支付租金的合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c703", "articles": ["703"], "provenance": {"kind": "draft", "row_id": "card:g5260", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第728条赔偿规则沿用第726条的两项除外（按份共有人行使优先购买权、出卖给近亲属），原文没有，请确认\n  · 起草者提示：第704条为提示性条款未写规则；一房数租（房屋租赁解释第5条）不属挂载条文，未写\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c703">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:deliversThingForUseAndProfit"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:paysRentUnder"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
