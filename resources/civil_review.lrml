              <ruleml:Rel iri="cnv:actualPerformanceExceedsShare"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:jointDebtorOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
