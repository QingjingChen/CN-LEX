            <ruleml:Atom>
              <ruleml:Rel iri="cnv:workClientOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
