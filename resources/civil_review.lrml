              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agreedRealizationEventOccurred"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
