    <lrml:ConstitutiveStatement key="c22">
      <lrml:Comment>不能完全辨认自己行为的成年人为限制民事行为能力人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c22", "articles": ["22"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c22">
