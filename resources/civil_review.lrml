CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c560-1-ds", "articles": ["560"], "provenance": {"kind": "draft", "row_id": "card:g4649", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c560-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:multipleSameKindDebts"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
