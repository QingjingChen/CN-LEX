    <lrml:FactualStatement key="review-draft_annotations-001629">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:769", "field": "distinguish", "annotation": {"text": "本条是转介（参照适用）条款，本身不创设权利义务，只解决法律适用顺序；保理以应收账款转让为核心，故章内未规定事项回归债权转让规则", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-001630">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:768", "field": "priority", "annotation": {"text": "取得顺序为：已登记 ＞ 未登记但已通知 ＞ 既未登记也未通知；同一层次内，登记按登记时间先后，通知按到达债务人的先后，均无则按保理融资款或者服务报酬的比例。四项规则以互不重叠的条件分别表述，故不产生规则冲突", "rules": ["c768-1-ds", "c768-2-ds", "c768-3-ds", "c768-4-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
