            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seeksOnlyRescissionOfShareTransferContract"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seeksOnlyInvalidationOfShareTransferContract"/>
