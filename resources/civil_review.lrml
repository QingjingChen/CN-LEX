              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>F</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
