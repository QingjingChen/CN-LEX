        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adoptionQualified"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mayBeAdopted"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adoptionConsensusReached"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adoptionRegistered"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
