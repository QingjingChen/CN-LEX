        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c652-noticeg5041-h0">
              <lrml:Paraphrase>因供电设施计划检修、临时检修、依法限电或者用电人违法用电等原因需要中断供电时，应当按照国家有关规定事先通知用电人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
