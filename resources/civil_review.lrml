            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimedDiscretionaryShare"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
