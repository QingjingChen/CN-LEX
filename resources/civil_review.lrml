        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:liable"/>
            <ruleml:Var>M</ruleml:Var>
            <ruleml:Var>V</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c1203">
