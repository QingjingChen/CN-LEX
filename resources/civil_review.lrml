    <lrml:ConstitutiveStatement key="c41-1">
      <lrml:Comment>下落不明的时间自失去音讯之日起计算
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c41-1", "articles": ["41"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
