    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c42-2">
      <lrml:Comment>代管有争议的，由人民法院指定的人代管
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c42-2", "articles": ["42"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c42-2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:declaredMissing"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
