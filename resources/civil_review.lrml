              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:borrowerOf"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:interestDeductedFromPrincipalInAdvance"/>
              <ruleml:Var>K</ruleml:Var>
