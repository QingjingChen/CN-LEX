      <ruleml:Rule closure="universal" key=":c1131-spc41">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:eligibleForDiscretionaryShare"/>
              <ruleml:Var>P</ruleml:Var>
