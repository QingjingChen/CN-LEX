    <lrml:FactualStatement key="review-draft_annotations-001898">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:266", "field": "distinguish", "annotation": {"text": "本条是宣示性规定，只界定私人所有权的主体与客体范围，不设具体救济规则；所有权的权能见第240条，私人合法财产的保护（禁止侵占、哄抢、破坏）见第267条，与第260条以下集体所有权、第255条以下国家所有权并列", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-001899">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:266", "field": "distinguish", "annotation": {"text": "“私人”不限于自然人，还包括个体工商户、农村承包经营户以及法人、其他组织；此点法条未明写，属学理说明", "rules": ["c266-subject-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-001900">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:267", "field": "distinguish", "annotation": {"text": "本条是私人财产保护的宣示性、原则性规定，与第265条（集体成员权益）、第266条（集体所有）并列；财产被侵占、哄抢、破坏后的具体救济，适用物权保护方式（第233条至第238条）及侵权责任编的规定，本条本身不另行设定责任", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
