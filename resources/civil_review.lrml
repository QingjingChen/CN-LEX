            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:personalityRight"/>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
