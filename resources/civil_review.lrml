            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:delegatesSpecialServiceToThirdParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c941-1-h0">
              <lrml:Paraphrase>将部分专项服务事项委托给专业性服务组织或其他第三人的，应当就该部分向业主负责</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>owners</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:answerableToOwnersForDelegatedService"/>
