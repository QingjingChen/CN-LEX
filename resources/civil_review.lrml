      <ruleml:Rule closure="universal" key=":c747-exc-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:leasedThingNonConforming"/>
                <ruleml:Var>T</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:leasedThingUnfitForPurpose"/>
