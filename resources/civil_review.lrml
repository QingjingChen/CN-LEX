              <ruleml:Rel iri="cnv:excessNotDeposit"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositPayer"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositReceiver"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c586-excess-refund-ds-h0">
              <lrml:Paraphrase>学理与笔记：超过百分之二十的部分不产生定金效力，收受定金方应将该部分返还给付定金方</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:slot>
