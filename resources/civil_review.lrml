            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:raiseChild"/>
              <ruleml:Var>F</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
