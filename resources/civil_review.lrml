            <lrml:Obligation key="c498-3-ds-h0">
              <lrml:Paraphrase>格式条款和非格式条款不一致的，应当采用非格式条款</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>court</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adoptNonStandardTerm"/>
