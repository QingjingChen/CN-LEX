        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:marriageVoid"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
