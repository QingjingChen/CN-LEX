    <lrml:PrescriptiveStatement key="c968-g5870">
      <lrml:Comment>合伙人应当按照约定的出资方式、数额和缴付期限履行出资义务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c968-g5870", "articles": ["968"], "provenance": {"kind": "draft", "row_id": "card:g5870", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记中“一人不出资，其他合伙人不得因此拒绝出资”属学理内容，没有形式化，只写在 distinguish 里\n  · 起草者提示：第975条拆成禁止代位（FOR）和利益分配请求权可代位（PERM）两条，内容谓词不同，没有用优先关系\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c968-g5870">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:partnerOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:agreedContributionTerms"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c968-g5870-h0">
