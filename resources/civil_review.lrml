              <ruleml:Rel iri="cnv:toAvoidLossOf"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:managesAffairsFor"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:expensesIncurredFor"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
