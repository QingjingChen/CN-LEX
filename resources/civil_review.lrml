              <ruleml:Atom>
                <ruleml:Rel iri="cnv:unequalShareGround"/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:equalSharesAmongSameOrder"/>
