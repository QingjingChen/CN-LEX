    <lrml:ConstitutiveStatement key="c720">
      <lrml:Comment>在租赁期限内因占有、使用租赁物获得的收益，归承租人所有，但当事人另有约定的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c720", "articles": ["720"], "provenance": {"kind": "draft", "row_id": "art:720", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c720">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
