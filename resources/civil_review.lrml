    <lrml:FactualStatement key="review-draft_annotations-000868">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:1226", "field": "distinguish", "annotation": {"text": "本条针对医疗场景中的患者隐私与个人信息，与隐私权、个人信息保护的一般规定竞合时属特别规定（学理）", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
