              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:recourse"/>
                <ruleml:Var>G</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
