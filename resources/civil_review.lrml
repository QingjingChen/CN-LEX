              <ruleml:Rel iri="cnv:correctionApplied"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>U</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:holderConsentsCorrectionInWriting"/>
                <ruleml:Var>U</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:registerErrorProven"/>
                <ruleml:Var>U</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c220-correctg2305-h0">
