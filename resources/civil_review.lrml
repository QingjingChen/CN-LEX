              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agreedNoSetOff"/>
                <ruleml:Var>Debt</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:lawProhibitsSetOff"/>
