    <lrml:PrescriptiveStatement key="c30-wish">
      <lrml:Comment>协议确定监护人应当尊重被监护人的真实意愿
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c30-wish", "articles": ["30"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
