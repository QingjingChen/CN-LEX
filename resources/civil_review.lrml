              <ruleml:Var>Acc</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c552-1-ds">
      <lrml:Comment>第三人与债务人约定加入债务并通知债权人，债权人未在合理期限内明确拒绝的，债务加入成立
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c552-1-ds", "articles": ["552"], "provenance": {"kind": "draft", "row_id": "art:552", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c552-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartyAgreedToJoinDebt"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:notifiedCreditorOfJoinder"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:creditorRefusedInTime"/>
                <ruleml:Var>R</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:debtJoinderEstablished"/>
            <ruleml:Var>T</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>R</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c552-2-ds">
      <lrml:Comment>第三人向债权人表示愿意加入债务（该债务为债务人D所负），债权人未在合理期限内明确拒绝的，债务加入亦成立
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c552-2-ds", "articles": ["552"], "provenance": {"kind": "draft", "row_id": "art:552", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c552-2-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartyExpressedWillingnessToJoin"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtOf"/>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:creditorRefusedInTime"/>
                <ruleml:Var>R</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:debtJoinderEstablished"/>
            <ruleml:Var>T</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>R</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c552-3-ds">
      <lrml:Comment>债务加入成立后，债权人可以请求第三人在其愿意承担的债务范围内与债务人承担连带债务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c552-3-ds", "articles": ["552"], "provenance": {"kind": "draft", "row_id": "art:552", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c552-3-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:debtJoinderEstablished"/>
            <ruleml:Var>T</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>R</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c552-3-ds-h0">
              <lrml:Paraphrase>债务加入成立后，债权人可以请求第三人在其愿意承担的债务范围内与债务人承担连带债务</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimJointPerformanceFrom"/>
