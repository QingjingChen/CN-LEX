                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:exerciseEntrusteesRightAgainstThirdParty"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c926-2a-ds">
      <lrml:Comment>受托人因委托人的原因对第三人不履行义务的，应当向第三人披露委托人
