          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:maxAmountMortgage"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimArisesInPeriod"/>
              <ruleml:Var>Z</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:arisesAfterDetermination"/>
                <ruleml:Var>Z</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
