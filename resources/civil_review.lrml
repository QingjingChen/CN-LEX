    <lrml:FactualStatement key="review-draft_annotations-001992">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:330", "field": "distinguish", "annotation": {"text": "本条是制度性、原则性宣示，没有“应当/不得/可以”的规范表述，不直接产生请求权；土地承包经营权的设立、内容、期限、流转与保护由第331条以下规定", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
