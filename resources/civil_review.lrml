      <ruleml:Rule closure="universal" key=":c1060-restrict">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:spouseOf"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
