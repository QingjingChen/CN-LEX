                <ruleml:Var>L</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
