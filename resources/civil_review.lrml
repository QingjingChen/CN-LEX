            <ruleml:Atom>
              <ruleml:Rel iri="cnv:willOf"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:emergencyEnded"/>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:ableToMakeWrittenOrAVWill"/>
