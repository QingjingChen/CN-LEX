              <lrml:Paraphrase>试用买卖的买受人在试用期内可以购买标的物，也可以拒绝购买</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:purchaseTrialThing"/>
