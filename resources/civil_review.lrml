    <lrml:FactualStatement key="review-draft_annotations-001257">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:864", "field": "distinguish", "annotation": {"text": "本条只设“可以约定范围”的授权与“不得限制技术竞争和技术发展”的禁止；约定构成非法垄断技术、妨碍技术进步的，其无效后果由第850条规定，本行未挂载该条，故不在此形式化", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
