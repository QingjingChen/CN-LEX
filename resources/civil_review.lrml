            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1070">
      <lrml:Comment>父母和子女有相互继承遗产的权利
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1070", "articles": ["1070"], "provenance": {"kind": "draft", "row_id": "art:1070", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
