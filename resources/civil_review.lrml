      <ruleml:Rule closure="universal" key=":c829">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:shipperOf"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:carrierOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:goodsDeliveredToConsignee"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c829-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestStopReturnRedirectOrChangeConsignee"/>
                <ruleml:Var>S</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c829-comp">
      <lrml:Comment>托运人行使上述权利的，应当赔偿承运人因此受到的损失
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c829-comp", "articles": ["829"], "provenance": {"kind": "draft", "row_id": "card:g5543", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第838条用 carrierOf(O,K) 作为多式联运经营人的构成性结论，会让多式联运经营人适用所有以 carrierOf 为条件的客运、货运规则，范围可能偏宽\n  · 起草者提示：第839条“区段约定不影响经营人全程义务”写成不以有无约定为条件、直接课以全程责任，没有单独写排除规则\n  · 起草者提示：第824条第1款的承运人过错沿用通用谓词 fault(C,K)\n  · 起草者提示：第810条强制缔约的相对人没有区分旅客和托运人\n  · 起草者提示：第832条免责事由写成“承运人证明原因 + 三类原因择一”，举证责任只用 carrierProvesCauseOfGoodsLoss 表达\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c829-comp">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:shipperOf"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:carrierOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:shipperRequestedChangeUnderArt829"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:carrierLossFromChange"/>
