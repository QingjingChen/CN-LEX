              <ruleml:Var>H</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:homesteadRightTransferred"/>
              <ruleml:Var>H</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
