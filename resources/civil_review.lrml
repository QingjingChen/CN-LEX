      <ruleml:Rule closure="universal" key=":c662-1a-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:giftContract"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:giftPropertyDefective"/>
