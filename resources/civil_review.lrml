    <lrml:PrescriptiveStatement key="c18-act">
      <lrml:Comment>完全民事行为能力人可以独立实施民事法律行为
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c18-act", "articles": ["18"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
