              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:revocationGround"/>
            <ruleml:Var>C</ruleml:Var>
            <ruleml:Var>A</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c539-ground-ds">
      <lrml:Comment>有偿处分情形：明显不合理低价转让、明显不合理高价受让、为他人债务提供担保，影响债权实现且相对人知道或应当知道该情形的，构成撤销事由
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c539-ground-ds", "articles": ["539"], "provenance": {"kind": "draft", "row_id": "card:g4373", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c539-ground-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtRelation"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:actOf"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
