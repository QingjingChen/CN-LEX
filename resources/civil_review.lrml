            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c435-g3436waive-h0">
              <lrml:Paraphrase>质权人可以放弃质权</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waivePledge"/>
                <ruleml:Var>R</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c435-g3436release">
      <lrml:Comment>债务人以自己的财产出质，质权人放弃该质权的，其他担保人在质权人丧失优先受偿权益的范围内免除担保责任，但其他担保人承诺仍然提供担保的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c435-g3436release", "articles": ["435"], "provenance": {"kind": "draft", "row_id": "card:g3436", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第432、433条及第436条第1款已由 card:g3440 形式化，本行没有重复\n  · 起草者提示：第435条“丧失优先受偿权益范围内免责”用了新谓词 releasedWithinLostPledgePriority，因为已有的 releasedFromSecurityLiability 释义写的是“抵押权人”；沿用了 promisedToStillProvideSecurity(O,D)，其第二个参数按释义应为“债务”，这里传入的是债务人变量，与 card:g3440 的写法一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c435-g3436release">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:pledgeOf"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtorProvidedPledge"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:waivedPledge"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:otherSecurityProviderForDebt"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:promisedToStillProvideSecurity"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:releasedWithinLostPledgePriority"/>
            <ruleml:Var>O</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c434-g3436repledge">
      <lrml:Comment>质权人在质权存续期间，未经出质人同意转质，造成质押财产毁损、灭失的，应当承担赔偿责任
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c434-g3436repledge", "articles": ["434"], "provenance": {"kind": "draft", "row_id": "card:g3436", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第432、433条及第436条第1款已由 card:g3440 形式化，本行没有重复\n  · 起草者提示：第435条“丧失优先受偿权益范围内免责”用了新谓词 releasedWithinLostPledgePriority，因为已有的 releasedFromSecurityLiability 释义写的是“抵押权人”；沿用了 promisedToStillProvideSecurity(O,D)，其第二个参数按释义应为“债务”，这里传入的是债务人变量，与 card:g3440 的写法一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c434-g3436repledge">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:pledgeOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:pledgeRightSubsisting"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:repledgedWithoutPledgorConsent"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:pledgedPropertyDamagedOrLost"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c434-g3436repledge-h0">
              <lrml:Paraphrase>质权人在质权存续期间，未经出质人同意转质，造成质押财产毁损、灭失的，应当承担赔偿责任</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:compensatePledgorForLoss"/>
                <ruleml:Var>R</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1072-1">
