        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c423-after">
      <lrml:Comment>债权确定后发生的债权不再受最高额抵押担保
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c423-after", "articles": ["423"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c423-after">
        <ruleml:if>
          <ruleml:And>
