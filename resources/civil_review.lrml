              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositReceiver"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
