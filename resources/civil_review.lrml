              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:divorceJudgmentOrMediationEffective"/>
              <ruleml:Var>A</ruleml:Var>
