        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c692-fix">
      <lrml:Comment>保证期间是确定保证人承担保证责任的期间，不发生中止、中断和延长
