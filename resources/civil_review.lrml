              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:possessionSeizedBy"/>
              <ruleml:Var>Q</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
