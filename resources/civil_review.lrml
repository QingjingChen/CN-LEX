              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:sueToConfirmOrDenyParentage"/>
                <ruleml:Var>P</ruleml:Var>
