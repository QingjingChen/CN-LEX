          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c-void-not-valid">
      <lrml:Comment>无效行为不是有效行为
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c-void-not-valid", "articles": ["155"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
