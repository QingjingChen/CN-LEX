            <ruleml:Atom>
              <ruleml:Rel iri="cnv:propertyOfMarriage"/>
              <ruleml:Var>Z</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
