          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1170-excl">
      <lrml:Comment>学理：能确定具体侵权人的，其余危险行为人不依共同危险行为承担连带责任（由第1170条“由侵权人承担责任”推出）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1170-excl", "articles": ["1170"], "provenance": {"kind": "draft", "row_id": "card:g7513", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：c1170-excl（能确定具体侵权人时其余危险行为人不负连带责任）标为学理；c1169-1 用 ~noCapacity/~limitedCapacity 把行为能力欠缺交给第2款\n  · 起草者提示：引用的《侵权责任编解释（一）》（法释〔2024〕12号）条文是转述，未逐字核对，请对照原文\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1170-excl">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:endangeringActParticipant"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:damage"/>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:identifiedTortfeasor"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:otherThan"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tortJointLiability"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1170-unknown">
      <lrml:Comment>不能确定具体侵权人的，实施危险行为的行为人承担连带责任
