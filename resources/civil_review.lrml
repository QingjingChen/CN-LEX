          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c670-g5149deduct">
      <lrml:Comment>借款的利息不得预先在本金中扣除
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c670-g5149deduct", "articles": ["670"], "provenance": {"kind": "draft", "row_id": "card:g5149", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第674条中利息支付期限无约定或约定不明时的补充规则、第668条书面形式，已由 card:g5151 和 card:g5155 形式化，本行没有重复\n  · 起草者提示：自然人借款利息约定不明的规则同时推出 -interestDeterminedByUsageOrMarketRate，并声明优先于一般的“按交易习惯、市场利率确定”规则\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c670-g5149deduct">
        <ruleml:if>
          <ruleml:And>
