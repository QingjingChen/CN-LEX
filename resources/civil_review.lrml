        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:custodianCandidate"/>
            <ruleml:Var>K</ruleml:Var>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c42-flag">
