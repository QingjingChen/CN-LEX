            <ruleml:Atom>
              <ruleml:Rel iri="cnv:workContractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:workClientOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:completesWorkPerRequirement"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:deliversWorkResult"/>
