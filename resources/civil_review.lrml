          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtorsTwoOrMore"/>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:creditorMayDemandFullPerformanceFromAny"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:jointDebts"/>
            <ruleml:Var>Ds</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c518-2-ds">
      <lrml:Comment>连带债权或者连带债务，由法律规定或者当事人约定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c518-2-ds", "articles": ["518"], "provenance": {"kind": "draft", "row_id": "art:518", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c518-2-ds">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lawProvidesJointRelation"/>
              <ruleml:Var>Cs</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:partiesAgreedJointRelation"/>
              <ruleml:Var>Cs</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:jointRightsAndDebts"/>
            <ruleml:Var>Cs</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c518-2-defeat-ds">
      <lrml:Comment>仅有“部分或者全部债权人均可请求履行”的外观而无法律规定或当事人约定的，不成立连带债权；此为学理对第2款“不得推定”的解读
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c518-2-defeat-ds", "articles": ["518"], "provenance": {"kind": "draft", "row_id": "art:518", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c518-2-defeat-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:creditorsTwoOrMore"/>
              <ruleml:Var>Cs</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:anyCreditorMayDemandPerformance"/>
              <ruleml:Var>Cs</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:jointRightsAndDebts"/>
                <ruleml:Var>Cs</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:jointCreditorRights"/>
              <ruleml:Var>Cs</ruleml:Var>
