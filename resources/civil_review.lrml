              <lrml:Paraphrase>但书：技术转让合同、技术许可合同不得限制技术竞争和技术发展</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>parties</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:restrictTechnologicalCompetitionOrDevelopment"/>
