    <lrml:ConstitutiveStatement key="c13">
      <lrml:Comment>自然人从出生时起到死亡时止，具有民事权利能力
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c13", "articles": ["13"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c13">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:naturalPerson"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:born"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:dead"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalCapacity"/>
            <ruleml:Var>P</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c15-cert">
      <lrml:Comment>出生、死亡时间以出生证明、死亡证明记载的时间为准
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c15-cert", "articles": ["15"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c15-cert">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:recordedInCertificate"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:rebuttedByEvidence"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:eventTime"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>E</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c15-cert-flag">
      <lrml:Comment>有出生证明或死亡证明（辅助）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c15-cert-flag", "articles": ["15"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c15-cert-flag">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:recordedInCertificate"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>E</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:hasCertificate"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>E</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c15-reg">
      <lrml:Comment>没有出生证明、死亡证明的，以户籍登记或者其他有效身份登记记载的时间为准
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c15-reg", "articles": ["15"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c15-reg">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:recordedInRegistration"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:hasCertificate"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:rebuttedByEvidence"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:eventTime"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>E</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c15-proof">
      <lrml:Comment>有其他证据足以推翻以上记载时间的，以该证据证明的时间为准
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c15-proof", "articles": ["15"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c15-proof">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:provenByOtherEvidence"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>E</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:eventTime"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:rebuttedByEvidence"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c16">
      <lrml:Comment>涉及遗产继承、接受赠与等胎儿利益保护的，胎儿视为具有民事权利能力
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c16", "articles": ["16"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c16">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:fetus"/>
              <ruleml:Var>F</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:fetalInheritanceInterest"/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:fetalGiftInterest"/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:otherFetalInterest"/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:stillborn"/>
                <ruleml:Var>F</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:deemedLegalCapacity"/>
            <ruleml:Var>F</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c16-still">
