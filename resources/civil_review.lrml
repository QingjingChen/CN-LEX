          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Permission key="c688-2-h0">
              <lrml:Paraphrase>连带责任保证的债务人不履行到期债务或者发生当事人约定的情形时，债权人可以请求债务人履行债务，也可以请求保证人在其保证范围内承担保证责任</lrml:Paraphrase>
              <ruleml:slot>
