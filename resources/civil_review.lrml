        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:changeMortgageRankOrAmount"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:otherMortgagee"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:writtenConsentByOtherMortgagee"/>
