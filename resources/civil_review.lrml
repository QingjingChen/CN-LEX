              <ruleml:Rel iri="cnv:concealedTruth"/>
              <ruleml:Var>Y</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:acquiredByDeathDeclaration"/>
              <ruleml:Var>Y</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
