              <ruleml:Rel iri="cnv:adoptionDissolved"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:dissolvedForAdultAdopteeAbuse"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c1118-2k47-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimRaisingCostCompensation"/>
                <ruleml:Var>A</ruleml:Var>
