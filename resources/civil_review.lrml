              <lrml:Paraphrase>能够通知受益人的，应当及时通知受益人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:notifyBeneficiaryInTime"/>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c982-g5961wait">
      <lrml:Comment>管理的事务不需要紧急处理的，应当等待受益人的指示
