              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>registry</ruleml:Ind>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:correctRegister"/>
