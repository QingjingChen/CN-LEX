              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mediationFailed"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c1079-spc63-h0">
              <lrml:Paraphrase>《最高人民法院关于适用〈中华人民共和国民法典〉婚姻家庭编的解释（一）》第63条：符合第1079条第3款“应当准予离婚”情形的，不应当因当事人有过错而判决不准离婚</lrml:Paraphrase>
