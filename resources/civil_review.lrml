              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c218-queryg2305">
      <lrml:Comment>权利人、利害关系人可以申请查询、复制不动产登记资料
