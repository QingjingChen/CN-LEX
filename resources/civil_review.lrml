            <ruleml:Atom>
              <ruleml:Rel iri="cnv:unpaid"/>
              <ruleml:Var>Z</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lawfullyPossesses"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:movable"/>
