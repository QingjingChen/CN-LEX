                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>U</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:registryInterestedParty"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>U</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:believesRegisterWrong"/>
