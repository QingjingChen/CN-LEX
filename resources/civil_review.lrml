    <lrml:FactualStatement key="review-draft_annotations-000701">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:185", "field": "distinguish", "annotation": {"text": "笔记把本条列为“英雄烈士特别保护的民事责任”，属民事责任分类中的特别规定；本条只解决责任成立，不规定责任方式", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
