              <ruleml:Atom>
                <ruleml:Rel iri="cnv:noChildren"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:onlyOneChild"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:hasRaisingAbility"/>
