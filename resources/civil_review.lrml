              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c708-fit-h0">
              <lrml:Paraphrase>出租人应当在租赁期限内保持租赁物符合约定的用途</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:keepFitForAgreedUseDuringTerm"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c713-request">
      <lrml:Comment>承租人在租赁物需要维修时可以请求出租人在合理期限内维修
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c713-request", "articles": ["713"], "provenance": {"kind": "draft", "row_id": "card:g5284", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：override c713-2 &gt; c712-duty 按“出租人＋合同”整体否定维修义务，未细化到每次维修\n  · 起草者提示：第713条“相应减少租金或者延长租期”原文未写义务主体，草稿写为出租人的义务\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c713-request">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:needsRepair"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordBearsRepairDuty"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c713-request-h0">
              <lrml:Paraphrase>承租人在租赁物需要维修时可以请求出租人在合理期限内维修</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestRepairInReasonableTime"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c713-self">
      <lrml:Comment>出租人未履行维修义务的，承租人可以自行维修
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c713-self", "articles": ["713"], "provenance": {"kind": "draft", "row_id": "card:g5284", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：override c713-2 &gt; c712-duty 按“出租人＋合同”整体否定维修义务，未细化到每次维修\n  · 起草者提示：第713条“相应减少租金或者延长租期”原文未写义务主体，草稿写为出租人的义务\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c713-self">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
