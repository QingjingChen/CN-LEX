        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:supportBequestAgreement"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
