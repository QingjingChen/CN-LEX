              <ruleml:Rel iri="cnv:age8plus"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c1114-8k47-h0">
              <lrml:Paraphrase>协议解除时养子女八周岁以上的，应当征得本人同意</lrml:Paraphrase>
              <ruleml:slot>
