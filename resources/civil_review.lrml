                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:revoked"/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:nonFaultParty"/>
              <ruleml:Var>N</ruleml:Var>
              <ruleml:Var>M</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c1054-damages-ds-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>N</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimDamagesForInvalidMarriage"/>
                <ruleml:Var>N</ruleml:Var>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
