      <ruleml:Rule closure="universal" key=":c535-2b-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:subrogateInOwnName"/>
            <ruleml:Var>C</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c535-2b-ds-h0">
              <lrml:Paraphrase>债权人行使代位权的必要费用由债务人负担（笔记补充：诉讼费最终由相对人负担，律师费等由债务人负担）</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:bearNecessaryExpensesOfSubrogation"/>
