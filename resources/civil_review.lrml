              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>H</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:compensatePossessionLoss"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>H</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c462-returng3605">
      <lrml:Comment>占有的不动产或者动产被侵占的，占有人有权请求返还原物
