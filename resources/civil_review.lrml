              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:notifyRightHolderToCollect"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
