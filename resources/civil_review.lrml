      <ruleml:Rule closure="universal" key=":c983-g5961transfer">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:negotiorumManagement"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:obtainedPropertyInManagement"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c983-g5961transfer-h0">
              <lrml:Paraphrase>管理人管理事务取得的财产（包括孳息），应当及时转交给受益人</lrml:Paraphrase>
