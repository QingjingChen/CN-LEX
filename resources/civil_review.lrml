                <ruleml:Rel iri="cnv:applyForRegistration"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c335-2-ds">
      <lrml:Comment>土地承包经营权互换、转让未经登记的，不得对抗善意第三人（登记对抗主义）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c335-2-ds", "articles": ["335"], "provenance": {"kind": "draft", "row_id": "card:g2356", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c335-2-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:exchangeOrTransferOfLandContractRight"/>
