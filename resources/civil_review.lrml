    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1057-2">
      <lrml:Comment>一方不得对另一方参加生产、工作、学习和社会活动加以限制或者干涉
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1057-2", "articles": ["1057"], "provenance": {"kind": "draft", "row_id": "art:1057", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1057-2">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:spouseOf"/>
            <ruleml:Var>A</ruleml:Var>
            <ruleml:Var>B</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c1057-2-h0">
              <lrml:Paraphrase>一方不得对另一方参加生产、工作、学习和社会活动加以限制或者干涉</lrml:Paraphrase>
