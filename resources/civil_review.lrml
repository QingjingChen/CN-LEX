              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:dilatoryInExercising"/>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c535-affect-ds">
      <lrml:Comment>笔记：债务人除对相对人的债权外，其他财产不足以清偿对债权人的债务，即影响债权人债权的实现
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c535-affect-ds", "articles": ["535"], "provenance": {"kind": "draft", "row_id": "card:g4342", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c535-affect-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtRelation"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimRightOf"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:insufficientOtherAssets"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:affectsRealizationOfClaim"/>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>C</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c535-exclusive-ds">
      <lrml:Comment>笔记：专属于债务人自身的权利包括身份关系产生的给付请求权、劳动报酬等基于劳动关系的请求权、人寿保险金请求权、人身伤害赔偿请求权
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c535-exclusive-ds", "articles": ["535"], "provenance": {"kind": "draft", "row_id": "card:g4342", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c535-exclusive-ds">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:identityBasedClaim"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:laborBasedClaim"/>
