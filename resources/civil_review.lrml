                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:acquiresAtUnreasonablyHighPrice"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:providesSecurityForOthersDebt"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:affectsClaimRealization"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
