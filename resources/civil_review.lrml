      <ruleml:Rule closure="universal" key=":c786-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:coContractor"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
