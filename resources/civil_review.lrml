            <ruleml:Var>B</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c356-1-ds">
      <lrml:Comment>建设用地使用权转让、互换、出资或者赠与的，附着于该土地上的建筑物、构筑物及其附属设施应当一并处分
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c356-1-ds", "articles": ["356"], "provenance": {"kind": "draft", "row_id": "art:356", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c356-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionLandUseRight"/>
              <ruleml:Var>R</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
