    <lrml:ConstitutiveStatement key="c57-1-ds">
      <lrml:Comment>定义性条款：法人是具有民事权利能力和民事行为能力、依法独立享有民事权利和承担民事义务的组织
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c57-1-ds", "articles": ["57"], "provenance": {"kind": "draft", "row_id": "card:g1220", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c57-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:organization"/>
              <ruleml:Var>O</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:independentlyEnjoysCivilRightsAndBearsObligations"/>
