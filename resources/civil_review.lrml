    <lrml:FactualStatement key="review-draft_annotations-001901">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:267", "field": "distinguish", "annotation": {"text": "本条保护对象限于“合法财产”，违法取得的财产不在保护范围；此限制来自条文“合法”二字，笔记与 LEGO 卡片均未涉及", "rules": []}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
