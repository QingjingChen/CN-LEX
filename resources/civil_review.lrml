        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c94-2-ds-h0">
              <lrml:Paraphrase>决定程序违反法律、行政法规、法人章程，或者决定内容违反法人章程的，捐助人等利害关系人或者主管机关可以请求人民法院撤销该决定</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>I</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestCourtRevokeDecision"/>
                <ruleml:Var>I</ruleml:Var>
                <ruleml:Var>Dec</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c94-revoke-ds">
      <lrml:Comment>决定经人民法院撤销后失去效力（条文仅规定“可以请求撤销”，失效效果为学理推论）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c94-revoke-ds", "articles": ["94"], "provenance": {"kind": "draft", "row_id": "card:g1117", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c94-revoke-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:decisionRevoked"/>
            <ruleml:Var>Dec</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:valid"/>
              <ruleml:Var>Dec</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c94-goodfaith-ds">
      <lrml:Comment>捐助法人依据该决定与善意相对人形成的民事法律关系不受撤销影响
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c94-goodfaith-ds", "articles": ["94"], "provenance": {"kind": "draft", "row_id": "card:g1117", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c94-goodfaith-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:decisionRevoked"/>
              <ruleml:Var>Dec</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:relationFormedUnderDecision"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>Dec</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:goodFaithCounterparty"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalRelationUnaffected"/>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>C</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
