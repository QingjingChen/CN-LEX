            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noAdverseCriminalRecord"/>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
