            <ruleml:Atom>
              <ruleml:Rel iri="cnv:witnessOf"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:noCapacity"/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:limitedCapacity"/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:lacksWitnessingAbility"/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:heirCandidate"/>
                <ruleml:Var>X</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:legateeOf"/>
                <ruleml:Var>X</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:interestedInHeirOrLegatee"/>
                <ruleml:Var>X</ruleml:Var>
                <ruleml:Var>W</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:ineligibleWitness"/>
            <ruleml:Var>X</ruleml:Var>
            <ruleml:Var>W</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1140-spc24">
      <lrml:Comment>继承编解释（一）第24条：继承人、受遗赠人的债权人、债务人，共同经营的合伙人，也应当视为与继承人、受遗赠人有利害关系，不能作为遗嘱见证人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1140-spc24", "articles": ["1140"], "provenance": {"kind": "draft", "row_id": "card:g7149", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第1142条第2、3款已有基础规则 c1142-2/-3，本行只写第1款；打印、口头遗嘱形式不合格无效为学理\n  · 起草者提示：第1141条必留份用 bearer=D 的义务表达；继承编解释第25条“按遗嘱生效时情况认定”只写在 note\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
