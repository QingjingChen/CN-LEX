            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:organizationOrIndividual"/>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c991-h0">
              <lrml:Paraphrase>民事主体的人格权受法律保护，任何组织或者个人不得侵害</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:infringePersonalityRightOf"/>
                <ruleml:Var>X</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c1001-1">
      <lrml:Comment>对自然人因婚姻家庭关系等产生的身份权利的保护，适用本法第一编、第五编和其他法律的相关规定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1001-1", "articles": ["1001"], "provenance": {"kind": "draft", "row_id": "art:1001", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“没有规定”写成例外谓词 ~noProvisionForIdentityRight，参照适用单列 c1001-2（PERM court），另加 analogyCompatibleByNature 对应“根据其性质”\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1001-1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:naturalPerson"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
