            <ruleml:Atom>
              <ruleml:Rel iri="cnv:harmsPrincipalRights"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
