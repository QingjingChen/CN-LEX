              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:discoveredAfterDivorce"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:concealsOrDissipatesCommunityProperty"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:forgesJointDebtToSeize"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c1092-2-h0">
              <lrml:Paraphrase>离婚后，另一方发现有上述行为的，可以向人民法院提起诉讼，请求再次分割夫妻共同财产</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
