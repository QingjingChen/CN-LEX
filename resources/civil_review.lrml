              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:personalInjuryClaim"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:exclusiveToDebtor"/>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c535-suit-ds">
      <lrml:Comment>笔记：代位权的行使必须通过诉讼方式进行，不能直接向相对人主张
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c535-suit-ds", "articles": ["535"], "provenance": {"kind": "draft", "row_id": "card:g4342", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c535-suit-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:subrogateInOwnName"/>
            <ruleml:Var>C</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c535-suit-ds-h0">
              <lrml:Paraphrase>笔记：代位权的行使必须通过诉讼方式进行，不能直接向相对人主张</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:exerciseSubrogationBySuit"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c535-2a-ds">
      <lrml:Comment>代位权的行使范围以债权人的到期债权为限
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c535-2a-ds", "articles": ["535"], "provenance": {"kind": "draft", "row_id": "card:g4342", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c535-2a-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:subrogateInOwnName"/>
            <ruleml:Var>C</ruleml:Var>
            <ruleml:Var>D</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
