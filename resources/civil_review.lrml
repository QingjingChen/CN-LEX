          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:portraitLicenseContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:disputedClauseMeaning"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:portraitRightHolder"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c1021-ds-h0">
              <lrml:Paraphrase>对肖像许可使用合同中肖像使用条款的理解有争议的，应当作出有利于肖像权人的解释</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>court</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:interpretInFavorOfPortraitHolder"/>
                <ruleml:Var>K</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1022-1-ds">
      <lrml:Comment>对肖像许可使用期限没有约定或者约定不明确的，任何一方当事人可以随时解除合同
