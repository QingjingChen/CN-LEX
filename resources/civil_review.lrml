            <ruleml:Atom>
              <ruleml:Rel iri="cnv:formatClause"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:providerOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:unreasonablyExemptsOrReducesLiability"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:aggravatesCounterpartyLiability"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:restrictsCounterpartyMainRight"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:unreasonableTerm"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c538-ground-ds">
      <lrml:Comment>无偿处分情形：放弃债权、放弃债权担保、无偿转让财产、其他无偿处分财产权益，或恶意延长到期债权履行期限，影响债权实现的，构成撤销事由
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c538-ground-ds", "articles": ["538"], "provenance": {"kind": "draft", "row_id": "card:g4373", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c538-ground-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtRelation"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:actOf"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waivesClaim"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waivesClaimSecurity"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:gratuitouslyTransfersProperty"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:otherwiseGratuitouslyDisposes"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:maliciouslyExtendsDueClaim"/>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
