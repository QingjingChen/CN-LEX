              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:payInterest"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c680-g5149usury">
      <lrml:Comment>禁止高利放贷，借款的利率不得违反国家有关规定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c680-g5149usury", "articles": ["680"], "provenance": {"kind": "draft", "row_id": "card:g5149", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第674条中利息支付期限无约定或约定不明时的补充规则、第668条书面形式，已由 card:g5151 和 card:g5155 形式化，本行没有重复\n  · 起草者提示：自然人借款利息约定不明的规则同时推出 -interestDeterminedByUsageOrMarketRate，并声明优先于一般的“按交易习惯、市场利率确定”规则\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c680-g5149usury">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:loanContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lenderOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Prohibition key="c680-g5149usury-h0">
              <lrml:Paraphrase>禁止高利放贷，借款的利率不得违反国家有关规定</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:engageInUsuriousLending"/>
                <ruleml:Var>L</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
            <lrml:Prohibition key="c680-g5149usury-h1">
              <lrml:Paraphrase>禁止高利放贷，借款的利率不得违反国家有关规定</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:slot>
