            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:securedClaim"/>
            <ruleml:Var>Z</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c420-pre">
      <lrml:Comment>设立前已存在的债权，经当事人同意可以转入最高额抵押担保范围
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c420-pre", "articles": ["420"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c420-pre">
        <ruleml:if>
