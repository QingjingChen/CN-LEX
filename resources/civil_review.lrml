    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-002000">
      <lrml:Comment>CNLR_REVIEW_META:{"kind": "draft_annotations", "record": {"row_id": "art:332", "field": "distinguish", "annotation": {"text": "笔记将土地承包经营权定性为“有期限的物权”；第332条第1款规定各类土地的承包期，第2款规定期限届满后由土地承包经营权人依照农村土地承包的法律规定继续承包，故期限届满并不当然导致该权利消灭", "rules": ["c332-2b-ds"]}, "model": "deepseek-v4.1-flash-mb", "review_status": "pending_expert_review", "retrieval_use": "annotation_only; no edge inferred from free text"}}</lrml:Comment>
    </lrml:FactualStatement>
    <lrml:FactualStatement key="review-draft_annotations-002001">
