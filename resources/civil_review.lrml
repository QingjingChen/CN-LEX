              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartyFailsToPerform"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartyBreachHarmsPrincipal"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:contractProvidesOtherwise"/>
