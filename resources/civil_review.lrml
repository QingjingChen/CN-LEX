            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalPerson"/>
            <ruleml:Var>O</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c57-2-ds">
      <lrml:Comment>笔记学理：法人应具备独立承担民事责任的能力，独立责任使法人与其成员人格分离，并区别于非法人组织
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c57-2-ds", "articles": ["57"], "provenance": {"kind": "draft", "row_id": "card:g1025", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c57-2-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalPerson"/>
            <ruleml:Var>L</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:independentlyBearsCivilLiability"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:personalitySeparateFromMembers"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c57-3-ds">
      <lrml:Comment>笔记学理：法人与自然人统称法律上的“人”，法人作为民事主体可以自己的名义参与民事活动
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c57-3-ds", "articles": ["57"], "provenance": {"kind": "draft", "row_id": "card:g1025", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c57-3-ds">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:legalPerson"/>
            <ruleml:Var>L</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:civilSubject"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <lrml:Permission key="c57-3-ds-h1">
