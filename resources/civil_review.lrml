            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leasedThingDamagedOrLost"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:causeNotAttributableToTenant"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c729-rent-h0">
              <lrml:Paraphrase>因不可归责于承租人的事由致租赁物部分或全部毁损、灭失的，承租人可以请求减少租金或者不支付租金</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestRentReductionOrExemption"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c729-term">
      <lrml:Comment>因租赁物部分或全部毁损、灭失致使不能实现合同目的的，承租人可以解除合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c729-term", "articles": ["729"], "provenance": {"kind": "draft", "row_id": "art:729", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：后半句（不能实现合同目的可以解除）未加“不可归责于承租人”的限定，请确认\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c729-term">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leasedThingDamagedOrLost"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lossFrustratesLeasePurpose"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c729-term-h0">
              <lrml:Paraphrase>因租赁物部分或全部毁损、灭失致使不能实现合同目的的，承租人可以解除合同</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminateContract"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c710">
      <lrml:Comment>承租人按照约定的方法或者根据租赁物的性质使用租赁物，致使租赁物受到损耗的，不承担赔偿责任
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c710", "articles": ["710"], "provenance": {"kind": "draft", "row_id": "art:710", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c710">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:usedPerAgreedMethod"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:usedPerNature"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:wearFromUse"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantLiableForWear"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c725-spc14">
      <lrml:Comment>《最高人民法院关于审理城镇房屋租赁合同纠纷案件具体应用法律若干问题的解释》（法释〔2009〕11号，2020年修正）第14条：租赁房屋在承租人按照租赁合同占有期限内发生所有权变动，承租人请求受让人继续履行原租赁合同的应予支持，但房屋在出租前已设立抵押权、因抵押权人实现抵押权发生所有权变动的，房屋在出租前已被人民法院依法查封的，或者当事人另有约定的除外。条文经最高法公报检索摘要核对，未逐字核对全文
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c725-spc14", "articles": ["725"], "provenance": {"kind": "draft", "row_id": "card:g2034", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：新增 c725-spc14（限房屋租赁）覆盖 c725：先设抵押并因实现抵押权致所有权变动、出租前已被查封、另有约定\n  · 起草者提示：《城镇房屋租赁合同解释》第14条只与搜索摘要对上，官方页面未能打开，未逐字核对全文\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c725-spc14">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:houseLease"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantPossessesUnderLease"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:ownershipChanged"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:And>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:mortgagedBeforeLease"/>
                  <ruleml:Var>T</ruleml:Var>
                  <ruleml:Var>L</ruleml:Var>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="cnv:ownershipChangedByMortgageRealization"/>
                  <ruleml:Var>T</ruleml:Var>
                </ruleml:Atom>
              </ruleml:And>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:seizedByCourtBeforeLease"/>
                <ruleml:Var>T</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agreedOtherwiseOnLeaseSurvival"/>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseBindsNewOwner"/>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c731">
      <lrml:Comment>租赁物危及承租人安全或健康的，即使承租人订立合同时明知该租赁物质量不合格，承租人仍然可以随时解除合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c731", "articles": ["731"], "provenance": {"kind": "draft", "row_id": "art:731", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“即使明知质量不合格”只在自然语言版本说明，规则未设例外\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c731">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:endangersTenantSafetyOrHealth"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>Te</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c731-h0">
              <lrml:Paraphrase>租赁物危及承租人安全或健康的，即使承租人订立合同时明知该租赁物质量不合格，承租人仍然可以随时解除合同</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminateContractAtAnyTime"/>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c708-deliver">
      <lrml:Comment>出租人应当按照约定将租赁物交付承租人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c708-deliver", "articles": ["708"], "provenance": {"kind": "draft", "row_id": "card:g5284", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：override c713-2 &gt; c712-duty 按“出租人＋合同”整体否定维修义务，未细化到每次维修\n  · 起草者提示：第713条“相应减少租金或者延长租期”原文未写义务主体，草稿写为出租人的义务\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c708-deliver">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:leaseOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:landlordOf"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:tenantOf"/>
              <ruleml:Var>Te</ruleml:Var>
              <ruleml:Var>L</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c708-deliver-h0">
              <lrml:Paraphrase>出租人应当按照约定将租赁物交付承租人</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>Te</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:deliverLeasedThingAsAgreed"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>Te</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c708-fit">
      <lrml:Comment>出租人应当在租赁期限内保持租赁物符合约定的用途
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c708-fit", "articles": ["708"], "provenance": {"kind": "draft", "row_id": "card:g5284", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：override c713-2 &gt; c712-duty 按“出租人＋合同”整体否定维修义务，未细化到每次维修\n  · 起草者提示：第713条“相应减少租金或者延长租期”原文未写义务主体，草稿写为出租人的义务\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
