      <ruleml:Rule closure="universal" key=":c174-g1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:entrustedAgentOf"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:died"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:inPrincipalName"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agentUnawareOfDeath"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:heirsRecognize"/>
