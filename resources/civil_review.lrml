              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:livingDifficultyAtDivorce"/>
              <ruleml:Var>A</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:ableToBear"/>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
