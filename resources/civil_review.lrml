              <lrml:Paraphrase>人格权不得放弃、转让或者继承</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waivePersonalityRight"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>R</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
            <lrml:Prohibition key="c992-h1">
              <lrml:Paraphrase>人格权不得放弃、转让或者继承</lrml:Paraphrase>
              <ruleml:slot>
