              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waivePriorityRank"/>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:changeMortgageRankOrAmount"/>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>D</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartySecurityFor"/>
              <ruleml:Var>G</ruleml:Var>
