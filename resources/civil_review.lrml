            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:possessedThingDamagedOrLost"/>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:rightHolderOfThing"/>
              <ruleml:Var>H</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:possessionDamagesClaimed"/>
              <ruleml:Var>H</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lossNotFullyCompensated"/>
