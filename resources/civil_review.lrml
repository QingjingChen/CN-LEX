              <ruleml:Rel iri="cnv:commissionPrincipalOf"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:sellsBelowDesignatedPrice"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:buysAboveDesignatedPrice"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Neg>
              <ruleml:Atom>
