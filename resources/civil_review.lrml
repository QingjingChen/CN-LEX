    <lrml:ConstitutiveStatement key="c518-2-defeat-debt-ds">
      <lrml:Comment>仅有“可请求部分或者全部债务人履行全部债务”的外观而无法律规定或当事人约定的，不成立连带债务；此为学理对第2款“不得推定”的解读
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c518-2-defeat-debt-ds", "articles": ["518"], "provenance": {"kind": "draft", "row_id": "art:518", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c518-2-defeat-debt-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtorsTwoOrMore"/>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:creditorMayDemandFullPerformanceFromAny"/>
              <ruleml:Var>R</ruleml:Var>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:jointRightsAndDebts"/>
                <ruleml:Var>Ds</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:jointDebts"/>
              <ruleml:Var>Ds</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c520-1-ds">
