            <ruleml:Var>A</ruleml:Var>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c320-exc-ds">
