        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c943-h0">
              <lrml:Paraphrase>定期公开服务事项、负责人员、收费、维修资金使用、共有部分经营收益等，并向业主大会、业主委员会报告</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>owners</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:discloseAndReportServiceInfoPeriodically"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c944-1">
      <lrml:Comment>业主应当按照约定向物业服务人支付物业费
