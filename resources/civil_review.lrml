              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lenderOf"/>
              <ruleml:Var>L</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c670-g5149deduct-h0">
              <lrml:Paraphrase>借款的利息不得预先在本金中扣除</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>L</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
