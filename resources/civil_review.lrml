    <lrml:ConstitutiveStatement key="c1054-1-ds">
      <lrml:Comment>无效或者被撤销的婚姻自始没有法律约束力，当事人不具有夫妻的权利和义务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1054-1-ds", "articles": ["1054"], "provenance": {"kind": "draft", "row_id": "card:g6488", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n⚠ 重点核对：第 2 次才通过程序检查\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1054-1-ds">
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:marriageVoid"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:marriageRevoked"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:marriageEstablished"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:spouseOf"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:spouseOf"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c1054-2-ds">
