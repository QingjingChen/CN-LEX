          <lrml:SuborderList>
            <lrml:Obligation key="c169-3-ds-h0">
              <lrml:Paraphrase>转委托未经同意或追认的，代理人对转委托第三人的行为承担责任；紧急情况下为维护被代理人利益而转委托的除外</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:bearLiabilityForSubAgentActs"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
