        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c784-keepg5444">
      <lrml:Comment>承揽人应当妥善保管定作人提供的材料以及完成的工作成果
