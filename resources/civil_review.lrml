                <ruleml:Var>M</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimCompensationFrom"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>M</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1223-2-ds">
      <lrml:Comment>同一情形下患者也可以向医疗机构请求赔偿，形成不真正连带责任
