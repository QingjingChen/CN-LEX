    <lrml:ConstitutiveStatement key="c1090-hardship">
      <lrml:Comment>学理（专家笔记“离婚时的经济帮助”，源自已废止的原《婚姻法解释（一）》第27条，民法典时代无对应现行司法解释条文，存疑）：依靠个人财产和离婚时分得的财产无法维持当地基本生活水平，或离婚后没有住处的，属于生活困难；离婚后才发生的困难不予帮助
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1090-hardship", "articles": ["1090"], "provenance": {"kind": "draft", "row_id": "card:g6809", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“生活困难”的定义出自笔记，来源为已废止的原《婚姻法解释（一）》第27条，标学理并注“存疑”\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1090-hardship">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:spouseOf"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:atDivorce"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:cannotMaintainLocalBasicLiving"/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
