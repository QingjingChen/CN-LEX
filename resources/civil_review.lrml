      <ruleml:Rule closure="universal" key=":c638-choose">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:sale"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:trialSale"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
