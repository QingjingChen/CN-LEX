              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c807-spc41">
      <lrml:Comment>法释〔2020〕25号第41条：承包人应当在合理期限内行使建设工程价款优先受偿权，但最长不得超过十八个月，自发包人应当给付建设工程价款之日起算（已逐字核对；超期丧失为通说理解）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c807-spc41", "articles": ["807"], "provenance": {"kind": "draft", "row_id": "card:g5525", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记两处过时：优先受偿权期限“竣工之日起六个月”已按施工合同解释（一）第41条改为“合理期限、最长十八个月、自应付款之日起算”；装饰装修但书已按第37条改为“具备折价或者拍卖条件”\n  · 起草者提示：三条反面推论待复核：c807-qual（质量不合格不享有优先受偿权，学理）、c807-spc41（超期丧失）、c807-spc42（未损害工人利益的放弃约定可对抗承包人）；《商品房消费者权利保护批复》未逐字核对，只写在区分栏\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c807-spc41">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:projectOf"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:priorityNotExercisedInTime"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionPricePriority"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c807-spc42">
      <lrml:Comment>法释〔2020〕25号第42条：约定放弃或者限制优先受偿权，损害建筑工人利益，发包人据此主张承包人不享有优先受偿权的，人民法院不予支持（已逐字核对）；未损害建筑工人利益的放弃约定可对抗承包人系该条反面推论
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c807-spc42", "articles": ["807"], "provenance": {"kind": "draft", "row_id": "card:g5525", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记两处过时：优先受偿权期限“竣工之日起六个月”已按施工合同解释（一）第41条改为“合理期限、最长十八个月、自应付款之日起算”；装饰装修但书已按第37条改为“具备折价或者拍卖条件”\n  · 起草者提示：三条反面推论待复核：c807-qual（质量不合格不享有优先受偿权，学理）、c807-spc41（超期丧失）、c807-spc42（未损害工人利益的放弃约定可对抗承包人）；《商品房消费者权利保护批复》未逐字核对，只写在区分栏\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c807-spc42">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:projectOf"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:priorityWaiverOrLimitAgreed"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:waiverHarmsConstructionWorkers"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>W</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionPricePriority"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c808">
      <lrml:Comment>本章没有规定的，适用承揽合同的有关规定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c808", "articles": ["808"], "provenance": {"kind": "draft", "row_id": "card:g5525", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记两处过时：优先受偿权期限“竣工之日起六个月”已按施工合同解释（一）第41条改为“合理期限、最长十八个月、自应付款之日起算”；装饰装修但书已按第37条改为“具备折价或者拍卖条件”\n  · 起草者提示：三条反面推论待复核：c807-qual（质量不合格不享有优先受偿权，学理）、c807-spc41（超期丧失）、c807-spc42（未损害工人利益的放弃约定可对抗承包人）；《商品房消费者权利保护批复》未逐字核对，只写在区分栏\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c808">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:matterOfConstructionContract"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:constructionChapterProvidesOn"/>
                <ruleml:Var>M</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:applyWorkContractRules"/>
            <ruleml:Var>M</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c788-1">
      <lrml:Comment>建设工程合同是承包人进行工程建设，发包人支付价款的合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c788-1", "articles": ["788"], "provenance": {"kind": "draft", "row_id": "art:788", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c788-1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:undertakesProjectConstruction"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:paysPriceForProject"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c788-2">
      <lrml:Comment>建设工程合同包括工程勘察、设计、施工合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c788-2", "articles": ["788"], "provenance": {"kind": "draft", "row_id": "art:788", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c788-2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:surveyContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:designContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:constructionWorkContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:constructionContract"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c789">
      <lrml:Comment>建设工程合同应当采用书面形式
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c789", "articles": ["789"], "provenance": {"kind": "draft", "row_id": "art:789", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c789">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:constructionContract"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:writtenFormRequired"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <lrml:Obligation key="c789-h1">
              <lrml:Paraphrase>建设工程合同应当采用书面形式</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>parties</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adoptWrittenForm"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c802">
      <lrml:Comment>因承包人的原因致使建设工程在合理使用期限内造成人身损害和财产损失的，承包人应当承担赔偿责任
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c802", "articles": ["802"], "provenance": {"kind": "draft", "row_id": "art:802", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：受害人用变量 V，未限定为合同相对方；请确认与第1252条的关系\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c802">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:projectOf"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:projectDamageWithinReasonableUseLife"/>
              <ruleml:Var>W</ruleml:Var>
              <ruleml:Var>V</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:attributableToContractor"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>W</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c802-h0">
              <lrml:Paraphrase>因承包人的原因致使建设工程在合理使用期限内造成人身损害和财产损失的，承包人应当承担赔偿责任</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:compensateLoss"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c798-1">
      <lrml:Comment>隐蔽工程在隐蔽以前，承包人应当通知发包人检查
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c798-1", "articles": ["798"], "provenance": {"kind": "draft", "row_id": "art:798", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c798-1">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:concealedWorkOf"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:concealed"/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c798-1-h0">
              <lrml:Paraphrase>隐蔽工程在隐蔽以前，承包人应当通知发包人检查</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:notifyEmployerToInspect"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c798-2">
      <lrml:Comment>发包人没有及时检查的，承包人可以顺延工程日期，并有权请求赔偿停工、窝工等损失
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c798-2", "articles": ["798"], "provenance": {"kind": "draft", "row_id": "art:798", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c798-2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:concealedWorkOf"/>
              <ruleml:Var>X</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:notifiedEmployerToInspect"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerFailedToInspectTimely"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Permission key="c798-2-h0">
              <lrml:Paraphrase>发包人没有及时检查的，承包人可以顺延工程日期，并有权请求赔偿停工、窝工等损失</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:extendConstructionPeriod"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
            <lrml:Right key="c798-2-h1">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimStoppageAndIdleLosses"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c805">
      <lrml:Comment>因发包人变更计划，提供的资料不准确，或者未按照期限提供必需的勘察、设计工作条件而造成勘察、设计的返工、停工或者修改设计，发包人应当按照勘察人、设计人实际消耗的工作量增付费用
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c805", "articles": ["805"], "provenance": {"kind": "draft", "row_id": "art:805", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：勘察人、设计人未单独建谓词，直接用 contractorOf(S,K)\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c805">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:surveyContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:designContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:employerChangedPlan"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:employerProvidedInaccurateData"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:employerFailedToProvideSurveyDesignConditionsInTime"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:causedSurveyDesignReworkStoppageOrRedesign"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c805-h0">
              <lrml:Paraphrase>因发包人变更计划，提供的资料不准确，或者未按照期限提供必需的勘察、设计工作条件而造成勘察、设计的返工、停工或者修改设计，发包人应当按照勘察人、设计人实际消耗的工作量增付费用</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:payAdditionalFeeByActualWorkload"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>S</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c804">
      <lrml:Comment>因发包人的原因致使工程中途停建、缓建的，发包人应当采取措施弥补或者减少损失，赔偿承包人因此造成的停工、窝工、倒运、机械设备调迁、材料和构件积压等损失和实际费用
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c804", "articles": ["804"], "provenance": {"kind": "draft", "row_id": "art:804", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c804">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:constructionContract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractorOf"/>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:employerOf"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:suspendedOrPostponedByEmployer"/>
              <ruleml:Var>E</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation key="c804-h0">
              <lrml:Paraphrase>因发包人的原因致使工程中途停建、缓建的，发包人应当采取措施弥补或者减少损失，赔偿承包人因此造成的停工、窝工、倒运、机械设备调迁、材料和构件积压等损失和实际费用</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:takeMeasuresToReduceLoss"/>
                <ruleml:Var>E</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation key="c804-h1">
              <lrml:Paraphrase>因发包人的原因致使工程中途停建、缓建的，发包人应当采取措施弥补或者减少损失，赔偿承包人因此造成的停工、窝工、倒运、机械设备调迁、材料和构件积压等损失和实际费用</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>E</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
