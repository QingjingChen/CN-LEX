          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c527-2">
      <lrml:Comment>没有确切证据中止履行的，应当承担违约责任
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c527-2", "articles": ["527"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c527-2">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mutualDebts"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:suspendsPerformance"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:conclusiveEvidence"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:liableForBreach"/>
            <ruleml:Var>A</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c528-notify">
      <lrml:Comment>依法中止履行的，应当及时通知对方
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c528-notify", "articles": ["528"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c528-notify">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:insecurityDefense"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:suspendsPerformance"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c528-notify-h0">
              <lrml:Paraphrase>依法中止履行的，应当及时通知对方</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:notifyCounterparty"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c528-resume">
      <lrml:Comment>对方提供适当担保的，应当恢复履行
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c528-resume", "articles": ["528"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c528-resume">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mutualDebts"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:performsFirst"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:conclusiveEvidence"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:adequateSecurityProvided"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:insecurityDefense"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c528-term">
      <lrml:Comment>对方在合理期限内未恢复履行能力且未提供适当担保的，可以解除合同并请求违约责任
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c528-term", "articles": ["528"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c528-term">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:insecurityDefense"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mutualDebts"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noRecoveryWithinReasonableTime"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adequateSecurityProvided"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liableForBreach"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c585-reduce">
      <lrml:Comment>约定的违约金过分高于造成的损失的，可以根据当事人的请求予以适当减少
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c585-reduce", "articles": ["585"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c585-reduce">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liquidatedDamages"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:excessivelyHigherThanLoss"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:partyRequestsAdjustment"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:courtMayReduceLD"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c585-increase">
      <lrml:Comment>约定的违约金低于造成的损失的，可以根据当事人的请求予以增加
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c585-increase", "articles": ["585"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c585-increase">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liquidatedDamages"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lowerThanLoss"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:partyRequestsAdjustment"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:courtMayIncreaseLD"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c585-3">
      <lrml:Comment>就迟延履行约定违约金的，违约方支付违约金后，还应当履行债务
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c585-3", "articles": ["585"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c585-3">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liquidatedDamagesForDelay"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:breachingParty"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:paidLD"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c585-3-h0">
              <lrml:Paraphrase>就迟延履行约定违约金的，违约方支付违约金后，还应当履行债务</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:stillPerform"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c586">
      <lrml:Comment>定金合同自实际交付定金时成立（实践合同）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c586", "articles": ["586"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c586">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositAgreed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositActuallyPaid"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:depositContractFormed"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c586-cap">
      <lrml:Comment>定金不得超过主合同标的额的百分之二十，超过部分不产生定金的效力
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c586-cap", "articles": ["586"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c586-cap">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositContractFormed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:exceeds20PercentOfSubject"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:excessNotDeposit"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c587-payer">
      <lrml:Comment>给付定金的一方根本违约的，无权请求返还定金
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c587-payer", "articles": ["587"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c587-payer">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositContractFormed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositPayer"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:breachFrustratesPurpose"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositRefundClaim"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c587-receiver">
      <lrml:Comment>收受定金的一方根本违约的，应当双倍返还定金
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c587-receiver", "articles": ["587"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c587-receiver">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositContractFormed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositReceiver"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositPayer"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:breachFrustratesPurpose"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c587-receiver-h0">
              <lrml:Paraphrase>收受定金的一方根本违约的，应当双倍返还定金</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:returnDoubleDeposit"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c588-choice">
      <lrml:Comment>既约定违约金又约定定金的，对方可以选择适用违约金或者定金条款
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c588-choice", "articles": ["588"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c588-choice">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liquidatedDamages"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositContractFormed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:nonBreachingParty"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c588-choice-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:chooseLDOrDeposit"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c588-nocumul">
      <lrml:Comment>违约金与定金不能并用（第588条“选择适用”）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c588-nocumul", "articles": ["588"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c588-nocumul">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liquidatedDamages"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:depositContractFormed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:nonBreachingParty"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Prohibition key="c588-nocumul-h0">
              <lrml:Paraphrase>违约金与定金不能并用（第588条“选择适用”）</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimBothLDAndDeposit"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Prohibition>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c545">
      <lrml:Comment>债权人可以将债权转让给第三人（性质、约定、法律不得转让的除外）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c545", "articles": ["545"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c545">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimAssigned"/>
              <ruleml:Var>Z</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>Y</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:nonAssignableByNature"/>
                <ruleml:Var>Z</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:nonAssignableByLaw"/>
                <ruleml:Var>Z</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:agreedNonAssignable"/>
                <ruleml:Var>Z</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:assignmentEffective"/>
            <ruleml:Var>Z</ruleml:Var>
            <ruleml:Var>Y</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c545-2-money">
      <lrml:Comment>约定金钱债权不得转让的，不得对抗第三人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c545-2-money", "articles": ["545"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c545-2-money">
        <ruleml:if>
          <ruleml:And>
