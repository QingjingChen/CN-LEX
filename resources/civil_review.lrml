            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractObligorTo"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation key="c511-termprepg4164-h0">
              <lrml:Paraphrase>但是应当给对方必要的准备时间</lrml:Paraphrase>
