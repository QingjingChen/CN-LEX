              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:age8plus"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:adopteeConsented"/>
