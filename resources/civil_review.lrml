    <lrml:ConstitutiveStatement key="c925-1-ds">
      <lrml:Comment>受托人以自己名义在授权范围内与第三人订立合同，第三人订约时知道受托人与委托人之间代理关系的，该合同直接约束委托人和第三人；有确切证据证明合同只约束受托人和第三人的除外
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c925-1-ds", "articles": ["925"], "provenance": {"kind": "draft", "row_id": "art:925", "model": "deepseek-v4.1-flash-mb", "risk_notes": "⚠ 由 deepseek-v4.1-flash-mb 起草，已通过程序检查（法条、语法、编译、XSD），待专家逐条核对\n⚠ 单版本（DeepSeek），未经双模型核对：重点看是否加入法条没有的内容、但书与例外是否遗漏、适用范围是否被改宽或改窄\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c925-1-ds">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:concludesInOwnNameWithinAuthority"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:thirdPartyKnewAgencyAtConclusion"/>
              <ruleml:Var>T</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:conclusiveEvidenceOnlyBindsAgentAndThirdParty"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>T</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:bindsPrincipalAndThirdParty"/>
            <ruleml:Var>K</ruleml:Var>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>T</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
