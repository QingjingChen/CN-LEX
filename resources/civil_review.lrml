            </ruleml:Naf>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:fullCapacity"/>
              <ruleml:Var>P</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:limitedCapacity"/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c19">
      <lrml:Comment>八周岁以上的未成年人为限制民事行为能力人
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c19", "articles": ["19"], "provenance": {"kind": "existing_formal_rule"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c19">
        <ruleml:if>
