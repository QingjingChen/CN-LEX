              <ruleml:Var>G</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtItemOf"/>
              <ruleml:Var>X</ruleml:Var>
