              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:sealSample"/>
                <ruleml:Var>S</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation key="c635-sample-h1">
              <lrml:Paraphrase>凭样品买卖的当事人应当封存样品；出卖人交付的标的物应当与样品及其说明的质量相同</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:sealSample"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation key="c635-sample-h2">
              <lrml:Paraphrase>凭样品买卖的当事人应当封存样品；出卖人交付的标的物应当与样品及其说明的质量相同</lrml:Paraphrase>
              <ruleml:slot>
