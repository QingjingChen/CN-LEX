            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1187-sec">
      <lrml:Comment>分期支付的，被侵权人有权请求提供相应的担保
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1187-sec", "articles": ["1187"], "provenance": {"kind": "draft", "row_id": "art:1187", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1187-sec">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:liable"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:paymentMethodNegotiationFailed"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:lumpSumGenuinelyDifficult"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>X</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c1187-sec-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestSecurityForInstallments"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c996">
      <lrml:Comment>因当事人一方的违约行为，损害对方人格权并造成严重精神损害，受损害方选择请求其承担违约责任的，不影响受损害方请求精神损害赔偿
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c996", "articles": ["996"], "provenance": {"kind": "draft", "row_id": "card:g7489", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c996">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:breachHarmsPersonalityRight"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:seriousMentalDamage"/>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:electedBreachLiability"/>
              <ruleml:Var>V</ruleml:Var>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c996-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimMentalDamageCompensation"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c1180">
      <lrml:Comment>因同一侵权行为造成多人死亡的，可以以相同数额确定死亡赔偿金
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c1180", "articles": ["1180"], "provenance": {"kind": "draft", "row_id": "art:1180", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c1180">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:sameTortCausesMultipleDeaths"/>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c1180-h0">
              <lrml:Paraphrase>因同一侵权行为造成多人死亡的，可以以相同数额确定死亡赔偿金</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Ind>court</ruleml:Ind>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:determineDeathCompensationEqually"/>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c562-mutual">
      <lrml:Comment>当事人协商一致，可以解除合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c562-mutual", "articles": ["562"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c562-mutual">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:mutualTerminationAgreed"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c562-mutual-h0">
              <lrml:Paraphrase>当事人协商一致，可以解除合同</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminateContract"/>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c562-agreedright">
      <lrml:Comment>当事人约定一方解除合同的事由，事由发生时，解除权人可以解除合同
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c562-agreedright", "articles": ["562"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c562-agreedright">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:agreedUnilateralTerminationGround"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:agreedTerminationGroundOccurred"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:terminationRight"/>
            <ruleml:Var>P</ruleml:Var>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c562-invalidclause">
      <lrml:Comment>笔记：约定解除条款须不违反法律强制性规范和公序良俗，否则不产生约定解除权（学理归纳）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c562-invalidclause", "articles": ["562"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c562-invalidclause">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:agreedUnilateralTerminationGround"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationClauseViolatesMandatoryOrPublicOrder"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c564-agreedperiod">
      <lrml:Comment>法律规定或者当事人约定解除权行使期限，期限届满不行使的，该权利消灭
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c564-agreedperiod", "articles": ["564"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c564-agreedperiod">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationPeriodSet"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationPeriodExpiredUnexercised"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c564-noperiod">
      <lrml:Comment>无规定或约定期限的，自知道或应当知道解除事由之日起一年内不行使，或经对方催告后在合理期限内不行使的，解除权消灭
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c564-noperiod", "articles": ["564"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c564-noperiod">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Naf>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminationPeriodSet"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Naf>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminationUnexercisedOneYearAfterKnowing"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:terminationUnexercisedAfterDemand"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Neg>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Neg>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c557-rescinded">
      <lrml:Comment>合同解除的，该合同的权利义务关系终止
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c557-rescinded", "articles": ["557"], "provenance": {"kind": "draft", "row_id": "card:g4593", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：“解除权条款违反强制性规定或公序良俗则不产生约定解除权”这条（c562-invalidclause）按笔记写成学理规则，并设为优先于约定解除权；请确认这样处理是否合适\n  · 起草者提示：本行同时形式化了第564条，与 card:g4624 中第564条的规则内容重复，只是 key 不同\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c557-rescinded">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contract"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationEffective"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:contractTerminated"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c565-notifyduty">
      <lrml:Comment>当事人一方依法主张解除合同的，应当通知对方
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c565-notifyduty", "articles": ["565"], "provenance": {"kind": "draft", "row_id": "card:g4624", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记说未约定异议期的须在解除通知到达之日起三个月内起诉。这一规则出自原《合同法解释（二）》第24条，该解释已随民法典施行废止，所以没有形式化，只在 distinguish 中说明，请确认\n  · 起草者提示：通知解除、自动解除、诉讼解除三条规则的规则体都加了 terminationRight(P,K)（即须“依法”享有解除权），比 card:g4589 中第565条的写法更严，两行不一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c565-notifyduty">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimsTermination"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c565-notifyduty-h0">
              <lrml:Paraphrase>当事人一方依法主张解除合同的，应当通知对方</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:notifyCounterparty"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c565-arrival">
      <lrml:Comment>合同自解除通知到达对方时解除
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c565-arrival", "articles": ["565"], "provenance": {"kind": "draft", "row_id": "card:g4624", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记说未约定异议期的须在解除通知到达之日起三个月内起诉。这一规则出自原《合同法解释（二）》第24条，该解释已随民法典施行废止，所以没有形式化，只在 distinguish 中说明，请确认\n  · 起草者提示：通知解除、自动解除、诉讼解除三条规则的规则体都加了 terminationRight(P,K)（即须“依法”享有解除权），比 card:g4589 中第565条的写法更严，两行不一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c565-arrival">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimsTermination"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>Q</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noticeArrives"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>Q</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:terminationEffective"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c565-autoterm">
      <lrml:Comment>通知载明债务人在一定期限内不履行债务则合同自动解除，债务人在该期限内未履行的，合同自通知载明的期限届满时解除
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c565-autoterm", "articles": ["565"], "provenance": {"kind": "draft", "row_id": "card:g4624", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记说未约定异议期的须在解除通知到达之日起三个月内起诉。这一规则出自原《合同法解释（二）》第24条，该解释已随民法典施行废止，所以没有形式化，只在 distinguish 中说明，请确认\n  · 起草者提示：通知解除、自动解除、诉讼解除三条规则的规则体都加了 terminationRight(P,K)（即须“依法”享有解除权），比 card:g4589 中第565条的写法更严，两行不一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c565-autoterm">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:terminationRight"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noticeStatesAutoTermination"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:debtorNotPerformedWithinStatedPeriod"/>
              <ruleml:Var>D</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:terminationEffective"/>
            <ruleml:Var>K</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c565-dispute">
      <lrml:Comment>对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c565-dispute", "articles": ["565"], "provenance": {"kind": "draft", "row_id": "card:g4624", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记说未约定异议期的须在解除通知到达之日起三个月内起诉。这一规则出自原《合同法解释（二）》第24条，该解释已随民法典施行废止，所以没有形式化，只在 distinguish 中说明，请确认\n  · 起草者提示：通知解除、自动解除、诉讼解除三条规则的规则体都加了 terminationRight(P,K)（即须“依法”享有解除权），比 card:g4589 中第565条的写法更严，两行不一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c565-dispute">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claimsTermination"/>
              <ruleml:Var>A</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:objectsToTermination"/>
              <ruleml:Var>Q</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractParty"/>
              <ruleml:Var>P</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c565-dispute-h0">
              <lrml:Paraphrase>对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>P</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:requestConfirmTerminationEffect"/>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c565-bysuit">
      <lrml:Comment>未通知对方，直接起诉或申请仲裁主张解除，经确认的，合同自起诉状副本或仲裁申请书副本送达对方时解除
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c565-bysuit", "articles": ["565"], "provenance": {"kind": "draft", "row_id": "card:g4624", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：笔记说未约定异议期的须在解除通知到达之日起三个月内起诉。这一规则出自原《合同法解释（二）》第24条，该解释已随民法典施行废止，所以没有形式化，只在 distinguish 中说明，请确认\n  · 起草者提示：通知解除、自动解除、诉讼解除三条规则的规则体都加了 terminationRight(P,K)（即须“依法”享有解除权），比 card:g4589 中第565条的写法更严，两行不一致\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c565-bysuit">
