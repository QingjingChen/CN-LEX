              <ruleml:Rel iri="cnv:qualifiesUnderArt979"/>
              <ruleml:Var>M</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:entitledToClaimAgainstBeneficiary"/>
