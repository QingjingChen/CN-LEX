          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Right key="c995-1-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>V</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>A</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:claimCivilLiability"/>
                <ruleml:Var>V</ruleml:Var>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c995-limit">
      <lrml:Comment>受害人的停止侵害、排除妨碍、消除危险、消除影响、恢复名誉、赔礼道歉请求权，不适用诉讼时效的规定
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c995-limit", "articles": ["995"], "provenance": {"kind": "draft", "row_id": "card:g6063", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：c999-excl（合理使用排除过错侵权责任）标为学理：条文只写“可以合理使用”，未明说不承担责任，是否升为法条明文请判断\n  · 起草者提示：c995-1 为指引性规范，构成要件仍依第1165–1167条；“损害赔偿请求权仍适用诉讼时效”的反面推论只写在区分栏；第996条见侵权编 c996\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c995-limit">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:claim"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:personalityProtectiveClaim"/>
              <ruleml:Var>C</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:exemptFromLimitation"/>
