            <lrml:Right key="c511-termcreditorg4164-h0">
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:demandPerformanceAtAnyTime"/>
                <ruleml:Var>C</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Right>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="c511-termprepg4164">
      <lrml:Comment>但是应当给对方必要的准备时间
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c511-termprepg4164", "articles": ["511"], "provenance": {"kind": "draft", "row_id": "card:g4164", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n  · 起草者提示：第603条交付地点的规则声明优先于第511条第3项，依据是笔记里“分则补充先于通则补充”的顺序\n  · 起草者提示：第513条政府定价调整按上涨/下降、逾期交付/逾期提货或付款分成 5 条规则\n  · 起草者提示：第501条沿用了其他草稿已有的 knowsConfidentialInfo/disclosesOrImproperlyUses/discloseOrUseConfidentialInfo（只有行为人和对方两个参数，没有“信息”参数）\n  · 起草者提示：第510–512条的规则与 card:g4158 相同（从该行复制，只换了 key）\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
