                <ruleml:Var>A</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:performedBeforeDeathForHeirs"/>
                <ruleml:Var>A</ruleml:Var>
                <ruleml:Var>P</ruleml:Var>
                <ruleml:Var>X</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:valid"/>
            <ruleml:Var>X</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="c174-g2">
      <lrml:Comment>作为被代理人的法人、非法人组织终止的，参照适用前款，委托代理人实施的代理行为有效
