      <ruleml:Rule closure="universal" key=":c511-termdebtorg4164">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:stillIndeterminableAfterArt510"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Ind>term</ruleml:Ind>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:contractObligorTo"/>
              <ruleml:Var>O</ruleml:Var>
              <ruleml:Var>C</ruleml:Var>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Permission key="c511-termdebtorg4164-h0">
              <lrml:Paraphrase>履行期限不明确的，债务人可以随时履行</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>O</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>C</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:performAtAnyTime"/>
                <ruleml:Var>O</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Permission>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
