      <ruleml:Rule closure="universal" key=":c643-shortfall">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:sale"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:resoldAfterRepossession"/>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:resaleProceedsInsufficient"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:SuborderList>
            <lrml:Obligation key="c643-shortfall-h0">
              <lrml:Paraphrase>出卖所得价款不足以抵偿未支付价款及必要费用的，不足部分由买受人清偿</lrml:Paraphrase>
              <ruleml:slot>
                <lrml:Bearer/>
                <ruleml:Var>B</ruleml:Var>
              </ruleml:slot>
              <ruleml:slot>
                <lrml:AuxiliaryParty/>
                <ruleml:Var>S</ruleml:Var>
              </ruleml:slot>
              <ruleml:Atom>
                <ruleml:Rel iri="cnv:payResaleShortfall"/>
                <ruleml:Var>B</ruleml:Var>
                <ruleml:Var>S</ruleml:Var>
                <ruleml:Var>K</ruleml:Var>
              </ruleml:Atom>
            </lrml:Obligation>
          </lrml:SuborderList>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="c602-refer">
      <lrml:Comment>交付期限没有约定或者约定不明确的，作为履行期限不明确的事项适用第510条（协议补充、按相关条款或交易习惯确定）
CNLR_REVIEW_META:{"kind": "rule", "record": {"rule_id": "c602-refer", "articles": ["602"], "provenance": {"kind": "draft", "row_id": "art:602", "model": "claude-agent", "risk_notes": "⚠ 由 Claude agent 起草（司法解释为联网查证，是否逐字核对见起草者提示），已通过程序检查，待专家逐条核对\n"}, "review_status": "pending_expert_review"}}</lrml:Comment>
      <ruleml:Rule closure="universal" key=":c602-refer">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:sale"/>
              <ruleml:Var>K</ruleml:Var>
              <ruleml:Var>S</ruleml:Var>
              <ruleml:Var>B</ruleml:Var>
              <ruleml:Var>T</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="cnv:noAgreedOrUnclearDeliveryTerm"/>
              <ruleml:Var>K</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel iri="cnv:termNotAgreedOrUnclear"/>
            <ruleml:Var>K</ruleml:Var>
            <ruleml:Ind>term</ruleml:Ind>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="c602-anytime">
